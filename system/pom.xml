        </testResources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>parse-version</id>
                        <goals>
                            <goal>parse-version</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <propertyPrefix>parsedVersion</propertyPrefix>
                            <versionString>${project.parent.version}</versionString>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-source</id>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <sources>
                                <source>agenthandler/src</source>
                                <source>Tools/ImageWidgetService/src</source>
                                <!--  <source>webservices/sample/loader/java/src</source> -->
                                <source>webservices/src</source>
                                <source>beans/src</source>
                                <source>i18n/src</source>
                                <source>release/src</source>
                                <source>business/src</source>
                                <source>services/src</source>
                                <source>servlet/src</source>
