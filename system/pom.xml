                                <source>Testing/src</source>
                                <source>FastForward/SiteFolderPublishing/Exits/src/test/java</source>
                                <!--  <source>webservices/test</source> -->
                                <source>Tools/RxFix/test</source>
                                <source>Tools/ImageWidgetService/test</source>
                                <source>release/test</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-resource</id>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>UnitTestResources</directory>
                                    <excludes>
                                        <exclude>**/*.java</exclude>
                                        <exclude>ant</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
