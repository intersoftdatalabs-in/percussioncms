                                <source>Tools/RxFix/src</source>
                                <source>uploader/src</source>
                                <source>Tools/InlineLinkConverter/src</source>
                                <source>controls/src</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-source</id>
