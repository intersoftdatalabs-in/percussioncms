                <directory>src/test/resources</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>
        <pluginManagement>
            <plugins>
                <!--This plugin's configuration is used to store Eclipse m2e settings
					only. It has no influence on the Maven build itself. -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.codehaus.mojo</groupId>
                                        <artifactId>exec-maven-plugin</artifactId>
                                        <versionRange>[1.6.0,)</versionRange>
                                        <goals>
                                            <goal>exec</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore/>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webResources>
                        <resource>
                            <directory>src/main/webapp</directory>
                            <!-- override the destination directory for this resource -->
                            <targetPath>.</targetPath>
                            <!-- enable filtering -->
                            <filtering>false</filtering>
                        </resource>
                        <!-- META-INF files with property filtering enabled -->
                        <resource>
                            <directory>src/main/webapp/META-INF</directory>
                            <targetPath>META-INF</targetPath>
                            <filtering>true</filtering>
                        </resource>
                        <!-- Generated frontend outputs (React, legacy bundles) overlaid at package time -->
                        <resource>
                            <directory>${project.build.directory}/generated-webui</directory>
                            <targetPath>.</targetPath>
                            <filtering>false</filtering>
                        </resource>
                        <resource>
                            <directory>../projects/sitemanage/src/main/resources/Rhythmyx/AppServer/server/rx/deploy/rxapp.ear/rxapp.war/WEB-INF/config/spring/projects</directory>
                            <filtering>true</filtering>
                            <targetPath>WEB-INF/config/spring/projects</targetPath>
                            <excludes/>
                        </resource>
                        <!-- deployer beans file -->
                        <resource>
                            <directory>../deployer/src/main/webapp/WEB-INF/config</directory>
                            <!-- override the destination directory for this resource -->
                            <targetPath>WEB-INF/config</targetPath>
                            <!-- enable filtering -->
                            <filtering>false</filtering>
                        </resource>
                    </webResources>
                    <packagingExcludes>jsps,
						metadata,
						config,
						jboss-4.0,
						WEB-INF/lib/commons-logging-*.jar,
						WEB-INF/lib/log4j-*.jar,
						WEB-INF/lib/*slf4j*.jar,
						WEB-INF/lib/ehcache-core-*.jar,
						WEB-INF/lib/aspectjrt*.jar,
						WEB-INF/lib/jtidy-4aug2000r7-dev.jar,
						WEB-INF/lib/jstl-*.jar,
						WEB-INF/lib/jaxrpc-api-*.jar,
						WEB-INF/lib/grib-*.jar,
						WEB-INF/lib/httpservices-*.jar,
						WEB-INF/lib/servlet-api-*.jar,
						WEB-INF/lib/jna-*.jar,
						WEB-INF/lib/net-cdf4-*.jar,
						%regex[WEB-INF/lib/commons-beanutils-core.*.jar,
						WEB-INF/lib/httpclient-osgi*.jar</packagingExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-apache-oro</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-jsch</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-launcher</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-commons-net</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-commons-logging</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-apache-regexp</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>ant-contrib</groupId>
                        <artifactId>ant-contrib</artifactId>
                        <version>${ant.contrib.version}</version>
                        <exclusions>
                            <exclusion>
                                <groupId>ant</groupId>
                                <artifactId>ant</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.apache.ivy</groupId>
                                <artifactId>ivy</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.jvnet.hudson</groupId>
                                <artifactId>ivy</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>junit</groupId>
                                <artifactId>junit</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.apache.bcel</groupId>
                                <artifactId>bcel</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>ant-package</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <taskdef classpathref="maven.plugin.classpath" resource="net/sf/antcontrib/antlib.xml"/>
                                <echo>changing to read write
									${project.build.directory}/${project.artifactId}-${project.version}</echo>
                                <trycatch>
                                    <try>
                                        <!-- On nix based systems run chmod - will do nothing on Windows -->
                                        <chmod dir="${project.build.directory}" includes="**/*" perm="ugo+rw"/>
                                        <!-- On Windows based systems run attrib - will do nothing on unix -->
                                        <attrib readonly="false" verbose="true">
                                            <fileset dir="${project.build.directory}" includes="**/*"/>
                                        </attrib>
                                    </try>
                                    <catch>
                                        <echo>Error while setting attributes.</echo>
                                    </catch>
                                </trycatch>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <nodeVersion>v22.22.0</nodeVersion>
                    <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
                    <installDirectory>${user.home}/.m2/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Run as two discrete npm invocations instead of the compound
                             "npm run build" (build:modern && build:legacy) script. The
                             script does not reliably execute its nested
                             commands when invoked by frontend-maven-plugin on Windows;
                             it returns success without producing target/generated-webui,
                             causing a downstream maven-war-plugin failure. -->
                        <id>npm-build-modern</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build:modern</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build-legacy</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build:legacy</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
            </plugin>
            <!-- TwelveMonkeys dependencies loaded via SPI by IIOProviderContextListener in web.xml -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <usedDependencies>
                        <usedDependency>com.twelvemonkeys.servlet:servlet</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-core</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-bmp</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-jpeg</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-tiff</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-metadata</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-psd</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-pnm</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-sgi</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-icns</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-tga</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-pcx</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-iff</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-clippath</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-hdr</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-batik</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-pict</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-pdf</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-thumbsdb</usedDependency>
                        <usedDependency>com.twelvemonkeys.imageio:imageio-webp</usedDependency>
                    </usedDependencies>
                </configuration>
            </plugin>
        </plugins>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
    </build>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <property>
                    <name>env</name>
                    <value>dev</value>
                </property>
            </activation>
            <properties>
                <install.dir>C:\DevEnv\Installs\cm1\dev</install.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>install</phase>
                                <configuration>
                                    <target>
                                        <echo>Make sure that you are passing
											-Dinstall.dir=path/to/your/dev/install...</echo>
                                        <echo>Refreshing dev install with updated JS...</echo>
                                        <echo>Installing to ${install.dir}</echo>
                                        <echo>Unzipping war....</echo>
                                        <unzip dest="${install.dir}/jetty/base/webapps/Rhythmyx" src="${project.basedir}/target/perc-web-ui-${project.parent.version}.war"/>
                                        <echo>Copying common-ui files to web_resources...</echo>
                                        <copy force="true" overwrite="true" todir="${install.dir}/web_resources/cm/common/js">
                                            <fileset dir="${install.dir}/jetty/base/webapps/Rhythmyx/cm/common/js/" includes="**/*.js"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
