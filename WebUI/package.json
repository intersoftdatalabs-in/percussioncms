{
  "name": "perc-web-ui",
  "version": "8.2.0",
  "private": true,
  "description": "Modern React/TypeScript UI layer for Percussion CMS (WebUI module).",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:modern && npm run build:legacy",
    "build:modern": "tsc --noEmit && vite build",
    "build:legacy": "node scripts/build-legacy-bundles.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/main/ts --ext .ts,.tsx"
  },
  "dependencies": {
    "@mkd/language": "file:./vendor/mkd-language",
    "@popperjs/core": "^2.11.8",
    "animate.css": "^4.1.1",
    "backbone": "^1.6.0",
    "bootstrap": "^5.3.8",
    "bowser": "^2.11.0",
    "country-flag-icons": "^1.6.20",
    "datatables.net": "^2.3.7",
    "date-fns": "^4.1.0",
    "handlebars": "^4.7.9",
    "jquery": "^3.7.1",
    "jquery-form": "^4.3.0",
    "jquery-migrate": "^3.6.0",
    "jquery-ui": "^1.14.1",
    "jquery-validation": "^1.21.0",
    "jquery.fancytree": "^2.38.3",
    "js-cookie": "^3.0.7",
    "moment": "^2.30.1",
    "mousetrap": "^1.6.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "^3.7.0",
    "underscore": "^1.13.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
