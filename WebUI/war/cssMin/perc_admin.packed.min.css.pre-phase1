/*
    root element for the scrollable.
    when scrolling occurs this element stays still.
*/
div.perc-scrollable {
  /* required settings */
  position: relative;
  overflow: hidden;
  width: 660px;
  height: 142px;
  margin: 10px 0px 0px 0px;
  border: 1px solid #939ead;
}

/*
    root element for scrollable items. Must be absolutely positioned
    and it should have a extremely large width to accomodate scrollable items.
    it's enough that you set width and height for the root element and
    not for this element.
*/
div.perc-scrollable div.perc-items {
  /* this cannot be too large */
  width: 20000em;
  position: absolute;
  background-color: #ffffff;
}

/*
    a single item. must be floated in horizontal scrolling.
    typically, this element is the one that *you* will style
    the most.
*/
div.perc-scrollable div.perc-items div {
  float: left;
}

/*
    a single item. must be floated in horizontal scrolling.
    typically, this element is the one that *you* will style
    the most.
*/
div.perc-scrollable div.perc-items button {
  float: left;
}

div.perc-scrollable div.perc-items .item {
  margin: 3px;
  padding: 10px;
  color: #758496;
  display: block;
  font-family: Verdana;
  font-size: 11px;
  font-weight: normal;
  width: 150px;
}

div.perc-scrollable div.perc-items button.perc-selected-item {
  background-color: #caf589;
}

div.perc-scrollable div.perc-items button {
  background-color: #ffffff;
  border-color: grey;
  width: 128px;
}

/* Buttons */

/* this makes it possible to add next button beside scrollable */
.perc-scrollable {
  float: left;
}

div.perc-selected-item {
  background-color: #caf589;
}

/* prev, next, prevPage and nextPage buttons */
a.browse {
  display: block;
  width: 21px;
  height: 44px;
  float: left;
  margin: 62px 10px;
  cursor: pointer;
  font-size: 11px;
}

/* right */
a.right {
  background: url(../images/images/carousel-scroll-right.png) no-repeat;
  clear: right;
  margin-right: 0px;
  margin-left: 0px;
}
a.right:hover {
  background: url(../images/images/carousel-scroll-right-over.png) no-repeat;
}

/* left */
a.left {
  background: url(../images/images/carousel-scroll-left.png) no-repeat;
  clear: right;
  margin-right: 0px;
}
a.left:hover {
  background: url(../images/images/carousel-scroll-left-over.png);
}

/* disabled navigational button */
a.disabled {
  /* visibility:hidden !important;	*/
}

/* Asset Dialog Styles */
.perc-items td {
  padding-top: 7px;
  padding-left: 2px;
  padding-right: 2px;
}
.perc-items .items {
  min-width: 107px;
  margin: auto;
}

#perc-template-label {
  clear: both;
  margin: 0px 0px 0px 31px;
  width: 660px;
  overflow: hidden;
  color: #6c717c;
}

.perc-label-right {
  width: 300px;
  float: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  dispaly: inline-block;
  text-align: right;
  overflow: hidden;
}

.perc-label-left {
  width: 300px;
  float: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.perc-tooltip .perc-tooltip-content {
  font-size: 11px;
  background: white;
  padding: 5px 10px 5px 10px;
  border: lightgrey 1px solid;
  white-space: nowrap;
  color: black;
  cursor: text;
}

.perc-tooltip.perc-tooltip-arrow-up .perc-tooltip-arrow-top {
  height: 10px;
  display: none;
  text-align: center;
  position: absolute;
  top: -4px;
}

.perc-tooltip.perc-tooltip-arrow-down .perc-tooltip-arrow-bottom {
  height: 10px;
  display: block;
  text-align: center;
  position: absolute;
  bottom: -9px;
}

.pw-container {
  /* margin-left: auto; */
  /* margin-right: auto; */
  /* max-width: 500px; */
  /* background: #F8F8F8;*/
  /* padding: 30px 30px 20px 30px; */
  font: 14px Verdana, sans-serif;
  color: #666;
  /* border-radius: 5px; */
  /* -webkit-border-radius: 5px; */
  /* -moz-border-radius: 5px; */
  /* padding: 0 !important; */
}

.pw-container .pw-status {
  float: none;
  margin: 0;
  width: 100%;
  padding: 7px;
  border: 1px solid transparent;
  border-radius: 4px;
}

.pw-container .pw-status.success {
  color: #3c763d;
  background-color: #dff0d8;
  border-color: #d6e9c6;
}

.pw-container .pw-status.danger {
  color: #a94442;
  background-color: #f2dede;
  border-color: #ebccd1;
}

.pw-form {
  max-width: 330px;
  /* padding: 15px; */
  margin: 0 auto;
}

.pw-form h1 {
  font: 24px Verdana, sans-serif;
  padding: 20px 0px 20px 40px;
  display: block;
  margin: -30px -30px 10px -30px;
  color: #fff;
  /*    background: #9DC45F;*/
  text-shadow: 1px 1px 1px #949494;
  border-radius: 5px 5px 0px 0px;
  -webkit-border-radius: 5px 5px 0px 0px;
  -moz-border-radius: 5px 5px 0px 0px;
  border-bottom: 1px solid #89af4c;
}

.pw-form h1 > span {
  display: block;
  font-size: 11px;
  color: #fff;
}

.pw-form label {
  display: block;
  margin: 0px 0px 5px;
}

.pw-form label > span {
  float: left;
  margin-top: 10px;
  color: #5e5e5e;
}

.pw-form input[type="text"],
.pw-form input[type="password"],
.pw-form textarea,
.pw-form select {
  color: #555;
  height: 30px;
  line-height: 15px;
  width: 100%;
  padding: 0px 0px 0px 10px;
  margin-top: 2px;
  margin-bottom: 0.5em;
  border: 1px solid #e5e5e5;
  background: #fbfbfb;
  outline: 0;
  -webkit-box-shadow: inset 1px 1px 2px rgba(238, 238, 238, 0.2);
  box-shadow: inset 1px 1px 2px rgba(238, 238, 238, 0.2);
  font: normal 14px/14px Arial, Helvetica, sans-serif;
}

.pw-form textarea {
  height: 100px;
  padding-top: 10px;
}

.pw-form select {
  background: url("down-arrow.png") no-repeat right,
    -moz-linear-gradient(top, #fbfbfb 0%, #e9e9e9 100%);
  background: url("down-arrow.png") no-repeat right,
    -webkit-gradient(linear, left top, left bottom, color-stop(0%, #fbfbfb), color-stop(100%, #e9e9e9));
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  text-indent: 0.01px;
  text-overflow: "";
  width: 100%;
  height: 30px;
}

.pw-form .pw-submit {
  background-color: #133c55;
  border-radius: 5px;
  -webkit-border-radius: 5px;
  -moz-border-border-radius: 5px;
  border: none;
  margin-top: 1em;
  padding: 10px 25px 10px 25px;
  color: #fff;
  text-shadow: 1px 1px 1px #949494;
}

.pw-form .pw-submit:hover {
  background-color: #298ac0;
}

.pw-form .pw-submit:disabled {
  background-color: #bcbcbc;
  cursor: not-allowed;
}

.pw-form .pw-submit:disabled:hover {
  background-color: #bcbcbc;
}

.pw-form em.error {
  color: red;
  font-style: italic;
  display: block;
  padding: 0 42px 0 0;
}

.pw-form input.error {
  border: 1px dotted red;
}

.pw-form .pw-message {
  float: none;
  margin-top: 0;
  margin-right: 0;
  margin-left: 0.5em;
  padding: 7px;
  border: 1px solid transparent;
  border-radius: 4px;
}
