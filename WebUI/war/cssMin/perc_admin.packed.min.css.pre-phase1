#perc-dropdown-view-layout.perc-disable-menu-item .sf-sub-indicator,
#perc-dropdown-actions-layout.perc-disable-menu-item .sf-sub-indicator,
#perc-dropdown-help-layout.perc-disable-menu-item .sf-sub-indicator {
