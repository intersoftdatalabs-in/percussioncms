}

.perc-fixedtableheader .perc-datatable-head-row,
#perc-finder-listview .perc-datatable-head-row {
  border-bottom: 0px solid black !important;
  border-top: 0px solid black !important;
  border-left: 0px solid black !important;
}

#perc-finder-listview .perc-datatable-row {
  border: 0px solid black !important;
}

#perc-finder-listview .perc-datatable-row-highlighted {
  background-color: whitesmoke !important;
}

#perc-finder-listview .dataTables_wrapper table tr td.perc-first {
  padding-left: 4px;
}

#perc-finder-listview span.perc-sort {
