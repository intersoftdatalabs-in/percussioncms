table.dataTable.order-column.hover tbody tr:hover > .sorting_3 {
  box-shadow: inset 0 0 0 9999px rgba(0, 0, 0, 0.062);
}
table.dataTable.display tbody tr:hover.selected > .sorting_1,
table.dataTable.order-column.hover tbody tr:hover.selected > .sorting_1 {
  box-shadow: inset 0 0 0 9999px rgba(13, 110, 253, 0.982);
}
table.dataTable.display tbody tr:hover.selected > .sorting_2,
table.dataTable.order-column.hover tbody tr:hover.selected > .sorting_2 {
  box-shadow: inset 0 0 0 9999px rgba(13, 110, 253, 0.974);
}
table.dataTable.display tbody tr:hover.selected > .sorting_3,
table.dataTable.order-column.hover tbody tr:hover.selected > .sorting_3 {
  box-shadow: inset 0 0 0 9999px rgba(13, 110, 253, 0.962);
}
table.dataTable.no-footer {
  border-bottom: 1px solid rgba(0, 0, 0, 0.3);
}
table.dataTable.compact thead th,
table.dataTable.compact thead td {
  padding: 4px 17px;
}
table.dataTable.compact tfoot th,
table.dataTable.compact tfoot td {
  padding: 4px;
}
table.dataTable.compact tbody th,
table.dataTable.compact tbody td {
  padding: 4px;
}

table.dataTable th,
table.dataTable td {
  box-sizing: content-box;
}

/*
 * Control feature layout
 */
.dataTables_wrapper {
  position: relative;
  clear: both;
}
.dataTables_wrapper .dataTables_length {
  float: left;
}
.dataTables_wrapper .dataTables_length select {
  border: 1px solid #aaa;
  border-radius: 3px;
  padding: 5px;
  background-color: transparent;
  padding: 4px;
}
.dataTables_wrapper .dataTables_filter {
  float: right;
  text-align: right;
}
.dataTables_wrapper .dataTables_filter input {
  border: 1px solid #aaa;
  border-radius: 3px;
  padding: 5px;
  background-color: transparent;
  margin-left: 3px;
}
.dataTables_wrapper .dataTables_info {
  clear: both;
  float: left;
  padding-top: 0.755em;
}
.dataTables_wrapper .dataTables_paginate {
  float: right;
  text-align: right;
  padding-top: 0.25em;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
  box-sizing: border-box;
  display: inline-block;
  min-width: 1.5em;
  padding: 0.5em 1em;
  margin-left: 2px;
  text-align: center;
  text-decoration: none !important;
  cursor: pointer;
  color: #333 !important;
  border: 1px solid transparent;
  border-radius: 2px;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current,
.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
  color: #333 !important;
  border: 1px solid rgba(0, 0, 0, 0.3);
  background-color: rgba(230, 230, 230, 0.1);
  background: -webkit-gradient(
    linear,
    left top,
    left bottom,
    color-stop(0%, rgba(230, 230, 230, 0.1)),
    color-stop(100%, rgba(0, 0, 0, 0.1))
  );
  /* Chrome,Safari4+ */
  background: -webkit-linear-gradient(
    top,
    rgba(230, 230, 230, 0.1) 0%,
    rgba(0, 0, 0, 0.1) 100%
  );
  /* Chrome10+,Safari5.1+ */
  background: -moz-linear-gradient(
    top,
    rgba(230, 230, 230, 0.1) 0%,
    rgba(0, 0, 0, 0.1) 100%
  );
  /* FF3.6+ */
  background: -ms-linear-gradient(
    top,
    rgba(230, 230, 230, 0.1) 0%,
    rgba(0, 0, 0, 0.1) 100%
  );
  /* IE10+ */
  background: -o-linear-gradient(
    top,
    rgba(230, 230, 230, 0.1) 0%,
    rgba(0, 0, 0, 0.1) 100%
  );
  /* Opera 11.10+ */
  background: linear-gradient(
    to bottom,
    rgba(230, 230, 230, 0.1) 0%,
    rgba(0, 0, 0, 0.1) 100%
  );
  /* W3C */
}
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover,
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled:active {
  cursor: default;
  color: #666 !important;
  border: 1px solid transparent;
  background: transparent;
  box-shadow: none;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
  color: white !important;
  border: 1px solid #111;
  background-color: #585858;
  background: -webkit-gradient(
    linear,
    left top,
    left bottom,
    color-stop(0%, #585858),
    color-stop(100%, #111)
  );
  /* Chrome,Safari4+ */
  background: -webkit-linear-gradient(top, #585858 0%, #111 100%);
  /* Chrome10+,Safari5.1+ */
  background: -moz-linear-gradient(top, #585858 0%, #111 100%);
  /* FF3.6+ */
  background: -ms-linear-gradient(top, #585858 0%, #111 100%);
  /* IE10+ */
  background: -o-linear-gradient(top, #585858 0%, #111 100%);
  /* Opera 11.10+ */
  background: linear-gradient(to bottom, #585858 0%, #111 100%);
  /* W3C */
}
.dataTables_wrapper .dataTables_paginate .paginate_button:active {
  outline: none;
  background-color: #2b2b2b;
  background: -webkit-gradient(
    linear,
    left top,
    left bottom,
    color-stop(0%, #2b2b2b),
    color-stop(100%, #0c0c0c)
  );
  /* Chrome,Safari4+ */
  background: -webkit-linear-gradient(top, #2b2b2b 0%, #0c0c0c 100%);
  /* Chrome10+,Safari5.1+ */
  background: -moz-linear-gradient(top, #2b2b2b 0%, #0c0c0c 100%);
  /* FF3.6+ */
  background: -ms-linear-gradient(top, #2b2b2b 0%, #0c0c0c 100%);
  /* IE10+ */
  background: -o-linear-gradient(top, #2b2b2b 0%, #0c0c0c 100%);
  /* Opera 11.10+ */
  background: linear-gradient(to bottom, #2b2b2b 0%, #0c0c0c 100%);
  /* W3C */
  box-shadow: inset 0 0 3px #111;
}
.dataTables_wrapper .dataTables_paginate .ellipsis {
  padding: 0 1em;
}
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_processing,
.dataTables_wrapper .dataTables_paginate {
  color: #333;
}
.dataTables_wrapper .dataTables_scroll {
  clear: both;
}
.dataTables_wrapper .dataTables_scroll div.dataTables_scrollBody {
  -webkit-overflow-scrolling: touch;
}
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > thead
  > tr
  > th,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > thead
  > tr
  > td,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > tbody
  > tr
  > th,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > tbody
  > tr
  > td {
  vertical-align: middle;
}
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > thead
  > tr
  > th
  > div.dataTables_sizing,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > thead
  > tr
  > td
  > div.dataTables_sizing,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > tbody
  > tr
  > th
  > div.dataTables_sizing,
.dataTables_wrapper
  .dataTables_scroll
  div.dataTables_scrollBody
  > table
  > tbody
  > tr
  > td
  > div.dataTables_sizing {
  height: 0;
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
}
.dataTables_wrapper.no-footer .dataTables_scrollBody {
  border-bottom: 1px solid rgba(0, 0, 0, 0.3);
}
.dataTables_wrapper.no-footer div.dataTables_scrollHead table.dataTable,
.dataTables_wrapper.no-footer div.dataTables_scrollBody > table {
  border-bottom: none;
}
.dataTables_wrapper:after {
  visibility: hidden;
  display: block;
  content: "";
  clear: both;
  height: 0;
}

@media screen and (max-width: 767px) {
  .dataTables_wrapper .dataTables_info,
  .dataTables_wrapper .dataTables_paginate {
    float: none;
    text-align: center;
  }
  .dataTables_wrapper .dataTables_paginate {
    margin-top: 0.5em;
  }
}
@media screen and (max-width: 640px) {
  .dataTables_wrapper .dataTables_length,
  .dataTables_wrapper .dataTables_filter {
    float: none;
    text-align: center;
  }
  .dataTables_wrapper .dataTables_filter {
    margin-top: 0.5em;
  }
}

/*** ESSENTIAL STYLES ***/
.sf-menu,
.sf-menu * {
  margin: 0;
  padding: 0;
  list-style: none;
}
.sf-menu li {
  position: relative;
}
.sf-menu ul {
  position: absolute;
  display: none;
  top: 100%;
  left: 0;
  z-index: 99;
}
.sf-menu > li {
  float: left;
}
.sf-menu li:hover > ul,
.sf-menu li.sfHover > ul {
  display: block;
}

.sf-menu a {
  display: block;
  position: relative;
}
.sf-menu ul ul {
  top: 0;
  left: 100%;
}

/*** DEMO SKIN ***/
.sf-menu {
  float: left;
  margin-bottom: 1em;
}
.sf-menu ul {
  box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.2);
  min-width: 12em; /* allow long menu items to determine submenu width */
  *width: 12em; /* no auto sub width for IE7, see white-space comment below */
}
.sf-menu a {
  border-left: 1px solid #fff;
  border-top: 1px solid #dfeeff; /* fallback colour must use full shorthand */
  border-top: 1px solid rgba(255, 255, 255, 0.5);
  padding: 0.75em 1em;
  text-decoration: none;
  zoom: 1; /* IE7 */
}
.sf-menu a {
  color: #13a;
}
.sf-menu li {
  background: #bdd2ff;
  white-space: nowrap; /* no need for Supersubs plugin */
  *white-space: normal; /* ...unless you support IE7 (let it wrap) */
  -webkit-transition: background 0.2s;
  transition: background 0.2s;
}
.sf-menu ul li {
  background: #aabde6;
}
.sf-menu ul ul li {
  background: #9aaedb;
}
.sf-menu li:hover,
.sf-menu li.sfHover {
  background: #cfdeff;
  /* only transition out, not in */
  -webkit-transition: none;
  transition: none;
}

/*** arrows (for all except IE7) **/
.sf-arrows .sf-with-ul {
  padding-right: 2.5em;
  *padding-right: 1em; /* no CSS arrows for IE7 (lack pseudo-elements) */
}
/* styling for both css and generated arrows */
.sf-arrows .sf-with-ul:after {
  content: "";
  position: absolute;
  top: 50%;
  right: 1em;
  margin-top: -3px;
  height: 0;
  width: 0;
  /* order of following 3 rules important for fallbacks to work */
  border: 5px solid transparent;
  border-top-color: #133c55; /* edit this to suit design (no rgba in IE8) */
  border-top-color: rgba(19, 60, 85, 0.5);
}
.sf-arrows > li > .sf-with-ul:focus:after,
.sf-arrows > li:hover > .sf-with-ul:after,
.sf-arrows > .sfHover > .sf-with-ul:after {
  border-top-color: rgba(19, 60, 85, 0.5); /* IE8 fallback colour */
}
/* styling for right-facing arrows */
.sf-arrows ul .sf-with-ul:after {
  margin-top: -5px;
  margin-right: -3px;
  border-color: transparent;
  border-left-color: #133c55; /* edit this to suit design (no rgba in IE8) */
  border-left-color: rgba(19, 60, 85, 0.5);
}
.sf-arrows ul li > .sf-with-ul:focus:after,
.sf-arrows ul li:hover > .sf-with-ul:after,
.sf-arrows ul .sfHover > .sf-with-ul:after {
  border-left-color: #133c55;
}

/*** adding the class sf-navbar in addition to sf-menu creates an all-horizontal nav-bar menu ***/
.sf-navbar {
  background: #bdd2ff;
  position: relative;
  margin-bottom: 5em;
}
/* provide background colour for submenu strip */
/* you should just set the menu's container bg colour rather than use pseudo-elements */
.sf-navbar:before {
  content: "";
  position: absolute;
  left: 0;
  z-index: -1;
  background-color: #bdd2ff;
  height: 200%;
  width: 100%;
}
.sf-navbar ul {
  box-shadow: none;
}
.sf-navbar li {
  background: #aabde6;
  position: static;
}
.sf-navbar > li > a,
.sf-navbar > li > ul > li > a {
  border: none;
}
.sf-navbar > li > ul {
  min-width: 36em; /* set this to whatever suits your design */
}
.sf-navbar ul li {
  background: #bdd2ff;
  position: relative;
}
.sf-navbar ul ul {
  left: 0;
  top: 100%;
}
.sf-navbar ul ul li {
  width: 100%;
}
.sf-navbar > li > ul > li {
  float: left;
}
.sf-navbar li.current {
  background: #bdd2ff;
}
.sf-navbar li:hover,
.sf-navbar li.sfHover,
.sf-navbar ul li.current {
  background: #bdd2ff;
}
.sf-navbar ul li:hover,
.sf-navbar ul li.sfHover,
.sf-navbar ul ul li {
  background: #d1dfff;
}
.sf-navbar ul ul li:hover,
.sf-navbar ul ul li.sfHover,
.sf-navbar ul ul li.current {
  background: #e6eeff;
}
.sf-navbar ul li.current > a {
  font-weight: bold;
}

/*** point all arrows down ***/
.sf-arrows.sf-navbar ul .sf-with-ul:after {
  margin-top: -3px;
  margin-right: 0;
  border-color: transparent;
  border-top-color: #dfeeff; /* edit this to suit design (no rgba in IE8) */
  border-top-color: rgba(255, 255, 255, 0.5);
}

.sf-arrows.sf-navbar ul > li > .sf-with-ul:focus:after,
.sf-arrows.sf-navbar ul > li:hover > .sf-with-ul:after,
.sf-arrows.sf-navbar ul > .sfHover > .sf-with-ul:after {
  border-color: transparent;
  border-top-color: white;
}

/* adding sf-vertical class in addition to sf-menu creates a vertical menu */
/* eg. <ul class="sf-menu sf-vertical"> ... */
.sf-vertical {
  width: 12em;
  /* If you want the width of the closed menu to expand to its
  widest top-level menu item (like its "Supersubs" submenus do),
  replace the width rule above with the following two rules. */

  /*
  min-width: 12em;
  *width: 12em;
  */
}
.sf-vertical ul {
  left: 100%;
  top: 0;
}
.sf-vertical > li {
  float: none;
}
.sf-vertical li {
  width: 100%;
}

/*** alter arrow directions ***/
.sf-vertical.sf-arrows > li > .sf-with-ul:after {
  margin-top: -5px;
  margin-right: -3px;
  border-color: transparent;
  border-left-color: #dfeeff; /* edit this to suit design (no rgba in IE8) */
  border-left-color: rgba(255, 255, 255, 0.5);
}
.sf-vertical.sf-arrows li > .sf-with-ul:focus:after,
.sf-vertical.sf-arrows li:hover > .sf-with-ul:after,
.sf-vertical.sf-arrows .sfHover > .sf-with-ul:after {
  border-left-color: white;
}

/*** ESSENTIAL STYLES ***/
.sf-menu {
  position: relative;
  margin: 0;
  padding: 0;
  list-style: none;
}
.sf-menu .sf-mega {
  position: absolute;
  display: none;
  top: 100%;
  left: 0;
  z-index: 99;
}
.sf-menu > li {
  float: left;
}
.sf-menu li:hover > .sf-mega,
.sf-menu li.sfHover > .sf-mega {
  display: block;
}

.sf-menu > li > a {
  display: block;
  position: relative;
}

/*** DEMO SKIN ***/
.sf-menu {
  float: left;
  margin-bottom: 1em;
}
.sf-menu .sf-mega {
  box-shadow: 2px 3px 6px rgba(0, 0, 0, 0.2);
  width: 100%; /* allow long menu items to determine submenu width */
}
.sf-menu > li > a {
  border-left: 1px solid #fff;
  border-top: 1px solid #dfeeff; /* fallback colour must use full shorthand */
  border-top: 1px solid rgba(255, 255, 255, 0.5);
  padding: 0.75em 1em;
  text-decoration: none;
  zoom: 1; /* IE7 */
  color: #13a;
}
.sf-menu > li {
  background: #bdd2ff;
  -webkit-transition: background 0.2s;
  transition: background 0.2s;
}
.sf-menu > li:hover,
.sf-menu > li.sfHover {
  background: #cfdeff;
  /* only transition out, not in */
  -webkit-transition: none;
  transition: none;
}

/*** mega menu dropdown ***/
.sf-mega {
  background-color: #cfdeff;
  padding: 1em;
  box-sizing: border-box;
  width: 100%;
}
.sf-mega-section {
  float: left;
  width: 8em; /* optional */
  padding: 0 1em 1em 0;
  margin-right: 1em;
  border-right: 1px solid #b4c8f5;
}

/*** arrows (for all except IE7) **/
.sf-arrows .sf-with-ul {
  padding-right: 2.5em;
  *padding-right: 1em; /* no CSS arrows for IE7 (lack pseudo-elements) */
}
/* styling for both css and generated arrows */
.sf-arrows .sf-with-ul:after {
  content: "";
  position: absolute;
  top: 50%;
  right: 1em;
  margin-top: -3px;
  height: 0;
  width: 0;
  /* order of following 3 rules important for fallbacks to work */
  border: 5px solid transparent;
  border-top-color: #133c55; /* edit this to suit design (no rgba in IE8) */
}
.sf-arrows > li > .sf-with-ul:focus:after,
.sf-arrows > li:hover > .sf-with-ul:after,
.sf-arrows > .sfHover > .sf-with-ul:after {
  border-top-color: #133c55; /* IE8 fallback colour */
}

/* override the font and color of text */
.perc-dropdown * {
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
  color: #0099cc;
  text-decoration: none;
}

.perc-dropdown.sf-menu a,
.perc-dropdown.sf-menu a:visited {
  /* visited pseudo selector so IE6 applies text colour*/
  color: #006f94;
}

.perc-dropdown .sf-sub-indicator {
  background: transparent url("../images/images/dropdownArrow.gif") no-repeat;
  background-position: 0px 0px;
}

/* override dropdown title background */
.perc-dropdown.sf-menu li {
  background: #e6e6e9 none repeat scroll 0 0;
  margin-top: 5px;
  margin-right: 10px;
}

.perc-workflow .perc-dropdown.sf-menu li {
  margin: 0px;
}

/* override dropdown title background hover */
.perc-dropdown.sf-menu li a:hover {
  background: #e6e6e9 none repeat scroll 0 0;
}

/* override dropdown option background */
.perc-dropdown.sf-menu li li {
  background: #ffffff none repeat scroll 0 0;
  margin-top: 0px;
}

/* override dropdown option background hover */
.perc-dropdown.sf-menu li li a:hover {
  background: #caf589 none repeat scroll 0 0;
}

.perc-dropdown.sf-menu a {
  border-left: 1px solid #ffffff;
  border-top: 0px solid #ffffff;
}

.perc-dropdown.sf-menu li li a {
  border-left: 1px solid lightgrey;
  border-top: 0px solid #ffffff;
}

.perc-dropdown.sf-menu li li a:first-child {
  border-top: 1px solid lightgrey;
  margin-right: 0px;
  margin-top: 0px;
}

.perc-dropdown.sf-shadow ul {
  box-shadow: 2px 0px 2px #a2a2a2, -2px 0px 2px #a2a2a2, 0px 2px 2px #a2a2a2,
    0px -2px 2px #a2a2a2;
  margin-top: -3px;
  border-top: 1px solid #a2a2a2;
}

.perc-dropdown.perc-dropdown-template-pages-items-dropdown.sf-shadow ul,
.perc-dropdown.perc-imported-page-dropdown-list.sf-shadow ul {
  margin-top: -23px;
  margin-left: -95px;
}

.perc-dropdown.sf-menu a:focus,
.perc-dropdown.sf-menu a:hover {
  background: #ffffff;
}

#perc-content-menu li li a,
#perc-pageEditor-menu li li a,
#perc-layout-menu li li a,
#perc-style-menu li li a {
  margin-right: 0px;
  margin-top: 0px;
  padding: 9px;
}

#perc-content-menu li li a:first-child,
#perc-pageEditor-menu li li a:first-child,
#perc-style-menu li li a:first-child {
  padding: 9px 9px 12px 9px;
}

.sf-menu li:hover ul,
.sf-menu li.sfHover ul {
  left: 0;
  z-index: 99;
}

.perc-dropdown a > .sf-sub-indicator {
  top: 9px;
}

/* Page Workflow Dropdown */
.perc-dropdown-page-workflow .perc-dropdown-title {
  width: 64px;
  height: 17px;
}

/* Target View Dropdown*/
.perc-dropdown-target-view.sf-menu {
  padding: 0 0 0 8px;
}

#perc-dropdown-view li a,
#perc-template-view a,
#perc-template-actions li a,
#perc-dropdown-actions li a,
#perc-dropdown-actions-layout li a,
#perc-dropdown-view-layout li a,
#perc-dropdown-help-layout li a,
#perc-dropdown-publish-now li a,
#perc-dropdown-actions-style li a,
#perc-dropdown-view-style li a {
  margin-right: 0px;
  margin-top: 0px;
  padding-top: 6px;
  margin-top: 12px;
  padding-left: 6px;
  padding-right: 26px;
}

.perc-template-pages-items-dropdown li,
.perc-imported-page-dropdown-list li {
  margin: 0 !important;
  padding: 0 !important;
}

.perc-template-pages-items-dropdown li li,
.perc-imported-page-dropdown-list li li {
  padding: 6px 0 !important;
}

#perc-dropdown-view .sf-menu > li > a:hover,
#perc-template-view .sf-menu > li > a:hover,
#perc-template-actions .sf-menu > li > a:hover,
#perc-dropdown-actions .sf-menu > li > a:hover,
#perc-dropdown-actions-layout .sf-menu > li > a:hover,
#perc-dropdown-view-layout .sf-menu > li > a:hover,
#perc-dropdown-help-layout .sf-menu > li > a:hover,
#perc-dropdown-publish-now .sf-menu > li > a:hover,
#perc-dropdown-actions-style .sf-menu > li > a:hover,
#perc-dropdown-view-style .sf-menu > li > a:hover,
#perc-dropdown-view .sf-menu > li.sfHover > a,
#perc-template-view .sf-menu > li.sfHover > a,
#perc-template-actions .sf-menu > li.sfHover > a,
#perc-dropdown-actions .sf-menu > li.sfHover > a,
#perc-dropdown-actions-layout .sf-menu > li.sfHover > a,
#perc-dropdown-view-layout .sf-menu > li.sfHover > a,
#perc-dropdown-help-layout .sf-menu > li.sfHover > a,
#perc-dropdown-publish-now .sf-menu > li.sfHover > a,
#perc-dropdown-actions-style .sf-menu > li.sfHover > a,
#perc-dropdown-view-style .sf-menu > li.sfHover > a,
.perc-template-pages-items-dropdown .sf-menu > li.sfHover > a,
.perc-imported-page-dropdown .sf-menu > li.sfHover > a {
  box-shadow: -2px -3px 3px #a2a2a2, 2px -2px 1px #a2a2a2;
  background: white;
  z-index: 10000;
}

a.perc-dropdown-option.ui-state-default {
  background: white;
}
.sf-sub-indicator {
  right: 10px;
}

#perc-template-actions .perc-dropdown-option-list,
#perc-template-view .perc-dropdown-option-list {
  left: 10px;
}

#perc-dropdown-page-workflow .perc-dropdown-option-list {
  left: -12px;
}

.sf-menu ul {
  width: 12em;
}

.perc-dropdown-template-action.sf-menu ul {
  width: 18em;
}

#perc-dropdown-help-layout .sf-menu ul {
  width: 14em;
}

.sf-menu ul .perc-dropdown.sf-menu li li a.perc-drop-disabled {
  background-color: #fff;
  background: #fff;
  color: #9fa3aa;
  cursor: default;
}

#perc-dropdown-view li.current,
#perc-dropdown-view-layout li.current,
#perc-dropdown-help-layout li.current,
#perc-dropdown-views-style li.current,
#perc-template-view li.current,
#perc-dropdown-view-style li.current {
  padding: 0 9px 0 0;
}

#perc-dropdown-help-layout li.current {
  padding-left: 0px;
}

#perc-template-view li.current {
  padding-right: 0px;
}

/* PercViewDropdown.css - TODO: Can this CSS file be removed? */

#perc-dropdown-page-workflow .perc-dropdown-title {
  /*width: 29px;
    height: 29px;
    padding: 0;*/
}
/*#perc-dropdown-page-workflow .perc-dropdown.sf-menu li li
{
    background-color: transparent;
}*/
#perc-dropdown-page-workflow ul ul {
  left: auto !important;
  right: 2px !important;
  top: 70% !important;
  margin-top: 0 !important;
  background-color: #ffffff;
}
#perc-dropdown-page-workflow .perc-dropdown.sf-menu li {
  background-color: inherit;
}
#perc-dropdown-page-workflow .perc-dropdown.sf-menu a {
  border-width: 0;
  padding-right: 13px;
}
#perc-dropdown-page-workflow > a:first-child span {
  display: none;
}
#perc-dropdown-page-workflow .perc-dropdown.sf-menu li li a.perc-drop-disabled {
  background-color: #ffffff;
}
#perc-dropdown-page-workflow .perc-dropdown.sf-menu li li a {
  /*background-color: #0086a8;*/
}
a.perc-dropdown-title.perc-workflow-split-button-arrow:after {
  content: "\25bc";
  position: absolute;
  top: 3px;
  left: 9px;
}
a.perc-dropdown-title.perc-workflow-split-button-arrow {
  padding: 0;
}
.perc-workflow-split-button-right {
  border-top-left-radius: 0px !important;
  border-bottom-left-radius: 0px !important;
  border-left-style: unset;
  float: left;
  height: 25px !important;
  border-width: 2px !important;
  border-style: outset !important;
  border-left: 1px solid #ffffff !important;
  width: 15px !important;
  color: #ffffff !important;
  padding: 0px 16px 0px 0px !important;
}
#perc-dropdown-page-workflow .perc-dropdown.sf-menu li li {
  background: #ffffff none repeat scroll 0 0;
}
#perc-dropdown-page-workflow .sf-menu ul {
}
#perc-dropdown-page-workflow,
#perc-dropdown-page-workflow > a,
#perc-dropdown-page-workflow > div {
  height: 27px;
}
#perc-dropdown-page-workflow .perc-workflow-split-button-left {
  border-top-right-radius: 0px !important;
  border-bottom-right-radius: 0px !important;
  border-top-style: outset !important;
  border-right-style: unset;
  float: left;
  margin: 0;
}
#perc-dropdown-page-workflow > a,
#perc-dropdown-page-workflow li.current > a {
  margin: 0 !important;
}
#perc-dropdown-page-workflow {
  margin-right: 8px;
  margin-top: 13px;
}
#perc-dropdown-page-workflow > a {
  overflow: auto;
  vertical-align: top; /* Safari Fix */
}

.perc-schedule .ui-datepicker .ui-widget-header {
  border: 1px solid #aaaaaa;
  background: #cccccc
    url(../themes/base/images/ui-bg_highlight-soft_75_cccccc_1x100.png) 50% 50%
    repeat-x;
  color: #222222;
  font-weight: bold;
}
.perc-schedule .ui-widget-content {
  border: 1px solid #aaaaaa;
  background: #ffffff
    url(../themes/smoothness/images/ui-bg_flat_75_ffffff_40x100.png) 50% 50%
    repeat-x;
  color: #222222;
}
.perc-schedule .ui-datepicker .ui-corner-all {
  -moz-border-radius: 4px;
  -webkit-border-radius: 4px;
}
.perc-schedule .ui-datepicker {
  width: auto;
  padding: 0.2em 0.2em 0;
}
.perc-schedule .ui-widget {
  font-family: Verdana, Arial, sans-serif;
  font-size: 11px;
}

.perc-schedule .ui-datepicker .ui-slider {
  position: relative;
  text-align: left;
}
.perc-schedule .ui-datepicker .ui-slider .ui-slider-handle {
  position: absolute;
  z-index: 10000;
  width: 1.2em;
  height: 1.2em;
  cursor: default;
}
.perc-schedule .ui-datepicker .ui-slider .ui-slider-range {
  position: absolute;
  z-index: 1;
  font-size: 0.7em;
  display: block;
  border: 0;
}

.perc-schedule .ui-datepicker .ui-slider-vertical {
  width: 0.8em;
  height: 100px;
}
.perc-schedule .ui-datepicker .ui-slider-vertical .ui-slider-handle {
  left: -0.3em;
  margin-left: 0;
  margin-bottom: -0.6em;
}
.perc-schedule .ui-datepicker .ui-slider-vertical .ui-slider-range {
  left: 0;
  width: 100%;
}
.perc-schedule .ui-datepicker .ui-slider-vertical .ui-slider-range-min {
  bottom: 0;
}
.perc-schedule .ui-datepicker .ui-slider-vertical .ui-slider-range-max {
  top: 0;
}
.perc-schedule img {
  cursor: pointer;
  padding-left: 3px;
  position: absolute;
  top: 3px;
}

.perc-schedule .ui-datepicker table {
  width: 100%;
  font-size: 0.9em;
  border-collapse: collapse;
  margin: 0 0 0.4em;
}
.perc-schedule .ui-datepicker th {
  padding: 0.7em 0.3em;
  text-align: center;
  font-weight: bold;
  border: 0;
}
.perc-schedule .ui-datepicker td {
  border: 0;
  padding: 1px;
}
.perc-schedule .ui-datepicker td span,
.ui-datepicker td a {
  display: block;
  padding: 0.2em;
  text-align: right;
  text-decoration: none;
}
.perc-schedule .ui-datepicker .ui-datepicker-buttonpane {
  background-image: none;
  margin: 0.7em 0 0 0;
  padding: 0 0.2em;
  border-left: 0;
  border-right: 0;
  border-bottom: 0;
}
.perc-schedule .ui-datepicker .ui-datepicker-buttonpane button {
  float: right;
  margin: 0.5em 0.2em 0.4em;
  cursor: pointer;
  padding: 0.2em 0.6em 0.3em 0.6em;
  width: auto;
  overflow: visible;
}
.perc-schedule
  .ui-datepicker
  .ui-datepicker-buttonpane
  button.ui-datepicker-current {
  float: left;
}
.perc-datetime-picker {
  background-color: #cccccc;
  border: 1px inset #999999;
  color: #333333;
  font-family: Verdana;
  font-size: 11px;
  font-weight: normal;
}
#perc_removal_date,
#perc_publish_date {
  width: 120px;
  padding: 4px 0px 4px 4px;
}
.perc-schedule .ui-widget-content .ui-priority-secondary {
  font-weight: bold;
  opacity: 1;
}
.perc-schedule .ui-widget-content .ui-state-active {
  background: url("../themes/smoothness/images/ui-bg_glass_65_ffffff_1x400.png")
    repeat-x scroll 50% 50% #ffffff;
  border: 1px solid #aaaaaa;
  color: #212121;
  font-weight: normal;
  outline: medium none;
}
.perc-schedule input,
.perc-schedule select,
.perc-schedule textarea,
.perc-schedule .ui-widget button {
  font-family: "Open Sans", sans-serif !important;
}
#ui-datepicker-div.ui-datepicker select.ui-datepicker-month {
  width: 47%;
}
#ui-datepicker-div.ui-datepicker select.ui-datepicker-year {
  width: 52%;
}

.ui-multiselect {
  padding: 2px 0 2px 4px;
  text-align: left;
}
.ui-multiselect span.ui-icon {
  float: right;
}
.ui-multiselect-single .ui-multiselect-checkboxes input {
  position: absolute !important;
  top: auto !important;
  left: -9999px;
}
.ui-multiselect-single .ui-multiselect-checkboxes label {
  padding: 5px !important;
}

.ui-multiselect-header {
  margin-bottom: 3px;
  padding: 3px 0 3px 7px;
}
.ui-multiselect-header ul {
  font-size: 0.9em;
}
.ui-multiselect-header ul li {
  float: right;
  padding: 0 10px 0 0;
}
.ui-multiselect-header ul li:first-child {
  float: left;
}
.ui-multiselect-header a {
  text-decoration: none;
}
.ui-multiselect-header a:hover {
  text-decoration: underline;
}
.ui-multiselect-header span.ui-icon {
  float: left;
}
.ui-multiselect-header li.ui-multiselect-close {
  float: right;
  text-align: right;
  padding-right: 0;
}

.ui-multiselect-menu {
  display: none;
  padding: 0px;
  position: absolute;
  z-index: 10000;
  -moz-box-shadow: 6px 6px 3px 0 #bbbbbb;
  box-shadow: 6px 6px 3px 0 #bbbbbb;
  -webkit-box-shadow: 6px 6px 3px 0 #bbbbbb;
}
.ui-multiselect-checkboxes {
  position: relative /* fixes bug in IE6/7 */;
  overflow-y: auto;
}
.ui-multiselect-checkboxes label {
  cursor: default;
  display: block;
  border: 0px solid transparent;
  padding: 3px 1px 1px;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  width: 190px;
}
.ui-multiselect-checkboxes label input {
  position: relative;
  top: 1px;
  width: 30px;
}
.ui-multiselect-checkboxes li {
  clear: both;
  font-size: 0.9em;
  padding-right: 3px;
}
.ui-multiselect-checkboxes li.ui-multiselect-optgroup-label {
  text-align: center;
  font-weight: bold;
  border-bottom: 1px solid;
}
.ui-multiselect-checkboxes li.ui-multiselect-optgroup-label a {
  display: block;
  padding: 3px;
  margin: 1px 0;
  text-decoration: none;
}

/* remove label borders in IE6 because IE6 does not support transparency */
* html .ui-multiselect-checkboxes label {
  border: none;
}

.ui-multiselect-menu .ui-state-hover {
  background: none;
  border: 1px solid transparent;
  outline: none;
}

button.ui-multiselect.ui-corner-all,
.ui-multiselect-menu.ui-widget.ui-widget-content.ui-corner-all {
  border-radius: 0px;
  padding-left: 5px;
}
.ui-multiselect-menu,
a.ui-multiselect-all,
a.ui-multiselect-none,
.ui-multiselect-checkboxes span {
  font-weight: normal;
  font-size: 11px;
  font-family: verdana;
  text-decoration: none;
}

button.ui-multiselect {
  background: none !important;
  background-color: white !important;
  border-color: #cecfce #cecfce #d6d7de #d6d7de !important;
  border-style: solid !important;
  border-width: 1px !important;
  padding-left: 3px !important;
  height: 25px !important;
  margin-top: 5px !important;
}

button.ui-widget,
button.ui-widget:hover {
  font-weight: normal;
  color: black;
}
a.ui-multiselect-close {
  display: none;
}

span.ui-icon.ui-icon-check,
span.ui-icon.ui-icon-closethick {
  background-image: none;
  display: none;
}

.perc-social-config-gadget-frame span.ui-icon.ui-icon-check,
.perc-social-config-gadget-frame span.ui-icon.ui-icon-closethick {
  display: block;
  width: 16px;
  height: 16px;
  background-image: url(/cm/app/vendor/css/legacy/themes/smoothness/images/ui-icons_222222_256x240.png);
}
.ui-multiselect-checkboxes input[type="checkbox"] {
  margin: 0px 5px;
  vertical-align: baseline;
}

.ui-multiselect-checkboxes {
  border-top: 1px solid #cecfce;
  padding-top: 8px;
}
.ui-datepicker-header.ui-widget-header,
.ui-datepicker-header .ui-widget-header {
  background: url(../themes/base/images/ui-bg_highlight-soft_75_cccccc_1x100.png)
    repeat-x scroll 50% 50% #cccccc;
  border: 1px solid #aaaaaa;
  color: #222222;
  font-weight: bold;
}

.ui-widget-header.ui-multiselect-header {
  background: none;
  border: 0px solid transparent;
}
.ui-slider-range.ui-slider-range-min.ui-widget-header {
  background: url("../themes/smoothness/images/ui-bg_highlight-soft_75_cccccc_1x100.png")
    repeat-x scroll 50% 50% #cccccc;
  border: 1px solid #aaaaaa;
  color: #222222;
  font-weight: bold;
}

.ui-slider.ui-widget-content {
  background: url("../themes/smoothness/images/ui-bg_flat_75_ffffff_40x100.png")
    repeat-x scroll 50% 50% #ffffff;
  border: 1px solid #aaaaaa;
  color: #222222;
}

#ui-timepicker-div {
  border: 1px solid #aaaaaa;
}

#perc-content-edit-page_calendar input.perc-datetime-picker {
  background-color: #cccccc;
  border: 1px inset #999999;
  color: #333333;
  font-family: Verdana;
  font-size: 11px;
  font-weight: normal;
}
#perc-content-edit-page_calendar img {
  margin-top: -5px;
  padding-left: 3px;
  vertical-align: middle;
}

.ui-multiselect-checkboxes label.ui-state-hover {
  background: none;
  border: 0px solid transparent;
  padding: 0px;
  margin: 0px;
}

.perc-wizard-step-index {
  float: left;
  width: 20px;
  height: 20px;
  text-align: center;
  font-weight: bold;
  color: white;
}

.perc-wizard-step-title {
  float: left;
  margin: 1px 20px 0 6px;
}

.perc-wizard-step-index.perc-wizard-step-inactive {
  padding-top: 1px;
  background: url(/cm/app/widgets/PercWizard/images/PercWizardInactive.png)
    no-repeat;
}

.perc-wizard-step-index.perc-wizard-step-active {
  padding-top: 1px;
  background: url(/cm/app/widgets/PercWizard/images/PercWizardActive.png) no-repeat;
}

.perc-wizard-step-title.perc-wizard-step-inactive {
  color: grey;
}

.perc-wizard-step-title.perc-wizard-step-active {
  color: black;
}

.perc-wizard-required-fields-tip {
  position: absolute;
  bottom: 13px;
  left: 30px;
}

body * {
  font-family: "Open Sans", sans-serif;
}

/* Hack for IE height problem (height of the container of dataTables_wrapper must be 100% also to work properly) */
.perc-membership-gadget,
#perc-seo-gadget,
#perc-blogs-gadget,
#perc-comments-gadget,
#perc-formtracker-gadget,
#perc-global-variables-gadget,
#perc-global-variables-table {
  height: 100%;
}

.dataTables_wrapper {
  height: 100%;
}

.perc-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.perc-tooltip {
  display: none;
  position: absolute;
  background-color: white;
  text-align: center;
  padding: 0.5em;
  border-radius: 5px;
  border: 0.5px solid black;
}

.perc-tooltip-container:hover .perc-tooltip {
  display: block;
}

.dataTables_empty .perc-datatable-columnrow {
  text-align: center;
}

.dataTables_empty {
  padding-top: 10px;
  text-align: center;
}

.dataTables_wrapper * {
  font-size: 11px;
  font-weight: normal;
  cursor: default;
}

.perc-datatable {
  width: 100%;
  text-align: center;
}

.perc-datatable thead * {
  padding: 5px;
  cursor: pointer;
  color: #006b9d;
}

.perc-datatable thead th.perc-last.perc-datatable-head-column {
  padding-right: 6px;
}

.perc-datatable thead *,
.perc-datatable tbody td {
  border-bottom: 1px solid lightgrey;
  color: #000000;
}

.perc-datatable tbody td .perc-first,
.perc-datatable-paginator-pages-label {
  color: #000000;
  font-weight: bold;
}

.perc-datatable-columnrow,
.perc-datatable-head-column {
  white-space: nowrap;
  overflow-y: visible;
}

table.perc-datatable tr.perc-datatable-row td.perc-datatable-column.perc-last {
}

.perc-sort {
  height: 10px;
  width: 10px;
  border: none;
  margin-left: 5px;
  border-bottom: none;
}

.sorting_asc .perc-sort {
  background: transparent url(PercDataTableSortAsc.png) no-repeat scroll 0;
}

.sorting_desc .perc-sort {
  background: transparent url(PercDataTableSortDesc.png) no-repeat scroll 0;
}

.paginate_active {
  font-weight: bold;
  text-decoration: underline !important;
}
a.paginate_button.current {
  font-weight: bold !important;
  box-sizing: border-box;
  display: inline-block;
  min-width: 1.5em;
  padding: 0.5em 1em;
  margin-left: 2px;
  text-align: center;
  cursor: pointer;
  text-decoration: none !important;
}

.paginate_active,
.paginate_button {
  font-weight: bold;
  color: #006b9d;
  box-sizing: border-box;
  display: inline-block;
  min-width: 1.5em;
  padding: 0.5em 1em;
  margin-left: 2px;
  text-align: center;
  cursor: pointer;
  text-decoration: underline !important;
}

table.dataTable tbody tr.selected {
  background-color: #b0bed9;
}

td.perc-datatable-column.perc-type-numeric,
.perc-datatable-head-row th.perc-type-numeric.perc-datatable-head-column {
  text-align: right;
}

.perc-type-numeric * {
  text-align: right;
  padding-right: 14px;
}

.perc-gadget-errormessage {
  background: none repeat scroll 0 0 #f0f0f0;
  border-bottom: 1px solid #e6e6e9;
  color: #777777;
  font-size: 11px;
  font-weight: normal;
  margin: auto;
  padding: 20px;
  text-align: center;
  vertical-align: middle;
}

table.perc-datatable div.perc-first {
  padding-top: 10px;
}

table.perc-datatable div.perc-last {
  padding-bottom: 7px;
}

.perc-footer-bar {
  background-color: lightgray;
  width: 2000px;
  height: 20px;
  position: absolute;
  bottom: 0px;
  left: 0px;
  z-index: -1;
  display: none;
}

.perc-datatable-form-tracker-export-action {
  color: white;
  text-decoration: none;
  width: 100%;
}

a.perc-datatable-form-tracker-export-action:hover {
  color: black;
}

a.perc-datatable-form-tracker-export-action:visited {
  color: white;
}

a.perc-datatable-form-tracker-export-action:active {
  color: white;
}
body * {
  font-family: "Open Sans", sans-serif;
}

#perc-finder-listview .perc-datatable-column {
