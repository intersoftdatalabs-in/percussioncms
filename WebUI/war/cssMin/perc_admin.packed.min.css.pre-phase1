/* TODO move to siteSummaryReport.css */
.perc-site-summary-action {
  background: transparent url(../images/images/siteSummaryReport.png) no-repeat
    center left;
  background-size: 20px;
  padding: 8px 0px 0px 25px;
}

/** perc site summary dialog */

.perc-site-summary a:hover,
.perc-site-summary a {
  text-decoration: none;
}
.perc-site-summary h3:first-child {
  padding-top: 6px;
}
.perc-site-summary h3 {
  padding: 35px 0 10px 0;
}
.perc-site-summary .ui-widget-content {
  padding: 6px 35px 20px 35px;
  background: transparent;
}
.perc-site-summary [scrollable] {
  /* height required to ensure scrollbars show properly */
  height: 416px;
}
.perc-site-summary.ui-dialog-content {
  position: relative;
  overflow: inherit;
  box-shadow: 0px 0px 5px -2px #888;
  border: 1px solid #eee;
  padding: 0;
  background: white;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
}
.perc-site-summary.ui-dialog-content h2 {
  padding: 15px 0;
  background: #e6e6e9 url(../images/images/tabAreaShadowBg.gif) center 42px
    repeat-x;
}
.perc-site-summary-dialog-actions {
  /* width must be exact 700 minus left/right padding */
  width: 676px;
  padding: 6px 12px 6px 12px;
  text-align: right;
}
/* TODO: add bg-image for print and refresh */
.perc-site-summary-dialog-actions a {
  width: 37px;
  height: 29px;
  margin-left: 3px;
}
.perc-site-summary-dialog-actions span {
  /* text label */
  display: none;
}
.perc-site-summary-dialog-actions a {
  display: inline-block;
  vertical-align: top;
}
.perc-site-summary-dialog-actions .perc-action-refresh {
  background: url(../images/images/refresh.png);
}
.perc-site-summary-dialog-actions .perc-action-refresh:hover {
  background: url(../images/images/refresh_over.png);
}
.perc-site-summary-dialog-actions .perc-action-print {
  background: url(../images/images/print.png);
}
.perc-site-summary-dialog-actions .perc-action-print:hover {
  background: url(../images/images/print_over.png);
}
.perc-site-summary-warnings {
  clear: both;
}
.perc-site-summary-warnings .perc-log-footer {
  color: #333333;
  text-align: left;
  border-top: 1px solid silver;
}
.perc-site-summary-warnings .perc-log-header {
  color: #333333;
  text-align: left;
  border-bottom: 1px solid silver;
  margin-top: 16px;
}
.perc-site-summary-warnings dt small {
  margin-left: 4px;
}
.perc-site-summary-warnings dt {
  color: #666;
}
.perc-site-summary-warnings dd {
  margin-left: 20px;
}

.perc-site-summary-statistics {
  clear: both;
}
.perc-site-summary-statistics .perc-stat {
  zoom: 1;
  display: inline-table;
  *display: inline;
  width: 180px;
  border-bottom: 1px solid #999;
  margin-right: 40px;
  border-collapse: collapse;
}
.perc-site-summary-statistics .perc-stat .perc-stat-label {
  width: 70%;
  text-align: left;
  font-size: 11px;
  padding: 8px 4px 2px 4px;
  color: black;
  text-shadow: 1px 1px 1px white;
}
.perc-site-summary-statistics .perc-stat .perc-stat-value {
  width: 25%;
  text-align: right;
  font-size: 11px;
  padding: 8px 4px 2px 4px;
  color: black;
  text-shadow: 1px 1px 1px white;
}
.perc-site-summary-statistics .ui-widget-content {
  /* supports two widths 2 column or 3 column */
  width: 440px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
}
.perc-site-summary-statistics .ui-widget-content .perc-3column {
  width: 660px;
}
.perc-site-summary-statistics .ui-widget-content.perc-3columns {
  /* supports two widths 2 column or 3 column */
  width: 660px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
}

.perc-actions .perc-action-expand {
  width: 30px;
}

.perc-actions {
  -height: 30px;
  -width: auto;
  -display: inline-block;
  -float: left;
}

.perc-toggle {
  text-align: center;
  width: 15pt;
  height: 15pt;
}
/* FontAwesome Used To Construct Action Icons
    :hover          - mouse hovers over an active or default item
    .ui-active      - active items are engaged, on or in use by user
    .ui-default     - default state waiting for user interactions
    .ui-disabled    - disabled items cannot interact with user
*/
/*.ui-default state */
.perc-font-icon,
.ui-default.perc-font-icon,
.ui-default .perc-font-icon {
  zoom: 1;
  display: inline-block;
  /*    width: 25px;
        height: 20px; */
  cursor: pointer;
  color: #000;
  font-size: 14pt;
  text-align: center;
  margin: 0;
  border: 0;
  border-radius: 5px;
  padding: 3px;
  background: white;
}
/* .ui-default:hover state */
.perc-font-icon:hover,
.ui-default.perc-font-icon:hover,
.ui-default .perc-font-icon:hover {
  color: #133c55;
  text-shadow: 0px 1px silver;
  background: 84px;
}
/* .ui-active state */
.ui-active.perc-font-icon,
.ui-active .perc-font-icon {
  color: #133c55;
  text-shadow: none;
  background: 84px;
}
/* .ui-active:hover state */
.ui-active.perc-font-icon:hover,
.ui-active .perc-font-icon:hover {
  text-shadow: 0px 1px silver;
}
/* .ui-disabled state */
.ui-disabled.perc-font-icon,
.ui-disabled .perc-font-icon {
  color: #808484;
  text-shadow: none;
  background: transparent;
}
/* .ui-disabled:hover state */
.ui-disabled.perc-font-icon:hover,
.ui-disabled .perc-font-icon:hover {
  text-shadow: 0px 1px silver;
}
/* .ui-disabled state */
.ui-disabled.ui-active.perc-font-icon,
.ui-disabled.ui-active .perc-font-icon,
.ui-disabled .perc-font-icon.ui-active {
  opacity: 0.5;
  color: #133c55;
  text-shadow: none;
  background: 42px;
}
/* .ui-disabled:hover state */
.ui-disabled.perc-font-icon:hover,
.ui-disabled .perc-font-icon:hover {
  text-shadow: 0 1px silver;
}
/* fixes for specific icons */
.perc-font-icon.icon-sitemap {
  /* seems to be a little bigger */
  padding-bottom: 2px;
}
.perc-font-icon .icon-plus,
.perc-font-icon .icon-caret-down {
  /* secondary indicators */
  font-size: 0.5em;
  text-decoration: inherit;
}
/*These styles are font awesome styles*/
.perc-font.perc-font-button,
.perc-font-button a {
  display: inline-block;
  text-decoration: none;
  *display: inline;
  *zoom: 1;
  padding: 4px 12px;
  margin-bottom: 0;
  font-size: 14px;
  line-height: 15px;
  text-align: center;
  vertical-align: middle;
  cursor: pointer;
  color: #333333;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.75);
  background-color: #f5f5f5;
  background-image: -moz-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: -webkit-gradient(
    linear,
    0 0,
    0 100%,
    from(#ffffff),
    to(#e6e6e6)
  );
  background-image: -webkit-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: -o-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: linear-gradient(to bottom, #ffffff, #e6e6e6);
  background-repeat: repeat-x;
  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ffffffff', endColorstr='#ffe6e6e6', GradientType=0);
  border-color: #e6e6e6 #e6e6e6 #bfbfbf;
  border-color: rgba(0, 0, 0, 0.1) rgba(0, 0, 0, 0.1) rgba(0, 0, 0, 0.25);
  *background-color: #e6e6e6;
  filter: progid:DXImageTransform.Microsoft.gradient(enabled = false);
  border: 1px solid #bbbbbb;
  *border: 0;
  border-bottom-color: #a2a2a2;
  -webkit-border-radius: 4px;
  -moz-border-radius: 4px;
  border-radius: 4px;
  *margin-left: 0.3em;
  -webkit-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
  -moz-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
}
.perc-font-button:hover {
  color: #133c55;
  background-color: #e6e6e6;
  *background-color: #d9d9d9;
}

@media print {
  body {
    background: white;
  }
  .perc-site-summary .perc-section-closed {
    display: none;
  }
  .perc-site-summary-statistics .ui-widget-content {
    border: none;
  }
  .perc-site-summary-statistics .perc-stat {
    background: white;
    box-shadow: none;
  }
  .perc-site-summary-statistics .perc-stat td {
    color: black;
    font-weight: bold;
    text-shadow: none;
    background: white;
  }
}

/* style all the tabs */
.ui-tabs li.ui-state-default,
.ui-tabs li.ui-state-default a {
  height: 29px;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
}
.ui-tabs li.ui-state-default {
  top: 3px;
}
.ui-tabs li.ui-tabs-active,
.ui-tabs li.ui-tabs-active a {
  height: 32px;
}
.ui-tabs li.ui-tabs-active {
  top: 1px;
}
#perc-workflow-comment {
  width: 600px;
  height: 60px;
}
#perc-ui-view-indicator {
  display: inline-block;
  width: 3px;
  height: 3px;
  vertical-align: middle;
  padding-right: 0px;
  margin-left: 3px;
}

.perc-ui-view-processing {
  background-color: #ffffff;
}
.perc-ui-view-ready {
  background-color: #133c55;
}
.perc-last-comment-menubar {
  margin-top: 13px;
  height: 28px;
}
.perc-last-comment-menubar span {
  color: #133c55;
  background: #e6e6e9;
}

.transparent-background {
  background: transparent !important;
}

.perc-dropdown-template-pages-items-dropdown li.current,
.perc-imported-page-dropdown-list li.current {
  background: transparent !important;
}

.perc-dropdown-template-pages-items-dropdown a,
.perc-imported-page-dropdown-list a {
  border: none !important;
}

.perc-dropdown-template-pages-items-dropdown ul,
.perc-imported-page-dropdown-list ul {
  z-index: 5000 !important;
}
#perc-redirect-container .readonlyinput {
  background-color: #cccccc;
  border: 1px inset #999999;
  color: #333333;
  margin-top: 5px;
  margin-bottom: 17px;
  min-height: 16px;
  overflow: auto;
  padding: 3px 3px 0;
  width: 310px;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
  display: inline-block;
}
#perc-redirect-to-path-button {
  margin-left: 5px;
  vertical-align: top;
}
.cloud-sopro {
  display: none !important;
}
input,
select,
textarea {
  font-family: "Open Sans" !important;
}

select[name*="_up_"] {
  font-family: "Open Sans", sans-serif !important;
}

#perc-gadget-comments-viewComments-frame-container {
  min-height: 500px !important;
  overflow-y: unset !important;
}

table.dataTable {
  width: 100%;
  margin: 0 auto;
  clear: both;
  border-collapse: collapse;
  border-spacing: 0;
}

/** Finder Resizing Classes */
.perc-finder-body .ui-resizable-handle.ui-resizable-s {
  height: 15px;
  z-index: 999999 !important;
  opacity: 0.25;
  background-image: url(../images/images/finderBottomHandleBg.gif);
}
.perc-resize {
  overflow: hidden !important;
  /* you will need to pad for the width of your ui-resizable-handle */
}
.perc-resize-width {
  width: 100%;
  height: 100%;
  overflow-y: auto !important;
  overflow-x: hidden !important;
}
.perc-resize-height {
  width: 100%;
  height: 100%;
  overflow-x: auto !important;
  overflow-y: hidden !important;
}

.perc-finder .mcol-direc-wrapper.perc-resize-width {
  margin-right: 5px;
}

.perc-finder .mcol-direc-wrapper .ui-resizable-e {
  height: 100% !important;
  border-right: 1px solid #e8efef;
  z-index: 101;
}

.perc-finder .mcol-listing {
  margin: 0px;
  padding: 4px 4px 2px 8px;
}

.perc-finder {
  min-width: 952px;
  /* set the minimum height that the Finder can drag to */
  min-height: 100px;
  padding: 0;
  float: none;
}

.perc-finder-outer[collapsed="true"] .perc-finder-view-options .icon-list,
.perc-finder-outer[collapsed="true"] .perc-finder-view-options .icon-star,
.perc-finder-outer[collapsed="true"] .perc-finder-view-options .icon-columns {
  display: none;
}

.perc-finder-outer[collapsed="true"] .perc-finder-view-options {
  width: 30px;
}

.ui-disabled #perc-finder-expander {
  color: #ccc;
}

#perc-finder-expander:hover {
  font-size: 15pt;
  color: #298ac0;
  background: transparent;
}

#perc-finder-expander {
  font-size: 15pt;
  -color: #399ece;
  color: #133c55;
  margin-right: 6px;
  background: transparent;
}

.perc-dropshadow {
  min-width: 100%;
  margin: 0;
  padding-bottom: 2px;
  background: transparent url(../images/images/finderShadowBg.gif) repeat-x
    scroll center bottom;
}

.perc-main {
  background-color: white;

  font-family: "Open Sans", sans-serif;
  font-size: 10pt;

  margin-left: auto;
  margin-right: auto;
  min-width: 100%;
}

.perc-finder-header td {
  vertical-align: middle;
}

.perc-finder-header {
  width: 100%;
  margin: 20px 12px 10px 2px;
  -webkit-box-sizing: border-box; /* Safari/Chrome, other WebKit */
  -moz-box-sizing: border-box; /* Firefox, other Gecko */
  box-sizing: border-box; /* Opera/IE 8+ */
}

.perc-finder .perc-finder-panel-loading {
  padding: 8px;
  display: block;
  position: absolute;
  top: 1px;
  left: 60px;
}
.perc-finder-view-options {
  width: 145px;
}

.perc-finder-buttonbar .perc-font-icon {
  float: right;
  margin-right: 4px;
}

.perc-finder-buttonbar .perc-font-icon:focus {
  outline: 1px dotted #212121;
  outline: 5px auto -webkit-focus-ring-color;
}

.perc-finder-goto-or-search .perc-flex {
  vertical-align: middle;
}
.perc-finder-goto-or-search .perc-fixed {
  width: 25px;
}
.perc-finder-goto-or-search input {
  width: 100%;
  -webkit-box-sizing: border-box; /* Safari/Chrome, other WebKit */
  -moz-box-sizing: border-box; /* Firefox, other Gecko */
  box-sizing: border-box; /* Opera/IE 8+ */
  border-top-left-radius: 11px;
  border-bottom-left-radius: 11px;
  padding: 0 6px 0 6px;
  border: 0;
  height: 26px;
  font-family: "Open Sans", sans-serif;
}

.perc-finder-goto-or-search .perc-font-icon:hover {
  background: transparent;
}

.perc-finder-goto-or-search .perc-font-icon {
  display: inline-block;
  font-size: 13pt;
  margin: 0;
  border-radius: 0;
  border-top-right-radius: 11px;
  border-bottom-right-radius: 11px;
  background: transparent;
}

.perc-finder-goto-or-search .perc-wrapper {
  border: 1px solid #c0c0c0;
  padding: 1px;
  border-radius: 12px;
}
.perc-finder-goto-or-search .perc-wrapper-bg {
  background: #c0c0c0;
}

.perc-finder-goto-or-search .perc-wrapper table {
  -webkit-box-sizing: border-box; /* Safari/Chrome, other WebKit */
  -moz-box-sizing: border-box; /* Firefox, other Gecko */
  box-sizing: border-box; /* Opera/IE 8+ */
  width: 100%;
  height: 25px;
}

#perc-finder-listing-Sites {
  margin-top: 33px;
}

/*********min size for the iframe should be same as main are set by perc-main above ************/
#frame {
  min-width: 100%;
}

.perc-about {
  width: 330px;
  text-align: center;
}

.perc-about .perc-logo {
  background-image: url(../images/images/aboutLogo.png);
  width: 175px;
  height: 50px;
  background-repeat: no-repeat;
  margin: auto;
}

.perc-required-field:before {
  content: "* ";
  margin-left: -11px;
}

.perc-required-legend {
  float: left;
  padding-right: 9px;
  margin-top: -25px;
  position: relative;
}

/* Fix the position of Finder/Navigation at top */
.perc-finder-fix {
  position: relative;
  top: 0;
  left: 0;
  z-index: 1001;
  width: 100%;
  padding-bottom: 0;
  background: #fff;
}

#perc_sa_container {
  margin-top: 8px;
  width: 100%;
  padding-bottom: 0;
}

/* Main help icon related styles */

#perc-user-id-icon {
  position: relative;
  top: 5px;
  padding-right: 5px;
}

#perc-logout-arrow-icon {
  position: relative;
  top: 2px;
  padding-right: 4px;
}

/******* Finder menu *************
****** Utilized for Finder resizing
 and adding, removing sites  *****/
.perc-finder-body {
  /* width is always 100% need to override jquery resize */
  width: 100% !important;
  /* finder visibility is initialized in perc_finder.js
        hide to prevent a flicker when page is loading */
  display: none;
  border-radius: 6px;
  border: 1px solid silver;
  background-color: #f7f7f7;
  /* resize scroll-fix padding */
  padding-right: 0;
  padding-bottom: 10px;
}

.perc-finder-message > i {
  color: red;
  font-size: 15pt;
  margin-right: 5px;
}
.perc-finder-message {
  text-align: left;
  padding-left: 153px;
  margin-bottom: 7px;
}

.perc-finder-outer {
  margin: 0 10px;
}

/* The primary label for the finder. */
#perc-finder-label {
  padding: 5px 0 0;
}

.perc-finder-menu label {
  color: #999999;
  float: left;
  font-size: 11px;
  font-weight: normal;
  padding-left: 10px;
  margin: 14px 0 0 5px;
  text-decoration: none;
}

div#perc-finder-selected-label {
  color: #999999;
  display: none;
  float: left;
  font-size: 11px;
  font-weight: normal;
  padding-left: 10px;
  margin: 15px 0 0 5px;
  text-decoration: none;
  width: 500px;
  overflow: hidden;
  white-space: nowrap;
  text-align: left;
  text-overflow: ellipsis;
}

#mcol-path-summary-short {
  background-color: #41434f;
  color: #cccccc;
  border: 0;
  font-family: "Open Sans", sans-serif;
  text-decoration: none;
  font-weight: normal;
}

.perc-finder .perc-finder-table > table {
  height: 100%;
}

/* reset browser default */
.perc-finder-table td {
  padding: 0;
}

.perc-finder .label {
  text-transform: uppercase;
  font-family: "Open Sans", sans-serif;
  color: #cccccc;
  font-size: 15px;
}

#perc-finder-input-wrapper {
  width: 80%;
  min-width: 790px;
  overflow: auto;
  padding: 2px 0 0;
}

.perc-finder-preview-link {
  color: #0055ee;
}

.perc-finder-menu #perc-finder-copy-page,
.perc-finder-menu #perc-finder-folderproperties,
.perc-finder-menu #perc-finder-download,
.perc-finder-menu #perc-finder-upload,
.perc-finder-menu #perc-finder-restore-item {
  color: #0099cc;
  padding: 9px 0 10px 14px;
  display: block;
}

.perc-finder-menu #perc-finder-copy-page.ui-enabled:hover,
.perc-finder-menu #perc-finder-folderproperties.ui-enabled:hover,
.perc-finder-menu #perc-finder-download.ui-enabled:hover,
.perc-finder-menu #perc-finder-upload.ui-enabled:hover,
.perc-finder-restore-item #perc-finder-restore-item.ui-enabled:hover {
  cursor: pointer;
}

.perc-finder-menu #perc-finder-copy-page.ui-disabled,
.perc-finder-menu #perc-finder-folderproperties.ui-disabled,
.perc-finder-menu #perc-finder-download.ui-disabled,
.perc-finder-menu #perc-finder-upload.ui-disabled,
.perc-finder-menu #perc-finder-restore-item.ui-disabled {
  cursor: default;
  color: #9fa3aa;
}

