}
.perc-finder .mcol-listing,
.perc-finder.ui-resizable-resizing .mcol-listing,
.perc-finder.ui-resizable-resizing .mcol-listing:hover {
  height: 20px;
  background-color: transparent;
}

/***First column styles***/
.perc-finder .mcol-direc-wrapper.perc-view-column-fixed {
  width: 95px;
}

.perc-finder-menu {
  padding-right: 20px;
  width: 240px;
  line-height: normal;
  vertical-align: top;
}

#perc_finder_inline_field_edit {
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
}

/*************Finder Paging*********************/
.perc-paging-finder.perc-paging-finder-top {
  font-weight: bold;
  font-size: 11.5pt;
  opacity: 0.25;
  padding: 9px 4px 4px 9px;
}
.perc-paging-finder {
  -background-color: #35363f;
  -background-color: red;

  -color: #ffffff;
  -color: yellow;

  -font-size: 9px;
  -font-weight: bold;

  width: auto;
  height: 20px;

  -padding: 5px 0 0 5px;
  padding: 0;
}

.perc-paging-finder span {
  white-space: nowrap;
}

.perc-paging-finder-navigator {
  float: right;
  padding-right: 5px;
}

.perc-paging-finder-navigator a {
  cursor: pointer;
  margin-right: 10px;
}

.perc-hide-navigator {
  visibility: hidden;
}

#perc-page-help-menu {
  position: absolute;
  top: 18px;
  right: 0;
  z-index: 20000;
  color: white;
  border: 1px solid #35363f;
  background-color: #5a5d69;
}

#perc-page-help-menu li {
  padding: 5px 40px 5px 5px;
}

#perc-page-help-menu li:first-child {
  padding: 5px 40px 5px 5px;
  border-bottom: 1px solid #6c717c;
}

#perc-page-help-menu li:hover {
  background-color: #caf589;
  color: black;
}

.perc-about > p {
  text-align: center;
}

.perc-about .perc-company-link {
  font-weight: bold;
  font-size: 14px;
  color: #0099cc;
}

/* Navigation Menu
*** Selected Page ****
*******Page 1 ********
*******Page 2 ********
*******Page 3 *********/
#perc_head #perc_topnav .perc-selected {
  display: block;
  background-color: #6c717c;
  cursor: pointer;
}

#perc_head #perc_topnav .perc-selected .perc-label {
  font-family: "Open Sans", sans-serif;
  text-transform: uppercase;
  font-size: 17px;
  color: #ffffff;
}

#perc_head #perc_topnav .perc-selected #perc-dropdown-img {
  background-image: url(../images/images/navDropdownArrow.gif);
}

#perc_head #perc_topnav #perc-dropdown-img:hover {
  background-image: url(../images/images/navDropdownArrowOver.gif);
  cursor: pointer;
}

#perc_head #perc_topnav .perc-selected a {
  color: inherit !important;
}

#perc_head div ul .unselected {
  display: block;
  font-weight: bold;
  font-size: 11px;
  font-family: "Open Sans", sans-serif;
  background-color: #5a5d69;
  border-color: #5a5d69;
  border-bottom: solid 1px #6d6f79;
  color: #ffffff;
  opacity: 1%;
  z-index: 100;
}

#perc_head div ul .selected {
  display: block;
  font-weight: bold;
  font-size: 11px;
  font-family: "Open Sans", sans-serif;
  background-color: #5a5d69;
  border-bottom: solid 1px #6d6f79;
  color: #ffffff;
  opacity: 1%;
  z-index: 100;
}

#perc_head div ul .unselected a,
#perc_head div ul .inactive a {
  border-left: 6px solid;
  border-color: inherit !important;
  padding-left: 6px;
  padding-top: 0;
  padding-bottom: 3px;
  color: inherit;
}

#perc_head div ul .selected a {
  border-left-color: #caf589 !important;
  color: inherit;
}

#perc_head div ul li {
  display: inline;
  clear: none;
}

#perc_head div ul li:hover {
  background-color: #caf589 !important;
  cursor: pointer;
  color: #000000;
  border-color: #caf589 !important;
}

#perc_head div ul .unselected.subsection,
#perc_head div ul .selected.subsection {
  padding-left: 30px;
  font-weight: normal;
}

#perc_head div ul .selected.nosubsection {
  min-width: 276px;
}

#perc_head div ul .unselected.inactive,
#perc_head div ul .selected.inactive {
  border-bottom: dashed 1px #6d6f79;
  cursor: default;
}

#perc_head div ul .inactive a {
  cursor: default;
}

#perc_head div ul .inactive {
  display: block;
  font-weight: bold;
  font-size: 11px;
  font-family: "Open Sans", sans-serif;
  background-color: #5a5d69;
  border-color: #5a5d69;
  border-bottom: dashed 1px #6d6f79;
  color: #ffffff;
  opacity: 1%;
  z-index: 100;
}

#perc_head div ul .inactive:hover {
  cursor: default;
  background-color: #5a5d69 !important;
  color: #ffffff;
  border-color: #5a5d69 !important;
  border-bottom: dashed 1px #6d6f79 !important;
}

#perc_head div ul .last {
  height: 33px;
}

.perc-finder .ui-resizable-e {
  width: 5px;
  right: 0px;
}
.perc-finder .ui-resizable-e.perc-resize-disabled {
  cursor: default;
  background-image: none;
}
.perc-finder .ui-resizable-e {
  background-color: white;
  background-image: url(../images/images/finderBottomHandleBgVert.gif);
  background-repeat: no-repeat;
  background-position: center;
}

.perc-fixedtableheader {
  display: none;
}

[perc-view="list"] .ui-resizable-handle.ui-resizable-e,
[perc-view="search"] .ui-resizable-handle.ui-resizable-e,
[perc-view="MyPages"] .ui-resizable-handle.ui-resizable-e {
  display: none !important;
}

.perc-fixedtableheader .perc-datatable-head-row,
#perc-finder-listview .perc-datatable-head-row,
#perc-finder-listview .perc-datatable-column:last-child,
.perc-fixedtableheader .perc-datatable-head-column:last-child,
#perc-finder-listview .perc-datatable-head-column:last-child {
  border-right: none !important;
}

/*CMS-8525 : If you delete any site listed in list view the table comes to the bottom*/
#perc-finder-table-top .mcol-direc {
  vertical-align: top !important;
}

.perc-dialog .ui-dialog-content {
  /* background-color: #E6E6E9; */
}
.perc-dialog {
  /* background-color: #E6E6E9; */
  z-index: 5000;
}

.perc-dialog .ui-widget-header {
  background: none repeat scroll 0 0 transparent;
}
.perc-dialog .ui-layout-pane {
  background-color: #e6e6e9;
}
.perc-dialog .ui-dialog-content {
  /* background-color: #E6E6E9; */
  /* color: #000000; */
  font-family: "Open Sans", sans-serif;
  /* font-size: 11px; */
  font-weight: normal;
}

.ui-dialog .ui-dialog-titlebar-close span {
  display: none;
  margin: 1px;
}

.ui-dialog-titlebar-resize {
  position: absolute;
  right: 0.3em;
  top: 50%;
  width: 19px;
  margin: -10px 0 0 0;
  padding: 1px;
  height: 18px;
}

.ui-dialog-titlebar {
  background: none repeat scroll 0 0 #ffffff;
  height: 30px;
  padding-top: 20px;
}
.perc-dialog label {
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
}
.perc-dialog-corner-all {
}
.perc-dialog .ui-dialog-buttonpane {
  border-width: 0;
