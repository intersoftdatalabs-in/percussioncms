    transparent;
}

#perc-splashscreen .ui-dialog-content {
  padding: 0px;
  overflow: hidden;
}

#perc-template-lib {
  width: 581px;
}

.ui-dialog-content .radio-left {
  height: auto;
  margin: 1px 0 5px -18px;
  padding: 0;
  position: absolute;
  width: auto;
}

#perc_import_progress_dialog .ui-dialog-content {
  padding-right: 35px;
}
#perc_import_progress_dialog .ui-dialog-content a {
  color: #133c55;
  text-decoration: none;
}
#perc_import_progress_dialog .progress {
  position: relative;
}
#perc_import_progress_dialog .error-message,
#perc_import_progress_dialog .success-message {
  display: none;
  position: absolute;
  top: 0;
}
#perc_import_progress_dialog .progress-bar-container {
  background-color: #fff;
  border: 1px solid #a6cd66;
  height: 18px;
  margin-top: 17px;
  overflow: hidden;
  width: auto;
}
#perc_import_progress_dialog .progress-bar {
  background-color: #cbf479;
  border-left: 1px solid #fff;
  border-top: 1px solid #fff;
  height: 17px;
  width: 0;
}
#perc_import_progress_dialog .hint {
  float: left;
  margin: 17px auto 0 auto;
}

/* unassigned pages panel*/
.perc-unassigned-panel-expander {
  background-color: #d7d7d9;
  display: block;
  float: left;
  height: 487px;
  width: 18px;
}
.perc-panel-expander-icon {
  display: block;
  height: 16px;
  margin-left: 1px;
  margin-top: 243px;
  width: 16px;
}
.perc-panel-expander-icon.perc-collapsed {
  background-image: url("../images/images/buttonBluePlus.png");
}
.perc-panel-expander-icon.perc-collapsed:hover {
  background-image: url("../images/images/buttonBluePlusOver.png");
}
.perc-panel-expander-icon.perc-expanded {
  background-image: url("../images/images/buttonBlueMinus.png");
}
.perc-panel-expander-icon.perc-expanded:hover {
  background-image: url("../images/images/buttonBlueMinusOver.png");
}
.perc-unassigned-panel {
  background-color: #e6e6e9;
  box-shadow: 4px 4px 4px 0px #bbbbbb;
  -moz-box-shadow: 4px 4px 4px 0px #bbbbbb;
  -webkit-box-shadow: 4px 4px 4px 0px #bbbbbb;
  filter: progid:DXImageTransform.Microsoft.Shadow(color=#BBBBBB,direction=135,strength=4);
  display: none;
  float: left;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  height: 487px;
  margin: 0px 20px 10px 0px;
  width: 246px;
}
.perc-unassigned-panel .perc-panel-title {
  color: #5a6777;
  line-height: 11px;
  padding: 29px 0 13px 10px;
}
.perc-unassigned-panel .perc-panel-progress {
  background-color: white;
  border: 1px solid #bbbbbb;
  height: 31px;
  margin: 0px 10px 0px 10px;
  padding: 12px 7px 15px 6px;
  font-size: 10px;
}
.perc-unassigned-panel .perc-panel-progress .perc-progress-message {
  line-height: 10px;
}
.perc-unassigned-panel .perc-progress-bar-container {
  background-color: #e6e6e9;
  box-shadow: 4px 4px 4px #bbb;
  -moz-box-shadow: 4px 4px 4px #bbb;
  -webkit-box-shadow: 4px 4px 4px #bbb;
  filter: progid:DXImageTransform.Microsoft.Shadow(color=#cccccc,direction=135,strength=4);
  height: 10px;
  margin-top: 4px;
  padding: 3px;
}
.perc-unassigned-panel .perc-progress-finished {
  height: 10px;
  margin-top: 4px;
  padding: 3px;
  display: none;
}
.perc-unassigned-panel .perc-progress-bar-container .perc-progress-bar {
  background-color: #80bc22;
  height: 10px;
  width: 0%;
}
.perc-unassigned-panel .perc-panel-pages-list {
  height: 300px;
  margin: 15px 16px 0px 16px;
}
.perc-unassigned-panel .perc-panel-pages-list li {
  background-color: white;
  height: 26px;
  margin-bottom: 4px;
  padding: 0px 8px;
}
.perc-unassigned-panel .perc-panel-pages-list li.perc-page-disabled {
  color: gray;
}
.perc-unassigned-panel .perc-panel-pages-list div {
  float: left;
  margin-top: 5px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 150px;
}
.perc-unassigned-panel .perc-panel-pages-list .perc-left-img {
  float: left;
  margin: 5px 10px 0px 0px;
}
.perc-unassigned-panel .perc-panel-pages-list .perc-right-img {
  float: right;
  margin: 5px 0px 0px 0px;
}
.perc-unassigned-panel .perc-panel-page-range {
  margin: 2px 0pt 0px 24px;
  width: 100px;
}
.perc-unassigned-panel .perc-panel-total-item {
  float: left;
  margin: 8px 0pt 13px 24px;
  width: 100px;
}
.perc-unassigned-panel .perc-panel-view-all {
  float: right;
  margin: 8px 24px 13px 8px;
}
.perc-unassigned-panel .perc-panel-view-all a {
  color: #133c55;
}
