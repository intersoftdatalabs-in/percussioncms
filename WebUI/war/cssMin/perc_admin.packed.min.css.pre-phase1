#perc-assigned-templates .perc-template-pages {
  clear: both;
  width: auto;
  margin: 0 16px;
}

.perc-template-pages-controls {
  float: right;
  position: relative;
  text-align: right;
  width: 100px;
  margin: 0 16px 0 0;
}

.perc-template-pages-controls div {
  height: 17px;
  overflow: hidden;
  position: absolute;
  text-indent: 9999px;
  width: 9px;
  margin: 2px 0 0;
}

.perc-template-pages-controls input {
  height: 13px;
  padding-bottom: 2px;
  padding-left: 3px;
  padding-right: 3px;
  position: absolute;
  right: 14px;
  text-align: right;
  width: 31px;
  border-width: 0;
  margin: 3px 0 0;
}

.perc-template-pages-controls div.previous {
  background: url("../images/images/perc-template-pages-previous.png") no-repeat
    scroll 0 0 transparent;
  cursor: pointer;
}

.perc-template-pages-controls div.next {
  background: url("../images/images/perc-template-pages-next.png") no-repeat
    scroll 0 0 transparent;
  cursor: pointer;
}

.perc-template-pages-controls div.previous:hover {
  background: url("../images/images/perc-template-pages-previous-hover.png")
    no-repeat scroll 0 0 transparent;
  cursor: pointer;
}

.perc-template-pages-controls div.next:hover {
  background: url("../images/images/perc-template-pages-next-hover.png")
    no-repeat scroll 0 0 transparent;
  cursor: pointer;
}

.perc-template-pages-controls div.previous-disabled {
  background: url("../images/images/perc-template-pages-previous-disabled.png")
    no-repeat scroll 0 0 transparent;
}

.perc-template-pages-controls div.next-disabled {
  background: url("../images/images/perc-template-pages-next-disabled.png")
    no-repeat scroll 0 0 transparent;
}

#perc-assigned-templates .perc-template-pages li {
