}

.perc-finder .perc-node a selected {
  background-color: #d3d3d3;
}

.perc-finder .perc-view-column-resize-bar {
  background-image: url(../images/images/finderScrollbarBg.gif);
}
.perc-finder .mcol-listing .perc-finder-item-name {
  padding-left: 4px;
}
.perc-finder .mcol-listing.mcol-opened,
.perc-finder.ui-resizable-resizing .mcol-listing.mcol-opened,
.perc-finder.ui-resizable-resizing .mcol-listing.mcol-opened:hover {
  font-weight: bolder;
  -border-bottom: 3px solid #67d1e5;
  -border-bottom: 3px solid #d4e6f7;
  -background-color: #d4e6f7;
  -background-color: #67d1e5;
