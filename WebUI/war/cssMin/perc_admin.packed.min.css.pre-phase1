/** perc site summary dialog */

.perc-site-summary a:hover,
.perc-site-summary a {
  text-decoration: none;
}
.perc-site-summary h3:first-child {
  padding-top: 6px;
}
.perc-site-summary h3 {
  padding: 35px 0 10px 0;
}
.perc-site-summary .ui-widget-content {
  padding: 6px 35px 20px 35px;
  background: transparent;
}
.perc-site-summary [scrollable] {
  /* height required to ensure scrollbars show properly */
  height: 416px;
}
.perc-site-summary.ui-dialog-content {
  position: relative;
  overflow: inherit;
  box-shadow: 0px 0px 5px -2px #888;
  border: 1px solid #eee;
  padding: 0;
  background: white;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
}
.perc-site-summary.ui-dialog-content h2 {
  padding: 15px 0;
  background: #e6e6e9 url(../images/images/tabAreaShadowBg.gif) center 42px
    repeat-x;
}
.perc-site-summary-dialog-actions {
  /* width must be exact 700 minus left/right padding */
  width: 676px;
  padding: 6px 12px 6px 12px;
  text-align: right;
}
/* TODO: add bg-image for print and refresh */
.perc-site-summary-dialog-actions a {
  width: 37px;
  height: 29px;
  margin-left: 3px;
}
.perc-site-summary-dialog-actions span {
  /* text label */
  display: none;
}
.perc-site-summary-dialog-actions a {
  display: inline-block;
  vertical-align: top;
}
.perc-site-summary-dialog-actions .perc-action-refresh {
  background: url(../images/images/refresh.png);
}
.perc-site-summary-dialog-actions .perc-action-refresh:hover {
  background: url(../images/images/refresh_over.png);
}
.perc-site-summary-dialog-actions .perc-action-print {
  background: url(../images/images/print.png);
}
.perc-site-summary-dialog-actions .perc-action-print:hover {
  background: url(../images/images/print_over.png);
}
.perc-site-summary-warnings {
  clear: both;
}
.perc-site-summary-warnings .perc-log-footer {
  color: #333333;
  text-align: left;
  border-top: 1px solid silver;
}
.perc-site-summary-warnings .perc-log-header {
  color: #333333;
  text-align: left;
  border-bottom: 1px solid silver;
  margin-top: 16px;
}
.perc-site-summary-warnings dt small {
  margin-left: 4px;
}
.perc-site-summary-warnings dt {
  color: #666;
}
.perc-site-summary-warnings dd {
  margin-left: 20px;
}

.perc-site-summary-statistics {
  clear: both;
}
.perc-site-summary-statistics .perc-stat {
  zoom: 1;
  display: inline-table;
  *display: inline;
  width: 180px;
  border-bottom: 1px solid #999;
  margin-right: 40px;
  border-collapse: collapse;
}
.perc-site-summary-statistics .perc-stat .perc-stat-label {
  width: 70%;
  text-align: left;
  font-size: 11px;
  padding: 8px 4px 2px 4px;
  color: black;
  text-shadow: 1px 1px 1px white;
}
.perc-site-summary-statistics .perc-stat .perc-stat-value {
  width: 25%;
  text-align: right;
  font-size: 11px;
  padding: 8px 4px 2px 4px;
  color: black;
  text-shadow: 1px 1px 1px white;
}
.perc-site-summary-statistics .ui-widget-content {
  /* supports two widths 2 column or 3 column */
  width: 440px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
}
.perc-site-summary-statistics .ui-widget-content .perc-3column {
  width: 660px;
}
.perc-site-summary-statistics .ui-widget-content.perc-3columns {
  /* supports two widths 2 column or 3 column */
  width: 660px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
}

.perc-actions .perc-action-expand {
  width: 30px;
}

.perc-actions {
  -height: 30px;
  -width: auto;
  -display: inline-block;
  -float: left;
}

.perc-toggle {
  text-align: center;
  width: 15pt;
  height: 15pt;
}
/* FontAwesome Used To Construct Action Icons
    :hover          - mouse hovers over an active or default item
    .ui-active      - active items are engaged, on or in use by user
    .ui-default     - default state waiting for user interactions
    .ui-disabled    - disabled items cannot interact with user
*/
/*.ui-default state */
.perc-font-icon,
.ui-default.perc-font-icon,
.ui-default .perc-font-icon {
  zoom: 1;
  display: inline-block;
  /*    width: 25px;
        height: 20px; */
  cursor: pointer;
  color: #000;
  font-size: 14pt;
  text-align: center;
  margin: 0;
  border: 0;
  border-radius: 5px;
  padding: 3px;
  background: white;
}
/* .ui-default:hover state */
.perc-font-icon:hover,
.ui-default.perc-font-icon:hover,
.ui-default .perc-font-icon:hover {
  color: #133c55;
  text-shadow: 0px 1px silver;
  background: 84px;
}
/* .ui-active state */
.ui-active.perc-font-icon,
.ui-active .perc-font-icon {
  color: #133c55;
  text-shadow: none;
  background: 84px;
}
/* .ui-active:hover state */
.ui-active.perc-font-icon:hover,
.ui-active .perc-font-icon:hover {
  text-shadow: 0px 1px silver;
}
/* .ui-disabled state */
.ui-disabled.perc-font-icon,
.ui-disabled .perc-font-icon {
  color: #808484;
  text-shadow: none;
  background: transparent;
}
/* .ui-disabled:hover state */
.ui-disabled.perc-font-icon:hover,
.ui-disabled .perc-font-icon:hover {
  text-shadow: 0px 1px silver;
}
/* .ui-disabled state */
.ui-disabled.ui-active.perc-font-icon,
.ui-disabled.ui-active .perc-font-icon,
.ui-disabled .perc-font-icon.ui-active {
  opacity: 0.5;
  color: #133c55;
  text-shadow: none;
  background: 42px;
}
/* .ui-disabled:hover state */
.ui-disabled.perc-font-icon:hover,
.ui-disabled .perc-font-icon:hover {
  text-shadow: 0 1px silver;
}
/* fixes for specific icons */
.perc-font-icon.icon-sitemap {
  /* seems to be a little bigger */
  padding-bottom: 2px;
}
.perc-font-icon .icon-plus,
.perc-font-icon .icon-caret-down {
  /* secondary indicators */
  font-size: 0.5em;
  text-decoration: inherit;
}
/*These styles are font awesome styles*/
.perc-font.perc-font-button,
.perc-font-button a {
  display: inline-block;
  text-decoration: none;
  *display: inline;
  *zoom: 1;
  padding: 4px 12px;
  margin-bottom: 0;
  font-size: 14px;
  line-height: 15px;
  text-align: center;
  vertical-align: middle;
  cursor: pointer;
  color: #333333;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.75);
  background-color: #f5f5f5;
  background-image: -moz-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: -webkit-gradient(
    linear,
    0 0,
    0 100%,
    from(#ffffff),
    to(#e6e6e6)
  );
  background-image: -webkit-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: -o-linear-gradient(top, #ffffff, #e6e6e6);
  background-image: linear-gradient(to bottom, #ffffff, #e6e6e6);
  background-repeat: repeat-x;
  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ffffffff', endColorstr='#ffe6e6e6', GradientType=0);
  border-color: #e6e6e6 #e6e6e6 #bfbfbf;
  border-color: rgba(0, 0, 0, 0.1) rgba(0, 0, 0, 0.1) rgba(0, 0, 0, 0.25);
  *background-color: #e6e6e6;
  filter: progid:DXImageTransform.Microsoft.gradient(enabled = false);
  border: 1px solid #bbbbbb;
  *border: 0;
  border-bottom-color: #a2a2a2;
  -webkit-border-radius: 4px;
  -moz-border-radius: 4px;
  border-radius: 4px;
  *margin-left: 0.3em;
  -webkit-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
  -moz-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 1px 2px rgba(0, 0, 0, 0.05);
}
.perc-font-button:hover {
  color: #133c55;
  background-color: #e6e6e6;
  *background-color: #d9d9d9;
}

@media print {
  body {
    background: white;
  }
  .perc-site-summary .perc-section-closed {
    display: none;
  }
  .perc-site-summary-statistics .ui-widget-content {
    border: none;
  }
  .perc-site-summary-statistics .perc-stat {
    background: white;
    box-shadow: none;
  }
  .perc-site-summary-statistics .perc-stat td {
    color: black;
    font-weight: bold;
    text-shadow: none;
    background: white;
  }
}

