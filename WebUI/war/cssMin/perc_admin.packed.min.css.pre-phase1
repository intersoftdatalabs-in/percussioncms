  text-align: right;
}

li.perc-moreLink {
  background: url("../images/images/dropdownArrow.gif") no-repeat scroll right
    center transparent;
  padding-right: 15px !important;
}

li.perc-lessLink {
  background: url("../images/images/upArrow.png") no-repeat scroll right center
    transparent;
}

.perc-multicheck-list {
  background-color: #f5f5f6;
  display: block;
  height: 250px;
  overflow: auto;
  width: 330px;
  padding: 4px 0 2px;
}

.perc-items-container {
  display: inline-block;
  min-width: 100%;
}

.perc-item-entry {
  border-bottom: 3px solid #e6e6e9;
  color: #000000;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  font-weight: normal;
  margin-top: 5px;
  padding-bottom: 5px;
  padding-left: 15px;
  padding-right: 15px;
  text-decoration: none;
  white-space: nowrap;
}

.perc-item-entry input {
  height: 15px;
  position: relative;
  top: 0;
  vertical-align: middle;
  width: 15px;
  margin: 0 5px 0 0;
}

div.perc-scrollable-templates div.perc-items div.perc-template-item {
  background-color: #e6e6e9;
  border: 5px solid white;
  float: left;
  position: relative;
  width: 248px;
}

div.perc-scrollable-templates div.perc-items div.perc-template-item:hover {
  background-color: #eafbce;
}

.perc-prev-templates-carousel {
  background-color: #f7f7f7;
  border-right: 1px solid #e6e6e9;
  display: block;
  height: 428px;
  position: absolute;
  top: 30px;
  vertical-align: top;
  width: 39px;
}

.perc-prev-templates-carousel-arrow {
  background-image: url("../images/images/carousel-scroll-left.png");
  display: block;
  float: right;
  height: 44px;
  margin-top: 200px;
  width: 21px;
}

.perc-prev-templates-carousel-arrow:hover {
  background-image: url("../images/images/carousel-scroll-left-over.png");
}

#perc_prev_templates_carousel_arrow.disabled {
  background-image: url("../images/images/carousel-scroll-left-disable.png");
}

.perc-next-templates-carousel {
  background-color: #f7f7f7;
  border-left: 1px solid #e6e6e9;
  border-right: 2px solid #e5e5e6;
  height: 428px;
  position: absolute;
  right: 0;
  top: 30px;
  vertical-align: top;
  width: 39px;
}

.perc-next-templates-carousel-arrow {
  background-image: url("../images/images/carousel-scroll-right.png");
  display: block;
  height: 44px;
  margin-top: 200px;
  width: 21px;
}

.perc-next-templates-carousel-arrow:hover {
  background-image: url("../images/images/carousel-scroll-right-over.png");
}

#perc_next_templates_carousel_arrow.disabled {
  background-image: url("../images/images/carousel-scroll-right-disable.png");
}

.perc-template-item-empty {
  background-image: url("../images/images/carousel-empty-template.png");
  border-bottom: 5px solid #ffffff;
  border-top: 5px solid #ffffff;
  height: 414px;
  width: 246px;
  margin: auto;
}

#perc-assigned-templates
  .perc-template-item
  .perc-template-paging-container
  .perc-template-page-group-range,
#perc-assigned-templates
  .perc-template-item
  .perc-template-paging-container
