}

#perc-finder-listview .perc-datatable-column {
  border-bottom: 0px solid black !important;
  border-top: 0px solid black !important;
  border-right: 1px solid rgb(106, 110, 125) !important;
  border-left: 0px solid black !important;
}

.perc-fixedtableheader .sorting_asc,
#perc-finder-listview .dataTables_wrapper .sorting_asc {
  background-image: none !important;
  font-style: italic;
}

.perc-fixedtableheader .sorting_desc,
#perc-finder-listview .dataTables_wrapper .sorting_desc {
  background-image: none !important;
  font-style: italic;
}

.perc-fixedtableheader .sorting_asc .perc-sort,
#perc-finder-listview .sorting_asc .perc-sort {
  background: url("/cm/widgets/PercFinderListView/FinderSortingArrowUp.gif")
    no-repeat scroll 0 50% transparent !important;
}

.perc-fixedtableheader .sorting_desc .perc-sort,
#perc-finder-listview .sorting_desc .perc-sort {
  background: url("/cm/widgets/PercFinderListView/FinderSortingArrowDown.gif")
    no-repeat scroll 0 50% transparent !important;
}

.perc-fixedtableheader .perc-datatable-head-column,
#perc-finder-listview .perc-datatable-head-column {
  padding: 5px 10px !important;
  cursor: pointer;
  text-align: left !important;
  color: #444444;
  font-weight: normal;
  font-size: 11px !important;
  border-bottom: 0px solid black !important;
  border-top: 0px solid black !important;
  border-right: 1px solid rgb(106, 110, 125) !important;
  border-left: 0px solid black !important;
}

#perc-finder-listview .perc-datatable-columnrow span {
  font-weight: bold;
}

#perc-finder-listview table.perc-datatable div.perc-first {
