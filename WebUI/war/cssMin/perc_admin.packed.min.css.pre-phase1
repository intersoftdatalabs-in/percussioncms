  margin-left: 6px;
  margin-top: -3px;
  width: 36px;
  height: 25px;
}

#perc-finder-search-submit:hover {
  background-position: 0 -300px;
}

.perc-page-help {
  width: 16px;
  height: 16px;
  background-position: 0 -328px;
  float: right;
  margin: 14px 14px 0 0;
  position: relative;
}

.perc-page-help:hover {
  background-position: 0 -347px;
  cursor: pointer;
}

/* Finder Misc Buttons Ends */
.box_shadow_with_padding {
  background-color: #41434f;
