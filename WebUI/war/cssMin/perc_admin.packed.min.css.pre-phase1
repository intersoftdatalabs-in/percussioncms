  padding-top: 30px;
}
.ie8 .perc-lmg-activation-panel-left {
  padding-top: 35px;
}

.perc-lmg-registration-panel {
  display: none;
  background-color: #e6e6e9;
  float: right;
  height: 100%;
  overflow: hidden;
  width: 340px;
}

.perc-lmg-activate-sprites {
  background: url(../images/images/perc-lmg-activate-sprites.png);
}

#perc-lmg-activation-dialog-activate:hover {
  background-position: 0 -30px;
  cursor: pointer;
}

.perc-lmg-activation-panel .perc-lmg-activation-hint {
  background-position: 0 -60px;
  background-repeat: no-repeat;
  font-size: 10px;
  padding: 3px 0 0 38px;
  line-height: 12px;
  width: 232px;
}

.perc-lmg-tophint {
  height: 100px;
  margin-top: 25px;
}

.perc-lmg-bottomhint {
  bottom: 96px;
  position: absolute;
}

.perc-lmg-activation-panel h1 {
  font-size: 19px;
  font-weight: normal;
  margin: 0 0 0 -17px;
  font-family: "Open Sans", sans-serif;
}

#perc-lmg-activation-form {
  margin: 9px 0 0 0;
}

#perc-lmg-edit-dialog #perc-lmg-activation-form {
  margin: 0px;
}
#perc-lmg-activation-code {
  height: 16px;
  margin: 1px 0 2px 0;
  width: 264px;
}

.perc-lmg-button {
  background-image: url(../images/images/gadgetSprites.png);
  background-repeat: no-repeat;
  cursor: pointer;
  direction: ltr;
  height: 22px;
  text-indent: -9999px;
  width: 63px;
}
.perc-lmg-activate {
  background-position: 0 0;
  background-repeat: no-repeat;
  cursor: pointer;
  direction: ltr;
  float: right;
  height: 24px;
  margin-top: 2px;
  text-indent: -9999px;
  width: 78px;
}

.perc-lmg-edit {
  background-position: 0 0;
  background-repeat: no-repeat;
  cursor: pointer;
  direction: ltr;
  float: right;
  height: 24px;
  margin-top: 2px;
  text-indent: -9999px;
  width: 78px;
}

.perc-lmg-activate:hover {
  background-position: 0 -23px;
}

.perc-lmg-edit:hover {
  background-position: 0 -23px;
}
#perc-lmg-modulelicense-type-list {
  width: 200px;
  min-width: 200px;
}
#perc-module-license-display-container {
  margin-bottom: 20px;
}

#perc-module-license-display-container .perc-lmg-modulelicense-label {
  font-weight: bold;
}
.perc-lmg-icon-status {
  background-image: url(../images/images/gadgetSprites.png);
  background-position: 400px -1px;
  background-repeat: no-repeat;
  display: inline-block;
  height: 14px;
  margin: 0 0 -3px 0;
  width: 15px;
}

.status-active {
  background-position: 0 -183px;
}

.status-warning {
  background-position: -15px -183px;
}

.status-suspended {
  background-position: -30px -183px;
}
#perc-lmg-activation-code-error {
  color: red;
  display: block;
  height: 21px;
}

#perc-in-product-registration-invalid {
  display: none;
  width: 270px;
  height: 310px;
  padding: 5px 0px 0px 35px;
}

#perc-in-product-registration-invalid a,
#perc-in-product-registration-invalid a:visited,
#perc-in-product-registration-invalid a:hover,
#perc-in-product-registration-invalid a:active {
  color: #133c55;
  cursor: pointer;
  text-decoration: none;
}

#perc-in-product-registration-invalid p {
  margin-top: 30px;
}

#perc-in-product-registration-frame {
  width: 340px;
  height: 380px;
}

.perc-overlay-div {
  height: 57px;
  left: 0;
  position: absolute;
  top: 0;
  width: 490px;
  z-index: 9000 !important;
  filter: alpha(opacity=0);
  opacity: 0;
  background-color: white;
}

.perc-lib-expander-div.perc-disable-menu-item span,
#perc-dropdown-actions-layout.perc-disable-menu-item a,
#perc-dropdown-view-layout.perc-disable-menu-item a,
