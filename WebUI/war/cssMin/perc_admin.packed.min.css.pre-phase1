/** Insert Global Variable Dialog **/
#perc-global-variables-wrapper {
  background-color: #ffffff;
  height: 100%;
  max-height: 200px;
  overflow-x: hidden;
  overflow-y: auto;
  width: 100%;
}

#perc-global-variables-table {
  width: 100%;
  border-collapse: collapse;
  border-spacing: 0;
}

#perc-global-variables-wrapper input.perc-global-variables-radio {
  float: left;
  margin: 0;
  padding: 0;
}

#perc-global-variables-wrapper table tr th {
  height: auto;
  text-align: left;
}

#perc-global-variables-wrapper table tr td {
  border: 1px solid #e6e6e9;
  height: 30px;
  padding-left: 5px;
  text-align: left;
  vertical-align: middle;
}

#perc-global-variables-wrapper span.perc-roleName-wrapper {
  display: block;
  padding-left: 5px;
  width: 270px;
}

.perc-global-variables-column-header {
  background-color: #e6e6e9;
  cursor: default;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  padding-bottom: 5px;
  padding-top: 5px;
  text-align: left;
}

.perc-global-variables-column {
  background-color: #ffffff;
  color: #000000;
  font-family: "Open Sans", sans-serif;
  font-size: 11px;
  height: 20px;
  text-align: left;
}

.perc-global-variable-selected {
  background-color: #caf589 !important;
}

#perc-insert-global-variables-dialog {
  padding: 0 7px;
}

