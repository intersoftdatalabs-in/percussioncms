  padding-bottom: 5px;
  height: 100%;
  text-align: left;
}

#perc-comment-table-wrapper td.perc-comment {
  vertical-align: top;
  color: black;
}

.perc-read-more,
.perc-read-less {
  color: #133c55;
  cursor: pointer;
  padding-right: 15px;
}

.perc-read-more {
  background: url("../images/images/dropdownArrow.gif") no-repeat scroll right
    center transparent;
}

.perc-read-less {
  background: url("../images/images/upArrow.png") no-repeat scroll right center
    transparent;
}

.perc-more-less.perc-show-less,
.perc-read-less {
  display: none;
}

#perc-comment-table-wrapper {
  background: none repeat scroll 0 0 #f7f7f8;
  height: 600px;
  margin-right: 24px;
  padding: 10px;
}

#perc-comment-table-wrapper .perc-datatable tbody td .perc-first {
  color: black;
}

.perc-lmg-panels-container {
  height: 380px;
  width: 686px;
}

.perc-lmg-edit-panels-container {
  margin-top: -5px;
}

#perc-lmg-activation-dialog .ui-dialog-content {
  background-color: white;
  height: 390px !important;
  padding: 0;
  overflow: hidden;
  width: 686px !important;
}

.perc-lmg-activation-panel {
  background-color: #e6e6e9;
  border: none;
  float: left;
  height: 100%;
  margin: 0;
  padding: 0;
  position: relative;
  width: 270px;
  padding: 35px;
}

.perc-lmg-edit-activation-panel {
  background-color: #e6e6e9;
  border: none;
  height: 100%;
  margin: 0;
  padding: 0;
  position: relative;
}

.perc-lmg-activation-panel-left {
  margin-left: 6px;
  padding-left: 0px;
