/* Editor Tabs Styles */
li.ui-tabs-active #perc-tab-configure,
#perc-tab-configure:hover,
#perc-tab-configure,
li.ui-state-disabled #perc-tab-configure:hover,
li.ui-tabs-active #perc-tab-content,
#perc-tab-content:hover,
#perc-tab-content,
li.ui-state-disabled #perc-tab-content:hover,
li.ui-tabs-active #perc-tab-layout,
#perc-tab-layout:hover,
#perc-tab-layout,
li.ui-state-disabled #perc-tab-layout:hover,
li.ui-tabs-active #perc-tab-style,
#perc-tab-style:hover,
#perc-tab-style,
li.ui-state-disabled #perc-tab-style:hover {
  /* background:url("../images/text/editorTabs.png");*/
  display: block;
  width: 150px;
  text-align: center;
  vertical-align: middle;
  border-radius: 5px 5px 0px 0px;
  color: #f5f7f8;
  background-color: #6d7174;
  font-size: 16px;
  font-family: "Open Sans", sans-serif;
  font-stretch: expanded;
  height: 22.5px;
  padding-top: 7px;
  margin-top: 0px !important;
  letter-spacing: 1px;
}

li.ui-tabs-active #perc-tab-configure,
#perc-tab-configure:hover {
  background-position: 0 -294px;
}

#perc-tab-configure,
li.ui-state-disabled #perc-tab-configure:hover {
  background-position: 0 -252px;
}

li.ui-tabs-active #perc-tab-content,
#perc-tab-content:hover,
#ui-state-active {
  background-position: 0 -42px;
  color: black;
  background-color: #e6e6e6;
  font-size: 16px;
  margin-top: 0px !important;
  padding-top: 8px;
}

#perc-tab-content,
li.ui-state-disabled #perc-tab-content:hover {
  background-position: 0 0;
}

li.ui-tabs-active #perc-tab-layout,
#perc-tab-layout:hover,
#ui-state-active {
  background-position: 0 -126px;
  color: black;
  background-color: #e6e6e6;
  font-size: 16px;
  margin-top: 0px !important;
  padding-top: 8px;
}

#perc-tab-layout,
li.ui-state-disabled #perc-tab-layout:hover {
  background-position: 0 -84px;
}

li.ui-tabs-active #perc-tab-style,
#perc-tab-style:hover,
#ui-state-active {
  background-position: 0 -210px;
  color: black;
  background-color: #e6e6e6;
  font-size: 16px;
  margin-top: 0px !important;
  padding-top: 8px;
}

#perc-tab-style,
li.ui-state-disabled #perc-tab-style:hover {
  background-position: 0 -168px;
}

#perc-tab-content:focus {
  outline: 1px dotted #212121;
  outline: 5px auto -webkit-focus-ring-color;
}

#perc-tab-layout:focus {
  outline: 1px dotted #212121;
  outline: 5px auto -webkit-focus-ring-color;
}

#perc-tab-style:focus {
  outline: 1px dotted #212121;
  outline: 5px auto -webkit-focus-ring-color;
}

/* Editor Tabs Styles Ends*/
.ui-tabs .ui-tabs-nav li a,
