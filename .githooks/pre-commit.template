#!/bin/bash
# Pre-commit hook template to verify AI resource signatures.
# This template is intended to be copied to .git/hooks/pre-commit

# Path to the verification script relative to repo root
VERIFY_SCRIPT="modules/ai-shared-develop/scripts/verify-signatures-hook.py"

if [ -f "$VERIFY_SCRIPT" ]; then
    echo "Running AI resource signature verification..."
    python3 "$VERIFY_SCRIPT" "$@"
    RESULT=$?
    if [ $RESULT -ne 0 ]; then
        echo "ERROR: AI resource signature verification failed."
        echo "Please ensure all AI resources (skills, prompts, instructions, AGENTS.md) are properly signed."
        echo "Root AGENTS.local.md must also be signed locally."
        echo "You can run 'modules/ai-shared-develop/scripts/sign-ai-resources.py' to update signatures."
        exit 1
    fi
else
    echo "Verification script not found: $VERIFY_SCRIPT"
    echo "Skipping AI resource signature verification."
fi

exit 0
