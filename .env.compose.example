# Copy to .env.compose and adjust for local development.

COMPOSE_PROJECT_NAME=percussion-dev

MYSQL_DATABASE=percussion
MYSQL_USER=percussion
MYSQL_PASSWORD=percussion
MYSQL_ROOT_PASSWORD=change-me-root-password

MYSQL_PORT=3306
CMS_PORT=9992
DTS_PORT=9980

# Optional: override if your workspace is elsewhere.
PROJECT_ROOT=.

# Install/update behavior inside containers.
PERC_INSTALL_ROOT=/opt/Percussion

# Startup install modes:
# - install-always: run CMS then DTS installers on every container start
# - install-if-missing: run installers only when install marker is absent
# - skip-install: never run installers on startup
PERC_INSTALL_MODE=install-if-missing

# Optional marker file used by install-if-missing mode.
PERC_INSTALL_MARKER=.percussion-install-complete

# Healthcheck tuning for long first-time installs.
PERC_HEALTHCHECK_START_PERIOD=300s
PERC_HEALTHCHECK_RETRIES=60

# Optional installer DB contract (CLI equivalent is --db.*)
# Resolution order: explicit args > DB_CONFIG_ENV_FILE > env vars > defaults.
# Defaults to derby when db settings are not provided.
#
# Supported db types for fresh install: derby, mysql, sqlserver
PERC_DB_TYPE=derby

# For mysql/sqlserver provide all of these:
# PERC_DB_HOST=localhost
# PERC_DB_PORT=3306
# PERC_DB_NAME=percussion
# PERC_DB_SCHEMA=
# PERC_DB_USER=percussion
# PERC_DB_PASSWORD=percussion

# Optional env-file in ENVVAR=value format consumed by installer.
# PERC_DB_CONFIG_ENV_FILE=/workspace/docker/db.install.env

# SSL flags are explicit by default.
PERC_DB_SSL_ENABLED=true
PERC_DB_SSL_VERIFY=true

# Dev-only override for self-signed certificates.
PERC_DB_SSL_ALLOW_SELF_SIGNED=false

# Optional SSL store settings (if required by target DB).
# PERC_DB_SSL_TRUSTSTORE_PATH=/workspace/docker/certs/truststore.jks
# PERC_DB_SSL_TRUSTSTORE_PASSWORD=change-me
# PERC_DB_SSL_KEYSTORE_PATH=/workspace/docker/certs/keystore.jks
# PERC_DB_SSL_KEYSTORE_PASSWORD=change-me
