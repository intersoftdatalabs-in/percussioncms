# Copy to .env.compose and adjust for local development.
# .env.compose is gitignored — never commit real passwords.
#
# These values are LOCAL DEV ONLY placeholders. Change them before first run.
# SQL Server requires complexity (upper, lower, digit, symbol).

COMPOSE_PROJECT_NAME=percussion-dev

# --- MySQL (compose profile: mysql) ---
MYSQL_DATABASE=percdb
MYSQL_USER=percuser
MYSQL_PASSWORD=LocalDev_ChangeMe_1a!
MYSQL_ROOT_PASSWORD=LocalDev_Root_ChangeMe_1a!
MYSQL_PORT=3306

# --- PostgreSQL (compose profile: postgres) ---
POSTGRES_DB=percdb
POSTGRES_USER=percuser
POSTGRES_PASSWORD=LocalDev_ChangeMe_1a!
POSTGRES_PORT=5433

# --- SQL Server (compose profile: sqlserver) ---
MSSQL_SA_PASSWORD=LocalDev_ChangeMe_1a!
MSSQL_PORT=1433

# --- Oracle XE (compose profile: oracle / db-all) — matrix Layer-1 (#1508) ---
# Image: gvenzl/oracle-xe:21-slim (see docker/README.md). Heavy; opt-in only.
# ORACLE_PASSWORD = SYS/SYSTEM (image bootstrap). CMS uses APP_USER credentials.
# Service name for --db.name defaults to XEPDB1 (pluggable DB in Oracle XE 21).
ORACLE_PASSWORD=LocalDev_ChangeMe_1a!
ORACLE_APP_USER=percuser
ORACLE_APP_PASSWORD=LocalDev_ChangeMe_1a!
ORACLE_SERVICE=XEPDB1
ORACLE_PORT=1521
# Optional schema override (defaults to APP_USER / percuser in harness).
# ORACLE_SCHEMA=percuser

CMS_PORT=9992
DTS_PORT=9980

# Optional: override if your workspace is elsewhere.
PROJECT_ROOT=.

# Install runs ONCE on the host (scripts/install-cms-dev.py) into a
# persistent install_root/ directory that the container bind-mounts at
# /opt/Percussion/. The container entrypoint is service-only; it does
# NOT reinstall on container start. Hot-deploys are file edits in
# install_root/ on the host (see scripts/README.md).
#
# PERC_INSTALL_ROOT/PERC_INSTALL_MODE/PERC_INSTALL_MARKER are kept for
# backwards compatibility with perc-devctl.py; install-update.py
# ignores them in service-only mode.

# Healthcheck tuning for the cms-dts container. With the install moved
# out of the container, Jetty starts in < 30 s, so the default 30 s
# start_period + 60 retries (~ 20 min total) is plenty of room.
PERC_HEALTHCHECK_START_PERIOD=30s
PERC_HEALTHCHECK_RETRIES=60

# MySQL config consumed by the host-side installer (scripts/install-cms-dev.py).
# PERC_DB_HOST is `localhost` because the installer runs on the host and
# reaches MySQL via the published port (3306). The cms-dts container
# talks to MySQL via the compose service name (`mysql`) — but it
# doesn't run the installer anymore, so PERC_DB_* isn't propagated
# into the container (see docker-compose.yml).
#
# Defaults to derby if no DB settings are provided.
PERC_DB_TYPE=derby

# For mysql/sqlserver provide all of these (align with MYSQL_* / MSSQL_* above):
PERC_DB_HOST=localhost
PERC_DB_PORT=3306
PERC_DB_NAME=percdb
PERC_DB_SCHEMA=
PERC_DB_USER=percuser
PERC_DB_PASSWORD=LocalDev_ChangeMe_1a!

# Optional env-file in ENVVAR=value format consumed by installer.
# PERC_DB_CONFIG_ENV_FILE=/workspace/docker/db.install.env

# SSL flags are explicit by default.
PERC_DB_SSL_ENABLED=true
PERC_DB_SSL_VERIFY=true

# Dev-only override for self-signed certificates.
PERC_DB_SSL_ALLOW_SELF_SIGNED=false

# Optional SSL store settings (if required by target DB).
# PERC_DB_SSL_TRUSTSTORE_PATH=/workspace/docker/certs/truststore.jks
# PERC_DB_SSL_TRUSTSTORE_PASSWORD=change-me
# PERC_DB_SSL_KEYSTORE_PATH=/workspace/docker/certs/keystore.jks
# PERC_DB_SSL_KEYSTORE_PASSWORD=change-me