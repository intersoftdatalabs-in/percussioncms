# --- Speckit (.specify): track project config; ignore regenerable cache only ---
.specify/extensions/.cache/
.specify/feature.json
.specify/auth.json
.specify/memory/context_cache/

# --- Python (spec 994-python-build-scripts) ---
# Bytecode + tool caches produced by python3 -m py_compile and pytest.
# Repo-wide: pycache should never be checked in anywhere.
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/

# --- Kilo Code (.kilo): track Speckit workflows + package manifests ---
# Keep memory-bank local (high-churn / stale-risk vs AGENTS.md + constitution)
.kilocode/
.kilo/worktrees/
.kilo/agent-manager.json
.kilo/node_modules/
.kilo/*.lock
.kilo/*.local.jsonc
.kilo/kilo.jsonc
.kilo/package.json
.kilo/rules/memory-bank/
.kilo/rules/memory-bank-instructions.md

