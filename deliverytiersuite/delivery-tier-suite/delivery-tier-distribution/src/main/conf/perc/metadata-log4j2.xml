<?xml version="1.0" encoding="UTF-8"?>


<Configuration status="error" name="metadata">
  <Appenders>
    <RollingRandomAccessFile name="RollingRandomAccessFile" fileName="${sys:catalina.base}/logs/metadata.log"
                 filePattern="logs/$${date:yyyy-MM}/metadata-%d{MM-dd-yyyy}-%i.log.gz">
      <PatternLayout>
        <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [Thread: %t] %level [%c][%M] - %msg%n</Pattern>
      </PatternLayout>
      <Policies>
        <SizeBasedTriggeringPolicy size="10 MB"/>
      </Policies>
    </RollingRandomAccessFile>
  </Appenders>
  <Loggers>
    <Root level="error" includeLocation="true" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
    </Root>
 	<Logger name="com.percussion.delivery.metadata" level="info" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
     </Logger>

    <!-- Silence known-noisy warnings from Log4j JUL bridge during startup.
         The "Ignoring call to `j.u.l.Logger.setUseParentHandlers(true)`" messages come from the
         log4j-jul bridge when libraries touch java.util.logging. A companion
         log4j2.component.properties (with log4j2.statusLoggerLevel=ERROR) is also deployed
         with the webapp to suppress StatusLogger noise as early as possible. -->
    <Logger name="org.apache.logging.log4j.jul" level="error" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
    </Logger>

    <!-- Uncomment for MSSQL Driver Debugging
    <Logger name="com.microsoft.sqlserver.jdbc" level="SEVERE" additivity="true">
      <AppenderRef ref="RollingRandomAccessFile"/>
    </Logger>
    -->
     <!-- 
     <Logger name="com.percussion.delivery.metadata.impl.PSMetadataRestService" level="info" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
     </Logger>
	 
	 <Logger name="com.percussion.delivery.metadata.impl.PSMetadataRestService" level="debug" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
     </Logger>
	 
	 <Logger name="com.percussion.delivery.metadata.impl.PSMetadataRestService" level="error" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
     </Logger>
	 
	 <Logger name="com.percussion.delivery.metadata.impl.PSMetadataRestService" level="warn" additivity="false">
      <AppenderRef ref="RollingRandomAccessFile"/>
     </Logger>
     -->
  </Loggers>
</Configuration>
