<?xml version="1.0" encoding="UTF-8"?>
<project name="Percussion OpenAPI Generator Maven Plugin"
         xmlns="http://maven.apache.org/DECORATION/1.8.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/DECORATION/1.8.0
                             http://maven.apache.org/xsd/decoration-1.8.0.xsd">

    <description>Maven plugin to generate OpenAPI specification from JAX-RS annotations</description>

    <skin>
        <groupId>org.apache.maven.skins</groupId>
        <artifactId>maven-fluido-skin</artifactId>
        <version>2.0.0</version>
    </skin>

    <custom>
        <fluidoSkin>
            <navbar>
                <brand>
                    <name>Percussion OpenAPI Generator</name>
                    <href>index.html</href>
                </brand>
                <tagline>Build-time OpenAPI specification generation from JAX-RS annotations</tagline>
            </navbar>
            <sourceLineNumbersEnabled>true</sourceLineNumbersEnabled>
        </fluidoSkin>
    </custom>

    <body>
        <menu name="Overview">
            <item name="Introduction" href="index.html"/>
            <item name="Plugin Goals" href="plugin-info.html"/>
        </menu>

        <menu name="Documentation">
            <item name="Usage" href="usage.html"/>
            <item name="Configuration" href="configuration.html"/>
            <item name="Architecture" href="architecture.html"/>
        </menu>

        <menu name="Reports">
            <item name="Javadoc" href="apidocs/index.html"/>
            <item name="Project Info" href="project-info.html"/>
            <item name="Dependencies" href="dependencies.html"/>
            <item name="Plugin Management" href="plugin-management.html"/>
        </menu>

        <menu name="Development">
            <item name="Contributing" href="contributing.html"/>
            <item name="Source Repository" href="scm.html"/>
        </menu>

        <footer>
            <div class="row span12">
                <p>
                    Percussion OpenAPI Generator Plugin is part of the Percussion CMS project.
                    See <a href="https://percussioncms.com">percussioncms.com</a> for more information.
                </p>
            </div>
        </footer>
    </body>
</project>
