    "title": "Blog Post",
    "category": "blog",
    "description": "Blog Post for your site",
    "thumbnail": "resources/WidgetIconBlog.png",
    "icon": "resources/WidgetIconBlog.png",
    "author": "Percussion Software Inc",
    "preferredEditorWidth": 780,
    "preferredEditorHeight": 723,
    "responsive": true,
    "paletteVisible": true
