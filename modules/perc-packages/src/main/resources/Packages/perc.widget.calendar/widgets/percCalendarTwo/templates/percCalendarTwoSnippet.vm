      /* v6 toggle compat (slice 1, #6919): the Calendar/List toggle buttons
      reuse the 2.x theme classes (.fc-state-default/.fc-corner-*) outside
      the calendar root, which v6 never styles — carry the 2.x default look
      here so the toggles keep their shape. */
      .perc-toggle-button-container .fc-button.fc-state-default {
        background-color: #f5f5f5;
        background-image: linear-gradient(to bottom, #ffffff, #e6e6e6);
        border: 1px solid #cccccc;
        color: #333333;
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.75);
      }
      .perc-toggle-button-container .fc-button.fc-corner-left {
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
      }
      .perc-toggle-button-container .fc-button.fc-corner-right {
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
      }

      .perc-full-calendar {

        margin: 0 auto;
