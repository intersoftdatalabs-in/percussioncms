	  <script>
      ## Source-filter keyboard path (#6992, residual of #6945): the
      ## filter controls below are native <button> elements, so Tab /
      ## Enter / Space work without extra key handling and the pressed
      ## state is perceivable via aria-pressed. hideCalendarSource is a
      ## global (not closure-scoped) so both the delegated listener and
      ## any direct call resolve it. Layer toggling skips the <button>
      ## controls themselves — they share the layer class for color but
      ## must stay visible/operable so focus is never dropped.
      function hideCalendarSource(calendarClass) {
        var button = document.getElementById(calendarClass + '-button');
        var nowOff = false;
        if (button) {
          nowOff = button.classList.toggle('perc-disabled-calendar-button');
          button.setAttribute('aria-pressed', nowOff ? 'false' : 'true');
        }
        var layers = document.querySelectorAll('.' + calendarClass);
        for (var i = 0; i < layers.length; i++) {
          if (layers[i].tagName !== 'BUTTON') {
            layers[i].classList.toggle('perc-hide-calendar');
          }
        }
        return nowOff;
      }
      window.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('[data-calendar-source]');
        for (var i = 0; i < filters.length; i++) {
          filters[i].addEventListener('click', function() {
            hideCalendarSource(this.getAttribute('data-calendar-source'));
          });
        }
      });
      </script>

