      <link rel="stylesheet" href="$resourcePrefix/web_resources/widgets/calendarTwo/css/fullcalendar.print.css" type="text/css" media="print" />
      <style>
      @media only screen
      and (max-width: 480px)
      {
        /* v6 retarget (slice 1, #6919): the v6 toolbar is a flex row of
        three unstyled .fc-toolbar-chunk divs — the 2.x .fc-left/.fc-center/
