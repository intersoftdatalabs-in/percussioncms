        color: white;
        padding: 9px 10px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 12px;
        /* Native <button> elements do not inherit the page font from the
        div-based controls they replace (source-filter a11y, #6992) —
        pin the surrounding type so the swap is visually identical. */
        font-family: inherit;
        cursor: pointer;
        margin: 0px;
        margin-top: 5px;
        -moz-user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -o-user-select: none;
      }

      /* Source-filter a11y (#6992): keyboard-only indicator for the
