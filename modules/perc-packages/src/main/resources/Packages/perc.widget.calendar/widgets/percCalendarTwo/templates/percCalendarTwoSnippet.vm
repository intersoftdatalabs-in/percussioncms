      <script>
      window.addEventListener('DOMContentLoaded', function() {
      /**
      * v6 note (slice 1, issue #6919, plan #6687): the calendarTwo payload
      * is now the stock FullCalendar v6.1.15 global bundle — no fork mods
      * (WidgetPayloadVendoredJsAuditTest + widgetPayloadNpmParity.test.js
      * pin byte-identity with the npm dists). The two Percussion behaviors
      * the 2.x payload carried are re-derived in this template: (1) the
      * per-widget Perc.events deferred is resolved inside the v6 events
      * function (and by the list-view direct fetch) instead of the old
      * reportEvents payload hunk; (2) the Perc.range month-expansion is
      * replaced by an explicit 52-week fetch window for list layout (v6
      * dayGridMonth always renders a fixed 6 weeks) instead of the old
      * computeRange payload hunk. Perc.range is still assigned for
      * compatibility but no longer steers fetching. Refreshing the payload
      * to a future stock v6 dist needs no manual mod re-application.
      **/

## v6 view mapping (slice 1, #6919): 2.x 'month' -> v6 'dayGridMonth';
## 'agendaWeek'/'agendaDay' -> 'timeGridWeek'/'timeGridDay'; 'basicWeek'/
## 'basicDay' -> 'dayGridWeek'/'dayGridDay' (basic hides times, see
## displayEventTime below).
#set($v6WeekView = 'timeGridWeek')
#set($v6DayView = 'timeGridDay')
#if($perc_calendar_detail == 'basic')
#set($v6WeekView = 'dayGridWeek')
#set($v6DayView = 'dayGridDay')
#end
#set($v6initialView = 'dayGridMonth')
#if($perc_calendar_type == 'Week')
#set($v6initialView = $v6WeekView)
#elseif($perc_calendar_type == 'Day')
#set($v6initialView = $v6DayView)
#end
	$(function(){

        $('#perc-event-list-${calendarContentId}-${widgetId}').hide();

        // These variables are for event list functionality
        if(!window.Perc) {
            window.Perc = {};
        }
        if(!Perc.events) {
            Perc.events = {};
        }
        // Retained for compatibility (the 2.x computeRange payload mod is
        // gone; list layout now fetches an explicit 52-week window below).
#if($perc_layout_type == 'list')##
        Perc.range = 52;
#else##
        Perc.range = 6;
#end##
        Perc.events['calendar-${calendarContentId}-${widgetId}'] = jQuery.Deferred();
        var maxResults = $perc_max_results;
        var layoutType = '$perc_layout_type';
        var percShowCalIcon = '$perc_enable_calendar_icon';
        var percShowEventDate = '$perc_show_event_date';
        var percShowEventTime = '$perc_show_event_time';
        var percCalendarTarget = 'calendar-${calendarContentId}-${widgetId}';
        var percCalendarInstance = null;

        if( layoutType == 'list' ) {
          percInitListView();
        } else {
          initializeCalendar();
        }

        if( layoutType == 'calendar' ) {
          $('#perc-button-container-${calendarContentId}-${widgetId}').show();
        }

        // Formats a native Date as YYYY-MM-DD for the DTS dated query.
        // (v6 fetchInfo.start/end are native Dates; the 2.x snippet read the
        // moment internals via start._d.)
        function percFormatDtsDate(d) {
          var month = (d.getMonth() + 1) < 10 ? '0' + (d.getMonth() + 1) : '' + (d.getMonth() + 1);
          var day = d.getDate() < 10 ? '0' + d.getDate() : '' + d.getDate();
          return d.getFullYear() + '-' + month + '-' + day;
        }

        // Shared DTS fetch behind both the month events function and the
        // list-view direct fetch: two metadata calls (the backend has no OR
        // operator) whose event arrays concatenate, mirroring the 2.x
        // snippet. Returns a jQuery promise for the combined event array.
        // Events pass through untouched (v6 maps unknown fields such as
        // summary into extendedProps); date normalization for rendering
        // happens in percNormalizeEvent below.
        function percFetchDtsEvents(startValue, endValue) {
          var serviceUrl = "/perc-metadata-services/metadata/dated/get";
          /*
            * get the results from delivery tier service and return
            * below we are looking to restrict the amount of information
            * pulled back from the DTS.  The dates are found and used to
            * restrict to the current selected month in the calendar.
            */
          var dataObj = {"criteria":["type = 'page'", "perc:calendar = '$calName'", "perc:start_date >= '" + startValue + "'","perc:start_date <= '" + endValue + "'"]}
          // here the last value condition perc:start_Date < is present to prevent duplicate events from populating between first call and second
          var dataObj2 = {"criteria":["type = 'page'", "perc:calendar = '$calName'", "perc:end_date >= '" + startValue + "'", "perc:start_date < '" + startValue + "'"]}
          /*
            * Here we make two calls to the metadata service as a workaround as the backend currently doesn't support OR operations.
            * @param endOfCall here the function is called twice, when endOfCall is true the combined events resolve the outer promise
            * @param firstEvents passes the results from the first metadata call to the second call.
            */
          var makeApiCall = function(dataObj, endOfCall, firstEvents) {
            var deferred = jQuery.Deferred();
            jQuery.PercServiceUtils.makeXdmJsonRequest(null,serviceUrl,jQuery.PercServiceUtils.TYPE_POST,function(status, results)
            {
              if(status == jQuery.PercServiceUtils.STATUS_SUCCESS) {
                if(endOfCall){
                  if(typeof(firstEvents) === "undefined"){
                    firstEvents = [];
                  }
                  deferred.resolve(firstEvents.concat(jQuery.PercServiceUtils.toJSON(results.data).events));
                }
                else
                  deferred.resolve(jQuery.PercServiceUtils.toJSON(results.data).events);
              }
              else {
                deferred.resolve([]);
              }
            }, dataObj);
            return deferred.promise();
          }
          var combined = jQuery.Deferred();
          jQuery.when( makeApiCall(dataObj, false, []) ).then(function(events) {
            jQuery.when( makeApiCall(dataObj2, true, events) ).then(function(allEvents) {
              combined.resolve(allEvents);
            });
          });
          return combined.promise();
        }

        // Normalizes one raw event for the v6 pipeline: moment parses the
        // same date shapes the 2.x build accepted, and native Dates keep the
        // list renderer (moment(event.start)) working. Unknown fields ride
        // along untouched into v6 extendedProps (summary, url, ...).
        function percNormalizeEvent(event) {
          var copy = jQuery.extend({}, event);
          copy.start = moment(event.start).toDate();
          if(event.end) {
            copy.end = moment(event.end).toDate();
          }
          return copy;
        }

        // Resolves the per-widget Perc.events deferred consumed by the
        // list-view renderer (re-derived from the 2.x reportEvents payload
        // mod, which cannot ship in a stock v6 dist).
        function percResolveWidgetEvents(events) {
          Perc.events[percCalendarTarget].resolve(events);
        }

        function initializeCalendar() {

        var calendarEl = document.getElementById(percCalendarTarget);
        var calendarOptions = {

            #if($perc_time_format == 'hh:mmt')
            eventTimeFormat: { hour: 'numeric', minute: '2-digit', hour12: true },
            #else
            eventTimeFormat: { hour: 'numeric', minute: '2-digit', hour12: false },
            #end
            #if($perc_calendar_detail == 'basic' && $perc_calendar_type != 'month')
            displayEventTime: false,
            #end
            #if($perc_show_page_summary)
            eventDataTransform: function(eventData) {
              eventData.allDay = false;
              return eventData;
            },
            #end
            #if($calStartDate != "")
            initialDate: '$calStartDate',
            #end
            locale: '${perc_calendar_display_language}',
            firstDay: $perc_start_day_number,
            initialView: '$v6initialView',
            headerToolbar: {
                left: 'title',
                center: 'prev,next today',
                right: 'dayGridMonth,${v6WeekView},${v6DayView}'
            },

            eventSources: [
            ## gcal keep decision (slice 2, #6945; #6804 slice-3b remnant):
            ## KEEP. The shipped gcal.js is the stock v6 google-calendar
            ## plugin, which loads feeds with CORS fetch() against
            ## https://www.googleapis.com/calendar/v3/calendars — the 2.x
            ## JSONP script-injection path is gone with the 2.9.1 payload.
            ## Under a restrictive site CSP this needs
            ## connect-src https://www.googleapis.com. A source without an
            ## API key fails gracefully (errorCallback, no crash — pinned by
            ## calendarTwoGcalKeepDecision.test.js).
            #if($googleSourceCount > 0)
            #foreach($googleSource in $googleCalendarArray)
                {
                    googleCalendarApiKey: '${googleSource.getString("apiKey")}',
                    googleCalendarId: '${googleSource.getString("calendarId")}',
                    className: 'perc-${googleSource.getString("className")}'
                }#if($velocityCount <= $googleSourceCount),#end
            #end
            #end

                {
                    events: function(fetchInfo, successCallback, failureCallback)
          {
              #if($perc.isEditMode() || $perc.isPreviewMode())
                  var previewEvents = $pagesInCal;
                  percResolveWidgetEvents(previewEvents);
                  successCallback(previewEvents);
              #else
                  var startValue = percFormatDtsDate(fetchInfo.start);
                  var endValue = percFormatDtsDate(fetchInfo.end);
                  jQuery.when( percFetchDtsEvents(startValue, endValue) ).then(
                    function(allEvents) {
                      var normalized = jQuery.map(allEvents, percNormalizeEvent);
                      percResolveWidgetEvents(allEvents);
                      successCallback(normalized);
                    },
                    function() {
                      percResolveWidgetEvents([]);
                      successCallback([]);
                    });
              #end
          },
        className: 'perc-calendar-other',

        }
            ],
            editable: false,

      dateClick: function(info) {
      if(typeof(percCalenderDayClick) === typeof(Function)){
      // if you need to bind to the dayClick even, define a function with a definition that
      // looks like function percCalenderDayClick(div_id, object,date,allDay,jsEvent,view)
      percCalenderDayClick("#calendar-${calendarContentId}-${widgetId}",jQuery(info.dayEl),info.date,info.allDay,info.jsEvent,info.view);
      }
      },
      eventDidMount: function(info) {
      #if($perc_show_page_summary)
      var summary = info.event.extendedProps ? info.event.extendedProps.summary : null;
      if(summary !== '' && summary != null && typeof summary !== 'undefined') {
      jQuery(info.el).qtip({
      content: { text: summary },
      position: {
      my: 'bottom center',
      at: 'top center'
      },
      style: {
      classes: 'qtip-light',
      tip: { corner: true }
      }
      });
      }
      #end
      }

          };

          percCalendarInstance = new FullCalendar.Calendar(calendarEl, calendarOptions);
          percCalendarInstance.render();

      } //end initialize calendar

      // List layout renders without a visible calendar instance (v6
      // dayGridMonth has no 52-week mode): the snippet fetches an explicit
      // 52-week window directly through the shared DTS routine, re-deriving
      // the Perc.range = 52 expansion the 2.x computeRange payload mod
      // provided. Slice 2 (#6919/2) adds a loading row while the DTS fetch
      // is in flight (cleared by percProcessEventList) so the list region
      // is never a blank hole, and switches with show()/hide() instead of
      // fadeIn() for deterministic screenshot-diff captures.
      function percInitListView() {
        $('#calendar-${calendarContentId}-${widgetId}').hide();
        $('.perc-mini-calendar').hide();
        var percEventList = $('#perc-event-list-${calendarContentId}-${widgetId}');
        percEventList.show();
        percEventList.find('ul').empty().append(
          '<li class="perc-event-list-element perc-event-list-loading">Loading events&#8230;</li>'
        );
        #if($perc.isEditMode() || $perc.isPreviewMode())
        var listEvents = $pagesInCal;
        percResolveWidgetEvents(listEvents);
        percProcessEventList(listEvents, maxResults);
        #else
        var listStart = new Date();
        listStart.setDate(1);
        listStart.setHours(0, 0, 0, 0);
        var listEnd = new Date(listStart.getTime());
        listEnd.setDate(listEnd.getDate() + 364);
        jQuery.when( percFetchDtsEvents(percFormatDtsDate(listStart), percFormatDtsDate(listEnd)) ).then(
          function(resolvedEvents) {
            percResolveWidgetEvents(resolvedEvents);
            percProcessEventList(resolvedEvents, maxResults);
          },
          function(err) { console.log('error processing event list', err); percProcessEventList([], maxResults); }
        );
        #end
      }

      // This method hides the calendar view, shows the list view, and populates the target with the event list
        function percProcessEventList(eventObject, maxResults) {

            var percTargetEventList = $('#perc-event-list-${calendarContentId}-${widgetId}');
            percTargetEventList.show();

            // Drop the loading row (percInitListView) before populating; an
            // empty result set falls through to the empty state below.
            percTargetEventList.find('ul').empty();

            //  fullcalendar does not presort the event dates
            eventObject.sort(function(x, y){
                return new Date(x.start) - new Date(y.start);
			});

            percCurrentDate = new Date();

            //  indentifies the template to clone (the list target was
            //  resolved and cleared above, dropping the loading row).
            var percEventStructureListRoot = $('#perc-event-list-template-${calendarContentId}-${widgetId} ul li');
            var percEventListElem = percEventStructureListRoot.clone();
            var eventCount = 0;
            var eventIterator = 0;

            // Count the total number of possible events to show so later on we can determine if we are on the last event
            jQuery.each(eventObject, function( index, event ){
                if( !(moment(event.start).isBefore(percCurrentDate, 'day')) ) {
                    eventCount++;
                }
      });

            jQuery.each(eventObject, function( index, event ){

                //  we only want to show the events in list view that are today's date or later, and no more
                //  events than the designated maxResults
                if ( !(moment(event.start).isBefore(percCurrentDate, 'day')) && eventIterator < maxResults ) {

                    percNewEventListElem = percEventListElem.clone();

                    if ( eventIterator == 0 ) {
                        percNewEventListElem.addClass('perc-list-first');
                    }

                    if ( eventIterator == eventCount || (eventIterator + 1) == maxResults ) {
                        percNewEventListElem.addClass('perc-list-last');
                    }

                    // Check if we are an odd or even value, but remember that eventIterator is starting at zero
                    if( (eventIterator+1) % 2 == 0) {
                        percNewEventListElem.addClass('perc-list-even');
                    }
                    else {
                        percNewEventListElem.addClass('perc-list-odd');
                    }

                    if(!(event.url)) {
                            percNewEventListElem.find('a').removeAttr("href");
                    }
                    else {
                        percNewEventListElem.find('a').attr('href', event.url);
                    }

                    if( percShowCalIcon == 'false' ) {
                        percNewEventListElem.find('.perc-cal-icon').remove();
                    }
            if( percShowEventDate == 'false' ) {
                        percNewEventListElem.find('.perc-event-date').remove();
                    }
            if( percShowEventTime == 'false' ) {
              percNewEventListElem.find('.perc-event-time').remove();
            }

            percNewEventListElem.find('.perc-event-date').text(moment(event.start).format("${eventDateFormat}"));
                    percNewEventListElem.find('.perc-month-mmm').text(moment(event.start).format("MMM").toUpperCase());
                    percNewEventListElem.find('.perc-date-dd').text(moment(event.start).format("D"));
                    percNewEventListElem.find('.perc-event-time').text(moment(event.start).format("${eventTimeFormat}"));
            if(event.end) {
              percNewEventListElem.find('.perc-event-time').append(' - ' + moment(event.end).format("${eventTimeFormat}"));
            }
                    percNewEventListElem.find('.perc-event-title-link').text(event.title);

                    // Populates the target container with the event item
                    $('#perc-event-list-${calendarContentId}-${widgetId} ul').append(percNewEventListElem);

                    eventIterator++;

                }   // end if event is before today's date and does not exceed max results

            }); // end each eventObject

            // Empty state: an explicit row instead of a blank region when
            // no event survives the today-or-later + maxResults filter
            // (mirrors the loading row rendered by percInitListView).
            if (eventIterator == 0) {
                percTargetEventList.find('ul').append(
                    '<li class="perc-event-list-element perc-event-list-first perc-event-list-last perc-event-list-empty">No upcoming events.</li>'
                );
            }

        }   // end function percProcessEventList


      $('#showCalendarButton-${calendarContentId}-${widgetId}').on("click", function() {
        $('#perc-event-list-${calendarContentId}-${widgetId}').hide();
        Perc.range = 6;
        if (percCalendarInstance) {
          percCalendarInstance.destroy();
          percCalendarInstance = null;
        }
        $('#calendar-${calendarContentId}-${widgetId}').show();
        initializeCalendar();
        $('#perc-button-container-${calendarContentId}-${widgetId}').show();
        $('#showCalendarButton-${calendarContentId}-${widgetId}').attr('aria-pressed', 'true');
        $('#showListButton-${calendarContentId}-${widgetId}').attr('aria-pressed', 'false');
      });
      $('#showListButton-${calendarContentId}-${widgetId}').on("click",function() {
        $('#perc-button-container-${calendarContentId}-${widgetId}').hide();
        if (percCalendarInstance) {
          percCalendarInstance.destroy();
          percCalendarInstance = null;
        }
        Perc.events['calendar-${calendarContentId}-${widgetId}'] = jQuery.Deferred();
        Perc.range = 52;
        $('#perc-event-list-${calendarContentId}-${widgetId} ul').empty();
        percInitListView();
        $('#showCalendarButton-${calendarContentId}-${widgetId}').attr('aria-pressed', 'false');
        $('#showListButton-${calendarContentId}-${widgetId}').attr('aria-pressed', 'true');
        });
	});
    });
      </script>


