{
  "schemaVersion": "1.0",
  "id": "perc.imageMainBinary",
  "name": "perc.imageMainBinary",
  "version": "1.1.8",
  "description": "Image Widget",
  "publisher": {
    "name": "Percussion Software",
    "url": "http://www.percussion.com"
  },
  "cmsVersion": {
    "min": "1.0.1",
    "max": "9.0.0"
  },
  "dependencies": [
    {
      "name": "perc.Baseline",
      "version": "1.0.3",
      "implied": true
    }
  ],
  "catalog": {
    "kind": "page",
    "title": "perc.imageMainBinary",
    "category": "binary",
    "description": "Binary assembler template for percImageAsset main image (imageMainBinary).",
    "paletteVisible": false
  },
  "contentTypes": [],
  "templates": [
    {
      "name": "perc.imageMainBinary",
      "type": "binary",
      "assembler": "binaryAssembler",
      "sourceRef": "templates/perc.imageMainBinary.vm",
      "legacyTemplateType": "Local",
      "bindings": [
        {
          "variable": "$sys.binary",
          "expression": "$sys.item.getProperty('rx:img')"
        },
        {
          "variable": "$sys.mimetype",
          "expression": "$sys.item.getProperty('rx:img_type')"
        },
        {
          "variable": "$sys.metadata.linktext",
          "expression": "$sys.item.getProperty('displaytitle').String "
        },
        {
          "variable": "$sys.metadata.dcterms:created",
          "expression": "$tools.date.format(\"yyyy-MM-dd'T'HH:mm:ss\",$sys.item.getProperty(\"rx:sys_contentcreateddate\").Date)"
        },
        {
          "variable": "$sys.metadata.dcterms:title",
          "expression": "$sys.item.getProperty('displaytitle').String "
        },
        {
          "variable": "$sys.metadata.dcterms:format",
          "expression": "$sys.mimetype.String"
        }
      ]
    }
  ],
  "slots": [],
  "resources": [],
  "userPreferences": [],
  "cssPreferences": []
}
