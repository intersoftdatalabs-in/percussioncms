        {
          "variable": "__widgetCode",
          "expression": "$sectionPath = $perc.widget.item.properties.get('sectionPath');\n    $promotedPagePaths = $perc.widget.item.properties.get('promotedPagePaths');\n    $summary = $perc.widget.item.properties.get('summary');\n    $mostReadMoreText = $perc.widget.item.properties.get('mostReadMoreText');\n    $timePeriod = $perc.widget.item.properties.get('timePeriod');\n    $hideDate = $perc.widget.item.properties.get('hideDate');\n    $headingStyle = $perc.widget.item.properties.get('headingStyle');\n    $ariaRole = $perc.widget.item.properties.get('ariaRole');\n    $ariaLabel = $perc.widget.item.properties.get('ariaLabel');\n    $numberOfResults = $perc.widget.item.properties.get('numberOfResults');\n    $sortOrderByHits = $perc.widget.item.properties.get('sortOrderByHits');\n    $listDateTimeFormat = $perc.widget.item.properties.get('listDateTimeFormat');\n    $locale = $perc.widget.item.properties.get('locale');\n    $listTitle = $perc.widget.item.properties.get('listTitle');\n    $rootclass = $perc.widget.item.cssProperties.get('rootclass');\n    if (!empty($rootclass)) {\n       $rootclass = $rootclass + \" \";\n    }\n\n    if ($ariaLabel != '' && $ariaLabel != null) {\n        $ariaLabel = ' aria-label=' + '\"' + $ariaLabel + '\"';\n    }\n\n    if ($ariaRole != '' && $ariaRole != null) {\n        $ariaRole = ' role=' + '\"' + $ariaRole + '\"';\n    }\n\n    $data = \"{\";\n\n    $data = $data + \"&quot;sectionPath&quot;:&quot;\" + $sectionPath  + \"&quot;\";\n    $data = $data + \",&quot;promotedPagePaths&quot;:&quot;\" + $promotedPagePaths  + \"&quot;\";\n    $data = $data + \", &quot;summary&quot;:\" + $summary;\n    if ($mostReadMoreText != null && $mostReadMoreText != \"\")\n    {\n        $data = $data + \", &quot;readMoreLink&quot;:\" + \"&quot;\" + $mostReadMoreText + \"&quot;\" ;\n    }\n    if ($listDateTimeFormat != null && $listDateTimeFormat != \"\")\n    {\n        $data = $data + \", &quot;dateFormat&quot;:\" + \"&quot;\" + $listDateTimeFormat + \"&quot;\" ;\n    }\n\n    if ($locale != null && $locale != \"\")\n    {\n        $data = $data + \", &quot;locale&quot;:\" + \"&quot;\" + $locale + \"&quot;\" ;\n    }\n    $data = $data + \", &quot;timePeriod&quot;:&quot;\" + $timePeriod  + \"&quot;\";\n    $data = $data + \", &quot;headingStyle&quot;:&quot;\" + $headingStyle  + \"&quot;\";\n    $data = $data + \", &quot;hideDate&quot;:&quot;\" + $hideDate  + \"&quot;\";\n    $data = $data + \", &quot;numberOfResults&quot;:&quot;\" + $numberOfResults  + \"&quot;\";\n    $data = $data + \", &quot;sortOrderByHits&quot;:&quot;\" + $sortOrderByHits  + \"&quot;\";\n    $data = $data + \", &quot;listTitle&quot;:&quot;\" + $listTitle  + \"&quot;\";\n\n    $dsUrl = $rx.pageutils.getDeliveryServer($sys.assemblyItem.PubServerId);\n\n    $data = $data + \", &quot;deliveryurl&quot;:&quot;\" + $dsUrl + \"&quot;\";\n\n\t$data = $data + \"}\";\n    ##result query ends"
        }
