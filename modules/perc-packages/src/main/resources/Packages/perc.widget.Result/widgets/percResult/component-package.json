{
  "schemaVersion": "1.0",
  "id": "percResult",
  "name": "Result",
  "version": "1.1.8",
  "description": "Display the result of a search",
  "publisher": {
    "name": "Percussion Software Inc.",
    "url": "https://www.percussion.com"
  },
  "cmsVersion": {
    "min": "1.9.0",
    "max": "9.0.0"
  },
  "dependencies": [],
  "catalog": {
    "kind": "component",
    "title": "Result",
    "category": "search",
    "description": "Display the result of a search",
    "thumbnail": "resources/widgetIconLinkResult.png",
    "icon": "resources/widgetIconLinkResult.png",
    "author": "Percussion Software Inc",
    "preferredEditorWidth": 800,
    "preferredEditorHeight": 685,
    "responsive": true,
    "paletteVisible": true
  },
  "contentTypes": [],
  "templates": [
    {
      "name": "percResultSnippet",
      "type": "snippet",
      "assembler": "velocityAssembler",
      "sourceRef": "templates/percResultSnippet.vm",
      "bindings": [
        {
          "variable": "isEditMode",
          "expression": "\"false\""
        },
        {
          "variable": "summary",
          "expression": "$perc.widget.item.properties.get('summary')"
        },
        {
          "variable": "sortbyVal",
          "expression": "$perc.widget.item.properties.get('sortby')"
        },
        {
          "variable": "resultHeaderText",
          "expression": "$perc.widget.item.properties.get('resultHeaderText')"
        },
        {
          "variable": "resultDateTimeFormat",
          "expression": "$perc.widget.item.properties.get('resultDateTimeFormat')"
        },
        {
          "variable": "resultEntriesTextPlural",
          "expression": "$perc.widget.item.properties.get('resultEntriesTextPlural')"
        },
        {
          "variable": "resultEntriesTextSingular",
          "expression": "$perc.widget.item.properties.get('resultEntriesTextSingular')"
        },
        {
          "variable": "readMoreLink",
          "expression": "$perc.widget.item.properties.get('readMoreLink')"
        },
        {
          "variable": "totalMaxResults",
          "expression": "$perc.widget.item.properties.get('totalMaxResults')"
        },
        {
          "variable": "perc_max_post_entries",
          "expression": "$perc.widget.item.properties.get('maxResultsPerPage')"
        },
        {
          "variable": "pagingPagesText",
          "expression": "$perc.widget.item.properties.get('pagingPagesText')"
        },
        {
          "variable": "pagingOfText",
          "expression": "$perc.widget.item.properties.get('pagingOfText')"
        },
        {
          "variable": "locale",
          "expression": "$perc.widget.item.properties.get('locale')"
        },
        {
          "variable": "rootclass",
          "expression": "$perc.widget.item.cssProperties.get('rootclass')"
        },
        {
          "variable": "rootclass",
          "expression": "$rootclass + \" \""
        },
        {
          "variable": "resultEntriesTextPlural",
          "expression": "'results'"
        },
        {
          "variable": "resultEntriesTextSingular",
          "expression": "'result'"
        },
        {
          "variable": "locale",
          "expression": "\"en-US\""
        },
        {
          "variable": "orderby",
          "expression": "\"\""
        },
        {
          "variable": "orderby",
          "expression": "\"dcterms:title asc\""
        },
        {
          "variable": "orderby",
          "expression": "\"dcterms:created asc\""
        },
        {
          "variable": "orderby",
          "expression": "\"dcterms:created desc\""
        },
        {
          "variable": "data",
          "expression": "\"{\""
        },
        {
          "variable": "data",
          "expression": "$data + \" &quot;orderBy&quot;:&quot;\" + $orderby + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;locale&quot;:\" + \"&quot;\" + $locale + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;dateFormat&quot;:\" + \"&quot;\" + $resultDateTimeFormat + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;headerText&quot;:&quot;\" + $resultHeaderText + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;entriesTextPlural&quot;:&quot;\" + $resultEntriesTextPlural + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;entriesTextSingular&quot;:&quot;\" + $resultEntriesTextSingular + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;readMoreLink&quot;:&quot;\" + $readMoreLink + \"&quot;\""
        },
        {
          "variable": "totalMaxResults",
          "expression": "500"
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;totalMaxResults&quot;:\" + $totalMaxResults"
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;maxResults&quot;:\" + $perc_max_post_entries"
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;pagingPagesText&quot;:\" + \"&quot;\" + $pagingPagesText + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;pagingOfText&quot;:\" + \"&quot;\" + $pagingOfText + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;summary&quot;:&quot;\" + $summary + \"&quot;\""
        },
        {
          "variable": "dsUrl",
          "expression": "$rx.pageutils.getDeliveryServer($sys.assemblyItem.PubServerId)"
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;deliveryurl&quot;:&quot;\" + $dsUrl + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \", &quot;isEditMode&quot;:&quot;\" + $isEditMode + \"&quot;\""
        },
        {
          "variable": "data",
          "expression": "$data + \"}\""
        },
        {
          "variable": "__widgetCode",
          "expression": "$isEditMode=\"false\";\n    $summary = $perc.widget.item.properties.get('summary');\n    $sortbyVal = $perc.widget.item.properties.get('sortby');\n    $resultHeaderText = $perc.widget.item.properties.get('resultHeaderText');\n    $resultDateTimeFormat = $perc.widget.item.properties.get('resultDateTimeFormat');\n    $resultEntriesTextPlural = $perc.widget.item.properties.get('resultEntriesTextPlural');\n    $resultEntriesTextSingular = $perc.widget.item.properties.get('resultEntriesTextSingular');\n    $readMoreLink = $perc.widget.item.properties.get('readMoreLink');\n    $totalMaxResults = $perc.widget.item.properties.get('totalMaxResults');\n    $perc_max_post_entries = $perc.widget.item.properties.get('maxResultsPerPage');\n    $pagingPagesText = $perc.widget.item.properties.get('pagingPagesText');\n    $pagingOfText = $perc.widget.item.properties.get('pagingOfText');\n    $locale = $perc.widget.item.properties.get('locale');\n    $rootclass = $perc.widget.item.cssProperties.get('rootclass');\n    if (!empty($rootclass)) {\n       $rootclass = $rootclass + \" \";\n    }\n    if ($resultEntriesTextPlural == \"\" || $resultEntriesTextPlural == null)\n    {\n        $resultEntriesTextPlural = 'results';\n    }\n    if ($resultEntriesTextSingular == \"\" || $resultEntriesTextSingular == null)\n    {\n        $resultEntriesTextSingular = 'result';\n    }\n\n    if($locale == null)\n        $locale = \"en-US\";\n\n    ##builds the order by clause\n    $orderby = \"\";\n    if ($sortbyVal == \"rx:page_title\")\n    {\n        $orderby = \"dcterms:title asc\";\n    }\n    else if($sortbyVal == \"rx:sys_contentpostdate\")\n    {\n        $orderby = \"dcterms:created asc\";\n    }\n    else if($sortbyVal == \"rx:sys_contentpostdate desc\")\n    {\n        $orderby = \"dcterms:created desc\";\n    }\n    $data = \"{\";\n\n    if($orderby != \"\")\n    {\n        $data = $data + \" &quot;orderBy&quot;:&quot;\" + $orderby + \"&quot;\";\n    }\n    if ($locale != null && $locale != \"\")\n    {\n        $data = $data + \", &quot;locale&quot;:\" + \"&quot;\" + $locale + \"&quot;\" ;\n    }\n    if ($resultDateTimeFormat != null && $resultDateTimeFormat != \"\")\n    {\n        $data = $data + \", &quot;dateFormat&quot;:\" + \"&quot;\" + $resultDateTimeFormat + \"&quot;\" ;\n    }\n    $data = $data + \", &quot;headerText&quot;:&quot;\" + $resultHeaderText + \"&quot;\";\n    if ($resultEntriesTextPlural != \"\")\n    {\n        $data = $data + \", &quot;entriesTextPlural&quot;:&quot;\" + $resultEntriesTextPlural + \"&quot;\";\n    }\n    if ($resultEntriesTextSingular != \"\")\n    {\n        $data = $data + \", &quot;entriesTextSingular&quot;:&quot;\" + $resultEntriesTextSingular + \"&quot;\";\n    }\n    $data = $data + \", &quot;readMoreLink&quot;:&quot;\" + $readMoreLink + \"&quot;\";\n\n    if (empty($totalMaxResults)) {\n          $totalMaxResults = 500;\n    }\n\n    $data = $data + \", &quot;totalMaxResults&quot;:\" + $totalMaxResults ;\n\n    if ($perc_max_post_entries != null && $perc_max_post_entries != \"\")\n    {\n        $data = $data + \", &quot;maxResults&quot;:\" + $perc_max_post_entries ;\n    }\n    if ($pagingPagesText != null && $pagingPagesText != \"\")\n    {\n        $data = $data + \", &quot;pagingPagesText&quot;:\" + \"&quot;\" + $pagingPagesText + \"&quot;\" ;\n    }\n    if ($pagingOfText != null && $pagingOfText != \"\")\n    {\n        $data = $data + \", &quot;pagingOfText&quot;:\" + \"&quot;\" + $pagingOfText + \"&quot;\" ;\n    }\n    ##summary option.\n    if($summary)\n    {\n        $data = $data + \", &quot;summary&quot;:&quot;\" + $summary + \"&quot;\";\n    }\n\n    $dsUrl = $rx.pageutils.getDeliveryServer($sys.assemblyItem.PubServerId);\n\n    $data = $data + \", &quot;deliveryurl&quot;:&quot;\" + $dsUrl + \"&quot;\";\n    $data = $data + \", &quot;isEditMode&quot;:&quot;\" + $isEditMode + \"&quot;\";\n\t$data = $data + \"}\";\n    ##result query ends"
        }
      ]
    }
  ],
