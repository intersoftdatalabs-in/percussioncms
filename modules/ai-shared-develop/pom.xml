<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.percussion</groupId>
        <artifactId>core</artifactId>
        <version>8.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ai-shared-develop</artifactId>
    <packaging>jar</packaging>
    <name>Percussion AI Shared Development</name>
    <description>Shared AI development libraries and utilities for Percussion CMS</description>
    <properties>
        <exec.mainClass>com.percussion.ai.signing.ResourceSigner</exec.mainClass>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>dev.sigstore</groupId>
            <artifactId>sigstore-java</artifactId>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Maven Compiler Plugin for Java 21 -->
            <!-- Surefire Plugin for running tests -->
            <!-- Maven Site Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
            </plugin>
            <!-- Exec Maven Plugin to run ResourceSigner -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${maven.execmaven.plugin.version}</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
            <!-- Zip skills for signing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>zip-skills</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/skills"/>
                                <zip basedir="src/main/resources/skills/java-unit-testing" destfile="${project.build.directory}/skills/java-unit-testing.zip"/>
                                <zip basedir="src/main/resources/skills/javadoc" destfile="${project.build.directory}/skills/javadoc.zip"/>
                                <zip basedir="src/main/resources/skills/patch" destfile="${project.build.directory}/skills/patch.zip"/>
                                <zip basedir="src/main/resources/skills/percussioncms-dev" destfile="${project.build.directory}/skills/percussioncms-dev.zip"/>
                                <zip basedir="src/main/resources/skills/erlang-review" destfile="${project.build.directory}/skills/erlang-review.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Attach zipped skills as artifacts -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-skills</id>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/skills/java-unit-testing.zip</file>
                                    <type>zip</type>
                                    <classifier>skill-java-unit-testing</classifier>
                                </artifact>
                                <artifact>
                                    <file>${project.build.directory}/skills/javadoc.zip</file>
                                    <type>zip</type>
                                    <classifier>skill-javadoc</classifier>
                                </artifact>
                                <artifact>
                                    <file>${project.build.directory}/skills/patch.zip</file>
                                    <type>zip</type>
                                    <classifier>skill-patch</classifier>
                                </artifact>
                                <artifact>
                                    <file>${project.build.directory}/skills/percussioncms-dev.zip</file>
                                    <type>zip</type>
                                    <classifier>skill-percussioncms-dev</classifier>
                                </artifact>
                                <artifact>
                                    <file>${project.build.directory}/skills/erlang-review.zip</file>
                                    <type>zip</type>
                                    <classifier>skill-erlang-review</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven Javadoc Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.1</version>
                <configuration>
                    <doclint>none</doclint>
                    <source>21</source>
                    <detectLinks>true</detectLinks>
                    <links>
                        <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
                    </links>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
