<?xml version="1.0" encoding="UTF-8" ?>
<!-- Build file for Rhythmyx repository install -->
<project name="install" default="install" basedir="..\..\..">

	<target name="install">
		<property environment="env" />
		<property name="" value="${env.}" />
		<condition property="DEVELOPMENT" value="${env.DEVELOPMENT}"
			else="false">
			<isset property="env.DEVELOPMENT" />
		</condition>
		<property name="perc.version" value="${env.percversion}" />
		<property name="assembly-directory"
			value="${basedir}/target/classes/distribution" />
		<property name="rxbase" value="${basedir}/../../system" />

		<property name="releasedir" value="${rxbase}/release" />
		<property name="configdir" value="${rxbase}/config" />
		<property name="ffconfigdir"
			value="${rxbase}/FastForward/Core/Config" />

		<property name="release.configdir"
			value="${basedir}/../../system/release/config" />
		<property name="design.dtddir"
			value="${basedir}/../../system/design/dtd" />
		<property name="deployer.dir"
			value="${basedir}/../../deployer" />
		<property name="errorpagesdir"
			location="${basedir}/../../system/Defaults/ErrorPages" />
		<property name="stylesheetsdir"
			location="${basedir}/../../system/Defaults/Stylesheets" />

		<property name="install.upgrade"
			location="${assembly-directory}/upgrade" />

		<property name="install.config"
			location="${assembly-directory}/rxconfig" />
		<property name="install.I18n"
			location="${install.config}/i18n" />
		<property name="install.Categories"
			location="${install.config}/Categories" />
		<property name="install.Server"
			location="${install.config}/Server" />
		<property name="install.Workflow"
			location="${install.config}/Workflow" />

		<condition property="isMac">
			<os family="mac" />
		</condition>
		<condition property="isWindows">
			<os family="windows" />
		</condition>
		<condition property="isLinux">
			<os family="unix" />
		</condition>

		<taskdef resource="com/percussion/ant/antlib.xml" />

		<taskdef resource="net/sf/antcontrib/antlib.xml" />

		<!-- start db install -->
		<property name="APPS_DIR" location="${assembly-directory}" />

		<copy todir="${assembly-directory}/jetty">
			<fileset
				dir="${jetty-directory}/perc-jetty-${project.version}/" />
		</copy>

		<!-- Unpack perc-web-ui WAR to Rhythmyx -->
		<echo>Unpacking perc-web-ui WAR...</echo>
		<mkdir dir="${assembly-directory}/jetty/base/webapps/Rhythmyx" />
		<unzip dest="${assembly-directory}/jetty/base/webapps/Rhythmyx"
			overwrite="true">
			<fileset dir="../../WebUI/target">
				<include name="perc-web-ui-${project.version}.war" />
			</fileset>
			<patternset>
				<exclude name="META-INF/**" />
			</patternset>
		</unzip>

		<!-- Unpack perc-openapi-webapp WAR to /openapi context -->
		<echo>Unpacking perc-openapi-webapp WAR...</echo>
		<mkdir dir="${assembly-directory}/jetty/base/webapps/openapi" />
		<unzip dest="${assembly-directory}/jetty/base/webapps/openapi"
			overwrite="true">
			<fileset dir="../../modules/perc-openapi-webapp/target">
				<include name="perc-openapi-webapp-${project.version}.war" />
			</fileset>
			<patternset>
				<exclude name="META-INF/**" />
			</patternset>
		</unzip>

		<copy todir="${assembly-directory}/Docs">
			<fileset dir="{basedir}/../../../system/Docs" />
		</copy>

		<copy todir="${assembly-directory}">
			<fileset
				dir="{basedir}/../../../system/target/classes/com/percussion/util/">
				<include name="Version.properties" />
			</fileset>
		</copy>

		<copy todir="${assembly-directory}">
			<fileset
				dir="{basedir}/../../perc-xml-security/src/main/resources/">
				<include name="PercussionXMLCatalog.xml" />
			</fileset>
		</copy>

		<mkdir dir="${assembly-directory}/var/config" />
		<copy todir="${assembly-directory}/var/config">
			<fileset
				dir="{basedir}/../../perc-xml-security/src/main/resources/">
				<include name="CustomXMLCatalog.xml" />
			</fileset>
		</copy>
		<copy todir="${assembly-directory}/sys_resources">
			<fileset
				dir="${basedir}/../../system/cms/content/applications/sys_resources/ApplicationFiles">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/rx_resources"
			overwrite="false" verbose="true">
			<fileset
				dir="${basedir}/../../system/cms/content/applications/rx_resources/ApplicationFiles">
			</fileset>
		</copy>

		<!-- TinyMCE config -->
		<copy todir="${assembly-directory}/rx_resources"
			overwrite="false" verbose="true">
			<fileset
				dir="${basedir}/../perc-tinymce/target/classes/META-INF/resources/rx_resources">
			</fileset>
		</copy>

		<!-- TinyMCE config -->
		<copy todir="${assembly-directory}/sys_resources"
			overwrite="true" verbose="true" force="true">
			<fileset
				dir="${basedir}/../perc-tinymce/target/classes/META-INF/resources/sys_resources">
			</fileset>
		</copy>

		<!-- Duplicate rx_resources copy removed: identical operation already performed
			above (line ~109). -->
		<copy todir="${assembly-directory}">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxApp/rxAppSupport">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxApp/sysAppSupport">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/ObjectStore" flatten="true">
			<fileset dir="${rxbase}/cms/content/applications">
				<include name="*/*.xml" />
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/ObjectStore">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxApp/ObjectStore">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/Core/rxsAppSupport">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/ObjectStore">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/Core/rxsObjectStore">
			</fileset>
		</copy>
		<copy todir="${assembly-directory}">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/ManagedNav/rxsAppSupport">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/ObjectStore">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/ManagedNav/rxsObjectStore">
			</fileset>
		</copy>
		<copy todir="${assembly-directory}/ObjectStore">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/SiteFolderPublishing/rxsObjectStore">
			</fileset>
		</copy>

		<copy todir="${assembly-directory}/rxconfig">
			<fileset
				dir="${rxapps-directory}/perc-rxapps-${project.version}/RxFastForward/Core/Config">
			</fileset>
		</copy>

		<mkdir dir="${assembly-directory}/rxconfig/esapi" />
		<copy todir="${assembly-directory}/rxconfig/esapi">
			<fileset
				dir="${basedir}/../perc-security-utils/src/main/resources/esapi"
				includes="**/*" />
		</copy>

		<!-- Install Velocity Configuration Files -->
		<mkdir dir="${assembly-directory}/rxconfig/velocity" />
		<copy todir="${assembly-directory}/rxconfig/velocity">
			<fileset dir="${basedir}/../../system/Tools/velocity"
				includes="**/*" />
		</copy>

		<mkdir dir="${assembly-directory}/rxconfig/secure" />

		<copy todir="${assembly-directory}/rxconfig/secure">
			<fileset
				dir="${basedir}/../../modules/utils/src/main/resources/com/percussion/security/encryption/" />
		</copy>

		<!-- Deployment Table Definition -->
		<copy todir="${assembly-directory}/Packages/Percussion">
			<fileset
				dir="${packages-directory}/perc-packages-${project.version}/Packages">
			</fileset>
		</copy>


		<mkdir dir="${assembly-directory}/DTD" />
		<copy todir="${assembly-directory}/DTD">
			<!--<fileset dir="${basedir}/../../system/cms/dbpublisher/dtd" includes="sys_DatabasePublisher.dtd,
				aliasmap.dtd" /> -->
			<fileset
				dir="${basedir}/../../modules/TableFactory/src/main/resources/dtd"
				includes="sys_Tabledata.dtd, sys_Tabledef.dtd" />
			<fileset dir="${basedir}/../../system/DTD" includes="**" />
		</copy>


		<!-- Copy DesktopContentExplorer resources and jar -->
		<!-- <copy todir="${assembly-directory}/jetty/base/webapps/Rhythmyx/dce"
			overwrite="true" verbose="true" force="true"> <fileset dir="${basedir}/../DesktopContentExplorer/src/main/resources/com/percussion/cx">
			<exclude name="**/*.class"/> </fileset> <fileset dir="${basedir}/../DesktopContentExplorer/target">
			<include name="perc-content-explorer-${project.version}.jar"/> </fileset>
			</copy> -->

		<!--<copy todir="${assembly-directory}/cm"> <fileset dir="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm">
			</fileset> </copy> -->

		<!-- <copy todir="${assembly-directory}/web_resources/cm"> <fileset dir="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm">
			<include name="themes/" /> <include name="css/" /> <include name="jslib/"
			/> <include name="jslibMin/" /> </fileset> </copy> -->

		<!-- Create rx_resources/default_theme and web_resources/themes/percussion -->
		<mkdir
			dir="${assembly-directory}/web_resources/themes/percussion" />
		<copy
			todir="${assembly-directory}/web_resources/themes/percussion">
			<fileset
				dir="${assembly-directory}/rx_resources/default_theme" />
		</copy>



		<if>
			<available file="${install.rx_resources}/default_theme" />
			<then>
				<move
					tofile="${assembly-directory}/web_resources/themes/percussion/perc_theme.css"
					file="${assembly-directory}/web_resources/themes/percussion/theme.css" />
				<move
					tofile="${assembly-directory}/web_resources/themes/percussion/perc_theme.png"
					file="${assembly-directory}/web_resources/themes/percussion/theme.png" />
			</then>
		</if>


		<!-- Common UI bundles — read directly from the perc-common-ui-bundle module
			output. -->
		<!-- This mirrors the perc-tinymce pattern: copy from target/classes/META-INF/resources. -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/common/js/perc_common_ui.js"
			file="${basedir}/../perc-common-ui-bundle/target/classes/META-INF/resources/cm/common/js/perc_common_ui.js" />

		<copy
			tofile="${assembly-directory}/web_resources/cm/common/js/perc_common_ui_slim.js"
			file="${basedir}/../perc-common-ui-bundle/target/classes/META-INF/resources/cm/common/js/perc_common_ui_slim.js" />

		<!-- Copy Java Script -->
		<!-- jquery for gadgets -->
		<copy
			tofile="${assembly-directory}/jetty/base/webapps/Rhythmyx/WEB-INF/classes/features/perc/jquery/jquery-3.6.0.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/jquery-3.6.0.js" />
		<copy
			tofile="${assembly-directory}/jetty/base/webapps/Rhythmyx/WEB-INF/classes/features/perc/jquery/jquery-migrate-3.3.2.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/jquery-migrate-3.3.2.js" />
		<copy
			tofile="${assembly-directory}/jetty/base/webapps/Rhythmyx/WEB-INF/classes/features/perc/core/es5.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/libraries/bowser/es5.js" />
		<!-- jquery for published site -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/jquery-3.6.0.js" />

		<!-- jquery-ui for published site -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery-ui.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/libraries/jquery-ui/jquery-ui.js" />
		<!-- jquery migrate for published site -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery-migrate.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/jquery-migrate-3.3.2.js" />

		<!-- jquery ui -->
		<copy
			tofile="${assembly-directory}/jetty/base/webapps/Rhythmyx/WEB-INF/classes/features/perc/jqueryUi/jquery-ui.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/libraries/jquery-ui/jquery-ui.js" />
		<!-- collapser -->
		<copy
			tofile="${assembly-directory}/jetty/base/webapps/Rhythmyx/WEB-INF/classes/features/perc/collapser/jquery.collapser.js"
			file="${basedir}/../../WebUI/war/jslib/profiles/3x/jquery/plugins/jquery-collapser/jquery.collapser.js" />

		<!-- jQuery.cookie -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery.cookie.js"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/jquery/plugins/jquery-perc-retiredjs/jquery.cookie.js" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery.cookie.min.js"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/jquery/plugins/jquery-perc-retiredjs/jquery.cookie.js" />
		<!-- jQuery.dynatree -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery.dynatree.js"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/jquery/plugins/jquery-dynatree/jquery.dynatree.js" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/css/dynatree/skin/ui.dynatree.css"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/css/dynatree/skin/ui.dynatree.css" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/css/dynatree/skin/vline.gif"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/css/dynatree/skin/vline.gif" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/css/dynatree/skin/loading.gif"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/css/dynatree/skin/loading.gif" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/css/dynatree/skin/icons2.gif"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/css/dynatree/skin/icons2.gif" />
		<copy
			tofile="${assembly-directory}/web_resources/cm/css/dynatree/skin/icons.gif"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/css/dynatree/skin/icons.gif" />
		<!-- jQuery Validate -->
		<copy
			tofile="${assembly-directory}/web_resources/cm/jslib/jquery.validate.js"
			file="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/jquery/plugins/jquery-validation/jquery.validate.js" />

		<!-- Copy Font Awesome -->
		<copy
			todir="${assembly-directory}/web_resources/cm/css/fontawesome">
			<fileset
				dir="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/libraries/fontawesome/css"
				includes="**/*" />
		</copy>

		<copy
			todir="${assembly-directory}/web_resources/cm/css/fontawesome">
			<fileset
				dir="${assembly-directory}/jetty/base/webapps/Rhythmyx/cm/jslib/profiles/3x/libraries/fontawesome"
				includes="**/*" />
		</copy>
		<!-- Global Variables -->

		<!-- Install the workflow properties file -->
		<mkdir dir="${install.Workflow}" />
		<PSCopy
			tofile="${assembly-directory}/rxconfig/Workflow/rxworkflow.properties"
			file="${rxbase}/workflow/config/rxworkflow.properties"
			replaceType="never" />



		<!-- Add widget folder -->
		<mkdir dir="${assembly-directory}/rxconfig/Widgets" />

		<!-- Add ssh-keys folder for sftp with keys publishing -->
		<mkdir dir="${assembly-directory}/rxconfig/ssh-keys" />
		<touch file="${assembly-directory}/rxconfig/ssh-keys/config" />
		<mkdir dir="${assembly-directory}/rxconfig/trusted_certificates" />

		<!-- DTD Files -->
		<mkdir dir="${assembly-directory}/DTD" />
		<PSCopy todir="${assembly-directory}/DTD">
			<fileset dir="${design.dtddir}" />
		</PSCopy>

		<!-- MSM System Files -->
		<mkdir
			dir="${assembly-directory}/sys_MultiServerManager/server/cfg" />
		<PSCopy
			todir="${assembly-directory}/sys_MultiServerManager/server/cfg"
			file="${configdir}/Deployment/sys_DependencyMap.xml" />
		<PSCopy
			todir="${assembly-directory}/sys_MultiServerManager/server/cfg"
			file="${configdir}/Deployment/featureset.xml" />

		<!-- Deployer System Files -->
		<mkdir dir="${assembly-directory}/sys_Packager/server/cfg" />
		<mkdir dir="${assembly-directory}/sys_Packager/schema" />
		<PSCopy todir="${assembly-directory}/sys_Packager/server/cfg"
			file="${configdir}/Deployer/sys_PackageConfiguration.xml" />
		<PSCopy todir="${assembly-directory}/sys_Packager/schema">
			<fileset dir="${deployer.dir}/schema" />
		</PSCopy>

		<!-- Error Pages -->
		<mkdir dir="${assembly-directory}/ErrorPages" />
		<PSCopy todir="${assembly-directory}/ErrorPages">
			<fileset dir="${errorpagesdir}" />
		</PSCopy>

		<!-- Default StyleSheets -->
		<mkdir dir="${assembly-directory}/StyleSheets" />
		<PSCopy todir="${assembly-directory}/StyleSheets">
			<fileset dir="${stylesheetsdir}" />
		</PSCopy>


		<!-- Upgrade Files -->
		<PSCopy todir="${assembly-directory}/upgrade">
			<fileset
				dir="${rxbase}/src/main/resources/com/percussion/rxupgrade" />
		</PSCopy>
		<!-- Upgrade DTD Files -->
		<mkdir dir="${assembly-directory}/upgrade" />
		<PSCopy todir="${install.upgrade}/DTD">
			<fileset dir="${design.dtddir}">
				<include name="sys_BasicObjects.dtd" />
				<include name="sys_ContentEditorSystemDef.dtd" />
				<include name="sys_StoredActions.dtd" />
			</fileset>
		</PSCopy>


		<mkdir dir="${assembly-directory}/rxlt/DTD" />
		<PSCopy todir="${assembly-directory}/rxlt/DTD">
			<fileset dir="${design.dtddir}">
				<include name="sys_BasicObjects.dtd" />
				<include name="sys_ContentEditorSystemDef.dtd" />
				<include name="sys_StoredActions.dtd" />
			</fileset>
		</PSCopy>


		<!-- Categories -->
		<mkdir dir="${install.config}/Categories" />
		<PSCopy todir="${install.config}/Categories"
			file="${configdir}/Categories/default.xml" replaceType="never" />

		<!-- Proxy configuration -->
		<mkdir dir="${install.config}/Proxy" />
		<PSCopy todir="${install.config}/Proxy"
			file="${configdir}/proxy-config.xml" replaceType="never" />
		<!-- CMS Config Files -->
		<mkdir dir="${install.config}/DeliveryServer" />

		<if>
			<and>
				<isset property="delivery.target" />
				<equals arg1="${delivery.target}" arg2="dev" />
			</and>
			<then>
				<PSCopy
					tofile="${install.config}/DeliveryServer/delivery-servers.xml"
					file="${configdir}/delivery-servers.xml.dev" replaceType="always" />
			</then>
			<elseif>
				<and>
					<isset property="delivery.target" />
					<equals arg1="${delivery.target}" arg2="qa" />
				</and>
				<then>
					<PSCopy
						tofile="${install.config}/DeliveryServer/delivery-servers.xml"
						file="${configdir}/delivery-servers.xml.qa" replaceType="always" />
				</then>
			</elseif>
			<else>
				<PSCopy todir="${install.config}/DeliveryServer"
					file="${configdir}/delivery-servers.xml" replaceType="never" />
			</else>
		</if>

		<mkdir dir="${install.config}/Server/ContentEditors/shared" />

		<!-- ContentEditor DTD Files -->
		<mkdir dir="${install.config}/Server/ContentEditors/DTD" />
		<PSCopy todir="${install.config}/Server/ContentEditors/DTD">
			<fileset dir="${design.dtddir}">
				<include name="sys_ContentEditorSystemDef.dtd" />
				<include name="sys_BasicObjects.dtd" />
			</fileset>
		</PSCopy>

		<!-- RequestHandler DTD Files -->
		<mkdir dir="${install.config}/Server/requestHandlers/DTD" />
		<PSCopy todir="${install.config}/Server/requestHandlers/DTD">
			<fileset dir="${design.dtddir}">
				<include name="sys_StoredActions.dtd" />
				<include name="sys_BasicObjects.dtd" />
			</fileset>
		</PSCopy>

		<PSCopy todir="${assembly-directory}">
			<fileset dir="${releasedir}/installer/config"
				includes="rxW2KserverPageTags.xml,rxW2Ktidy.properties" />
			<fileset
				dir="${basedir}/../../modules/utils/src/main/resources/com/percussion/html"
				includes="html-cleaner.properties" />
		</PSCopy>


		<!-- Server Config Files -->
		<PSCopy todir="${install.config}/Server" replaceType="never">
			<fileset dir="${configdir}">
				<include name="config.xml" />
				<include name="RequestHandlers.xml" />
				<include name="mimemap.properties" />
				<include name="objectstore.properties" />
				<include name="server.properties" />
				<include name="rw_processes.xml" />
				<include name="sys_library_loader.xml" />
				<include name="authtypes.properties" />
				<include name="stylesheetCleanupFilter.xml" />
				<include name="addThumbnailURL.properties" />
				<include name="allowedUrls.properties" />
				<include name="blockedUrls.properties" />
			</fileset>
		</PSCopy>

		<!-- Always Replace Files -->
		<!-- Server System Files -->
		<PSCopy todir="${install.Server}">
			<fileset dir="${configdir}">
				<include name="csmaps.xml" />
				<include name="featureset.xml" />
				<include name="sys_DatabaseFunctionDefs.xml" />
				<include name="sys_macros.xml" />
				<include name="sys_library_loader.xml" />
				<include name="startupProcessManager.properties" />
			</fileset>
		</PSCopy>

		<!-- Always overwrite mimemap.properties, no need for users to edit -->
		<PSCopy todir="${install.config}/Server">
			<fileset dir="${configdir}">
				<include name="mimemap.properties" />
			</fileset>
		</PSCopy>

		<PSCopy todir="${install.config}/Server/ContentEditors">
			<fileset dir="${configdir}/ContentEditors" />
		</PSCopy>

		<PSCopy todir="${install.config}/Server/ContentEditors">
			<fileset dir="${ffconfigdir}/Server/ContentEditors" />
		</PSCopy>

		<PSCopy todir="${install.config}/Server/requestHandlers"
			replaceType="never">
			<fileset dir="${configdir}/requestHandlers" />
		</PSCopy>

		<!-- Data files -->
		<mkdir dir="${install.config}/Installer/data" />

		<!-- TODO: Spamming these files for now - not sure why the instance fails
			if not in all locations ideally should only be in data -->
		<PSCopy
			tofile="${install.config}/Installer/data/cmsTableData.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableData.xml"
			replaceType="always" />
		<PSCopy
			tofile="${install.config}/Installer/data/cmsTableDef.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableDef.xml"
			replaceType="always" />
		<PSCopy tofile="${install.config}/Data/cmsTableData.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableData.xml"
			replaceType="always" />
		<PSCopy tofile="${install.config}/Data/cmsTableDef.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableDef.xml"
			replaceType="always" />
		<PSCopy tofile="${install.config}/Server/sys_cmsTableData.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableData.xml"
			replaceType="always" />
		<PSCopy tofile="${install.config}/Server/sys_cmsTableDef.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/cmsTableDef.xml"
			replaceType="always" />

		<PSCopy
			tofile="${install.config}/Installer/data/RxffTableData.xml"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/data/RxffTableData.xml"
			replaceType="always" />
		<PSCopy
			tofile="${install.config}/Installer/data/RxffTableDef.xml"
