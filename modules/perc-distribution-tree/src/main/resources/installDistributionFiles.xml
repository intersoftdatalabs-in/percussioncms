			replaceType="always" />
		<PSCopy
			tofile="${install.config}/Installer/oldJdbcJarsList.txt"
			file="${basedir}/src/main/resources/distribution/rxconfig/Installer/oldJdbcJarsList.txt"
			replaceType="always" />

		<!-- I18n Config Files -->
		<mkdir dir="${install.config}/I18n" />
		<PSCopy
