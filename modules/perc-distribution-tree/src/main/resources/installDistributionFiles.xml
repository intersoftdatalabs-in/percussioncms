		</copy>

		<!-- Includes web_resources task files and secure site config -->
		<copy todir="${assembly-directory}/sys_resources"
			overwrite="true" filtering="true">
			<fileset
				file="${rxbase}/../projects/sitemanage/src/main/resources/Rhythmyx/sys_resources/**">
			</fileset>
		</copy>

		<mkdir
			dir="${assembly-directory}/sys_resources/webapps/secure/WEB-INF/lib" />
		<mkdir
			dir="${assembly-directory}/sys_resources/webapps/secure/WEB-INF/classes" />

		<copy
			todir="${assembly-directory}/sys_resources/webapps/secure/WEB-INF/lib"
			overwrite="true">
			<fileset
