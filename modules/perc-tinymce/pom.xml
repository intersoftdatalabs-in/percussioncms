<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.percussion</groupId>
        <artifactId>core</artifactId>
        <version>8.1.8-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>perc-tinymce</artifactId>
    <version>8.1.8-SNAPSHOT</version>
    <licenses>
        <license>
            <name>LGPL-2.1</name>
            <url>http://www.tinymce.com/js/tinymce4/js/tinymce/license.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <destDir>${project.build.outputDirectory}/META-INF/resources/sys_resources/tinymce/js/tinymce</destDir>
        <download-file>tinymce-${tinymce.version}.zip</download-file>
        <download-folder>${basedir}/target/tinymce-download</download-folder>
        <old.source.root>../..</old.source.root>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tinymce.url>https://download.tiny.cloud/tinymce/community/tinymce_${tinymce.version}.zip</tinymce.url>
    </properties>
    <dependencies>
        <!-- TinyMCE is downloaded directly from CDN during build; no Maven artifact dependency needed -->
        <dependency>
            <groupId>com.percussion</groupId>
            <artifactId>rxutils</artifactId>
            <version>8.1.8-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-tinymce</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${download-folder}" />
                                <echo message="Downloading TinyMCE ${tinymce.version} from CDN..." />
                                <get dest="${download-folder}/${download-file}" src="${tinymce.url}" />
                                <echo message="Extracting TinyMCE archive..." />
                                <unzip dest="${project.build.directory}" src="${download-folder}/${download-file}" />
                                <echo message="Moving TinyMCE resources to package..." />
                                <move todir="${destDir}">
                                    <fileset dir="${project.build.directory}/tinymce/js/tinymce" />
                                </move>
                                <move todir="${destDir}/skins/lightgray">
                                    <fileset dir="${destDir}/../../css" />
                                </move>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.samaxes.maven</groupId>
                <artifactId>minify-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>min-common</id>
                        <goals>
                            <goal>minify</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <webappSourceDir>${basedir}/src/main/resources/META-INF/resources</webappSourceDir>
                            <webappTargetDir>${project.build.outputDirectory}/META-INF/resources</webappTargetDir>
                            <skipMerge>true</skipMerge>
                            <skipMinify>false</skipMinify>
                            <jsSourceDir>sys_resources/tinymce/plugins</jsSourceDir>
                            <jsSourceIncludes>
                                <jsSourceInclude>**/plugin.js</jsSourceInclude>
                            </jsSourceIncludes>
                            <jsEngine>YUI</jsEngine>
                            <yuiPreserveSemicolons>true</yuiPreserveSemicolons>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>populate-nexus</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>import-jetty-installs</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>process-resources</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${download-folder}" />
                                        <echo message="download archive" />
                                        <get dest="${download-folder}" src="${tinymce.url}" />
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>analyze</id>
                                <goals>
                                    <goal>analyze-only</goal>
                                </goals>
                                <configuration>
                                    <failOnWarning>false</failOnWarning>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-deploy</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>phantomjs-nexus-deploy-win</id>
                                <goals>
                                    <goal>deploy-file</goal>
                                </goals>
                                <phase>deploy</phase>
                                <configuration>
                                    <repositoryId>repo-man</repositoryId>
                                    <file>${download-folder}/download-file</file>
                                    <!-- Removed internal repo URL; configure deployment target as needed -->
                                    <url>https://repo.maven.apache.org/maven2</url>
                                    <groupId>com.tiny</groupId>
                                    <artifactId>tinymce</artifactId>
                                    <packaging>zip</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
