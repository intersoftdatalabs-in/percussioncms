<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.percussion</groupId>
        <artifactId>core</artifactId>
        <version>8.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>perc-tinymce</artifactId>
    <version>8.2.0-SNAPSHOT</version>
    <licenses>
        <license>
            <!-- TinyMCE 6.8.x (the version bundled here) is MIT-licensed. -->
            <!-- TinyMCE 7+ switched to GPL-2.0-or-later. Do NOT upgrade past 6.8.x -->
            <!-- without legal review; GPL-2.0 is incompatible with Apache 2.0 for distribution. -->
            <name>MIT</name>
            <url>https://github.com/tinymce/tinymce/blob/release/6.8/LICENSE.TXT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <destDir>${project.build.outputDirectory}/META-INF/resources/sys_resources/tinymce/js/tinymce</destDir>
        <download-file>tinymce-${tinymce.version}.jar</download-file>
        <download-folder>${basedir}/target/tinymce-download</download-folder>
        <old.source.root>../..</old.source.root>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tinymce.url>https://download.tiny.cloud/tinymce/community/tinymce_${tinymce.version}.zip</tinymce.url>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>tinymce</artifactId>
        </dependency>
        <!-- CodeMirror is consumed as a standard npm dependency (issue #5626):
             `codemirror` in package.json, bundled by esbuild. No WebJar. -->
        <dependency>
            <groupId>com.percussion</groupId>
            <artifactId>utils</artifactId>
            <version>${project.parent.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <dependencies/>
                <executions>
                    <execution>
                        <id>copy-tinymce-archive</id>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <outputDirectory>${download-folder}</outputDirectory>
                            <includeArtifactIds>tinymce</includeArtifactIds>
                            <stripVersion>false</stripVersion>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>import-upstream</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <target>
                                <echo message="unzip archive"/>
                                <unzip dest="${project.build.directory}" src="${download-folder}/${download-file}"/>
                                <echo message="moving resources"/>
                                <move todir="${destDir}">
                                    <fileset dir="${project.build.directory}/META-INF/resources/webjars/tinymce/${tinymce.version}/"/>
                                </move>
                                <!-- TinyMCE 5+ uses the 'oxide' skin (under skins/ui/oxide/). -->
                                <!-- 'lightgray' was the TinyMCE 4 skin name and no longer exists. -->
                                <move todir="${destDir}/skins/ui/oxide">
                                    <fileset dir="${destDir}/../../css"/>
                                </move>
                                <!-- CodeMirror is no longer unpacked from a WebJar here (issue #5626):
                                     the npm bundle is produced by `npm run bundle:codemirror`
                                     (frontend-maven-plugin, prepare-package) into
                                     target/classes/.../plugins/codemirror/codemirror/. -->
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <!-- Node.js is installed once into the local Maven repository cache. -->
                    <!-- The plugin checks for the binary before downloading, so mvn clean -->
                    <!-- does NOT trigger a re-download. node_modules/ is git-ignored. -->
                    <nodeVersion>v22.22.0</nodeVersion>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${user.home}/.m2/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>minify-tinymce-plugins</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>run minify</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- CodeMirror npm bundle (issue #5626). Runs after minify;
                             both write into target/classes for JAR packaging. -->
                        <id>bundle-codemirror</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>run bundle:codemirror</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>populate-nexus</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>import-jetty-installs</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>prepare-package</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${download-folder}"/>
                                        <echo message="download archive"/>
                                        <get dest="${download-folder}" src="${tinymce.url}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>process-resources</phase>
                            </execution>
                            <execution>
                                <id>analyze</id>
                                <goals>
                                    <goal>analyze-only</goal>
                                </goals>
                                <configuration>
                                    <failOnWarning>false</failOnWarning>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
