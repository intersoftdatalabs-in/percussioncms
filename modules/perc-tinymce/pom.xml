<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.percussion</groupId>
        <artifactId>core</artifactId>
        <version>8.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>perc-tinymce</artifactId>
    <version>8.2.0-SNAPSHOT</version>
    <licenses>
        <license>
            <!-- TinyMCE 6.8.x (the version bundled here) is MIT-licensed. -->
            <!-- TinyMCE 7+ switched to GPL-2.0-or-later. Do NOT upgrade past 6.8.x -->
            <!-- without legal review; GPL-2.0 is incompatible with Apache 2.0 for distribution. -->
            <name>MIT</name>
            <url>https://github.com/tinymce/tinymce/blob/release/6.8/LICENSE.TXT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <destDir>${project.build.outputDirectory}/META-INF/resources/sys_resources/tinymce/js/tinymce</destDir>
        <download-file>tinymce-${tinymce.version}.jar</download-file>
        <download-folder>${basedir}/target/tinymce-download</download-folder>
        <old.source.root>../..</old.source.root>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tinymce.url>https://download.tiny.cloud/tinymce/community/tinymce_${tinymce.version}.zip</tinymce.url>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>tinymce</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>codemirror</artifactId>
        </dependency>
        <dependency>
            <groupId>com.percussion</groupId>
            <artifactId>rxutils</artifactId>
            <version>${project.parent.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <dependencies/>
                <executions>
                    <execution>
                        <id>copy-tinymce-archive</id>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <outputDirectory>${download-folder}</outputDirectory>
                            <includeArtifactIds>tinymce,codemirror</includeArtifactIds>
                            <stripVersion>false</stripVersion>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>import-upstream</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <echo message="unzip archive"/>
                                <unzip dest="${project.build.directory}" src="${download-folder}/${download-file}"/>
                                <echo message="moving resources"/>
                                <move todir="${destDir}">
                                    <fileset dir="${project.build.directory}/META-INF/resources/webjars/tinymce/${tinymce.version}/"/>
                                </move>
                                <!-- TinyMCE 5+ uses the 'oxide' skin (under skins/ui/oxide/). -->
                                <!-- 'lightgray' was the TinyMCE 4 skin name and no longer exists. -->
                                <move todir="${destDir}/skins/ui/oxide">
                                    <fileset dir="${destDir}/../../css"/>
                                </move>
                                <!-- Unpack only the files needed by the codemirror TinyMCE plugin. -->
                                <!-- The full CodeMirror WebJar (~900 KB) contains ~400 files; we need only 15. -->
                                <!-- Version is managed via codemirror.version in the parent POM. -->
                                <echo message="installing CodeMirror ${codemirror.version} (MIT) into codemirror plugin"/>
                                <delete dir="${project.build.directory}/codemirror-unpack"/>
                                <mkdir dir="${project.build.directory}/codemirror-unpack"/>
                                <unzip dest="${project.build.directory}/codemirror-unpack"
                                       src="${download-folder}/codemirror-${codemirror.version}.jar"/>
                                <copy todir="${project.build.outputDirectory}/META-INF/resources/sys_resources/tinymce/plugins/codemirror/codemirror">
                                    <fileset dir="${project.build.directory}/codemirror-unpack/META-INF/resources/webjars/codemirror/${codemirror.version}">
                                        <include name="lib/codemirror.js"/>
                                        <include name="lib/codemirror.css"/>
                                        <include name="addon/edit/matchbrackets.js"/>
                                        <include name="addon/dialog/dialog.js"/>
                                        <include name="addon/dialog/dialog.css"/>
                                        <include name="addon/search/searchcursor.js"/>
                                        <include name="addon/search/search.js"/>
                                        <include name="addon/selection/active-line.js"/>
                                        <include name="addon/display/fullscreen.js"/>
                                        <include name="addon/display/fullscreen.css"/>
                                        <include name="mode/xml/xml.js"/>
                                        <include name="mode/javascript/javascript.js"/>
                                        <include name="mode/css/css.js"/>
                                        <include name="mode/htmlmixed/htmlmixed.js"/>
                                        <include name="mode/velocity/velocity.js"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <!-- Node.js is installed once into the local Maven repository cache. -->
                    <!-- The plugin checks for the binary before downloading, so mvn clean -->
                    <!-- does NOT trigger a re-download. node_modules/ is git-ignored. -->
                    <nodeVersion>v20.18.0</nodeVersion>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${user.home}/.m2/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>minify-tinymce-plugins</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>run minify</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>populate-nexus</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>import-jetty-installs</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>process-resources</phase>
                                <configuration>
                                    <target>
                                        <mkdir dir="${download-folder}"/>
                                        <echo message="download archive"/>
                                        <get dest="${download-folder}" src="${tinymce.url}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>analyze</id>
                                <goals>
                                    <goal>analyze-only</goal>
                                </goals>
                                <configuration>
                                    <failOnWarning>false</failOnWarning>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-deploy</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>phantomjs-nexus-deploy-win</id>
                                <goals>
                                    <goal>deploy-file</goal>
                                </goals>
                                <phase>deploy</phase>
                                <configuration>
                                    <repositoryId>repo-man</repositoryId>
                                    <file>${download-folder}/download-file</file>
                                    <url>https://mvn.intsof.com/repositories/thirdparty/</url>
                                    <groupId>com.tiny</groupId>
                                    <artifactId>tinymce</artifactId>
                                    <packaging>zip</packaging>
                                    <generatePom>true</generatePom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
