<?xml version="1.0"?>
<Configure id="Server" class="org.eclipse.jetty.server.Server">
	<New id="embeddedArtemisBroker"
		class="org.apache.activemq.artemis.core.server.embedded.EmbeddedActiveMQ">
		<Set name="configResourcePath">broker.xml</Set>
		<Call name="start" />
	</New>
	<New id="ConnectionFactory"
		class="org.eclipse.jetty.plus.jndi.Resource">
		<Arg></Arg>
		<Arg>java:/ConnectionFactory</Arg>
		<Arg>
			<New class="org.apache.activemq.artemis.jms.client.ActiveMQConnectionFactory">
				<Arg>vm://0</Arg>
			</New>
		</Arg>
	</New>
	<New id="NotificationQueue"
		class="org.eclipse.jetty.plus.jndi.Resource">
		<Arg></Arg>
		<Arg>queue/notificationQueue</Arg>
		<Arg>
			<New class="org.apache.activemq.artemis.jms.client.ActiveMQQueue">
				<Arg>PERCUSSION.NOTIFICATIONS</Arg>
			</New>
		</Arg>
	</New>
	<New id="PublishQueue" class="org.eclipse.jetty.plus.jndi.Resource">
		<Arg></Arg>
		<Arg>queue/publishQueue</Arg>
		<Arg>
			<New class="org.apache.activemq.artemis.jms.client.ActiveMQQueue">
				<Arg>PERCUSSION.PUBLISHING</Arg>
			</New>
		</Arg>
	</New>
	<New id="EmailQueue" class="org.eclipse.jetty.plus.jndi.Resource">
		<Arg></Arg>
		<Arg>queue/emailQueue</Arg>
		<Arg>
			<New class="org.apache.activemq.artemis.jms.client.ActiveMQQueue">
				<Arg>PERCUSSION.EMAIL</Arg>
			</New>
		</Arg>
	</New>
</Configure>
