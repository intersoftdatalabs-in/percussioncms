# Percussion CMS QA Automation Environment Variables
# Copy this file to .env and configure as needed

# ============================================================================
# REQUIRED: Path to the local Percussion CMS installation directory
# ============================================================================
# Example: /home/nate/installs/cms-8.1.7-317-2
DEV_PERCUSSION_INSTALL=/path/to/your/cms-install

# ============================================================================
# OPTIONAL: Percussion CMS URL
# ============================================================================
# If not set, will be auto-calculated from jetty/base/etc/installation.properties
# Example: http://localhost:9992
DEV_PERCUSSION_URL=

# ============================================================================
# OPTIONAL: Percussion DTS (Deployment Target Service) Installation
# ============================================================================
# Path to the local Percussion DTS installation (if separate from CMS)
# Example: /home/nate/installs/cms-8.1.7-317-2-dts
DEV_PERCUSSION_DTS_INSTALL=

# ============================================================================
# OPTIONAL: Percussion DTS (Deployment Target Service) URL
# ============================================================================
# If not set, will be auto-calculated from 
# {DEV_PERCUSSION_DTS_INSTALL}/Deployment/Server/conf/perc/perc-catalina.properties (http.port)
# Example: http://localhost:9980
DEV_PERCUSSION_DTS_URL=

# ============================================================================
# User Credentials
# ============================================================================
# If not set, passwords will be auto-read from:
# {DEV_PERCUSSION_INSTALL}/var/config/generated/passwords
#
# Default usernames:
ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=

EDITOR_USERNAME=Editor
# EDITOR_PASSWORD=

CONTRIBUTOR_USERNAME=Contributor
# CONTRIBUTOR_PASSWORD=

# ============================================================================
# Optional: Test Configuration
# ============================================================================
# TEST_TIMEOUT=30000
# HEADLESS=true
